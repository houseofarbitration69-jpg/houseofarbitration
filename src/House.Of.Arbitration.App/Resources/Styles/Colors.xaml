<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- ========================================================================= -->
    <!-- BRAND / IDENTITY                                                         -->
    <!-- ========================================================================= -->
    <Color x:Key="MartialRed">#D32F2F</Color>
    <Color x:Key="MartialGold">#FFC107</Color>
    <Color x:Key="MartialDark">#121212</Color>
    <Color x:Key="MartialSurface">#1E1E1E</Color>
    <Color x:Key="MartialWhite">#FFFFFF</Color>
    <Color x:Key="MartialGray">#B0B0B0</Color>

    <Color x:Key="Primary">#D32F2F</Color>
    <Color x:Key="PrimaryDark">#8B0000</Color>
    <Color x:Key="PrimaryLight">#FF6659</Color>
    <Color x:Key="PrimaryDarkText">#FFFFFF</Color>
    <Color x:Key="Secondary">#FFC107</Color>
    <Color x:Key="SecondaryDark">#C79100</Color>
    <Color x:Key="SecondaryDarkText">#121212</Color>
    <Color x:Key="Tertiary">#1E1E1E</Color>

    <!-- Standard Colors -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D32F2F</Color>
    <Color x:Key="MidnightBlue">#121212</Color>
    <Color x:Key="OffBlack">#121212</Color>

    <!-- ========================================================================= -->
    <!-- SURFACES & ELEVATION                                                      -->
    <!-- ========================================================================= -->
    <Color x:Key="PageBackgroundColor">#121212</Color>
    <Color x:Key="SurfaceColor">#1E1E1E</Color>
    <Color x:Key="SurfaceElevation0">#141414</Color>
    <Color x:Key="SurfaceElevation1">#1E1E1E</Color>
    <Color x:Key="SurfaceElevation2">#222222</Color>
    <Color x:Key="SurfaceElevation3">#262626</Color>
    <Color x:Key="SurfaceElevation4">#2A2A2A</Color>
    <Color x:Key="SurfaceElevation5">#2D2D2D</Color>
    <Color x:Key="SurfaceElevation6">#333333</Color>
    <Color x:Key="SurfaceElevation7">#424242</Color>
    <Color x:Key="SurfaceElevation8">#444444</Color>
    <Color x:Key="SurfaceElevation9">#555555</Color>

    <Color x:Key="SurfaceLight">#EEEEEE</Color>
    <Color x:Key="SurfaceLightAlt">#F5F5F5</Color>

    <!-- Grays -->
    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- ========================================================================= -->
    <!-- TEXT HIERARCHY                                                            -->
    <!-- ========================================================================= -->
    <Color x:Key="PrimaryTextColor">#FFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#B0B0B0</Color>
    <Color x:Key="MutedTextColor">#888888</Color>
    <Color x:Key="SubtleTextColor">#666666</Color>
    <Color x:Key="DisabledTextColor">#555555</Color>
    <Color x:Key="InverseTextColor">#121212</Color>
    <Color x:Key="ApplicationNameColor">#FFFFFF</Color>
    <Color x:Key="PageTitleColor">#FFFFFF</Color>
    <Color x:Key="PlaceholderColor">#757575</Color>

    <!-- ========================================================================= -->
    <!-- COMBAT CORNERS (RED / BLUE)                                               -->
    <!-- ========================================================================= -->
    <Color x:Key="RedCornerColor">#D32F2F</Color>
    <Color x:Key="RedCornerLight">#E53935</Color>
    <Color x:Key="RedCornerBorder">#FF5252</Color>
    <Color x:Key="RedCornerBg">#2B1A1A</Color>
    <Color x:Key="RedCornerDarkBg">#3B1B1B</Color>
    <Color x:Key="RedCornerBadgeBg">#FFEBEE</Color>
    <Color x:Key="RedCornerBadgeText">#D32F2F</Color>
    <Color x:Key="RedCornerText">#FFCDD2</Color>

    <Color x:Key="BlueCornerColor">#1976D2</Color>
    <Color x:Key="BlueCornerLight">#42A5F5</Color>
    <Color x:Key="BlueCornerBorder">#1976D2</Color>
    <Color x:Key="BlueCornerBg">#1A222B</Color>
    <Color x:Key="BlueCornerBadgeBg">#E3F2FD</Color>
    <Color x:Key="BlueCornerBadgeText">#1976D2</Color>

    <!-- ========================================================================= -->
    <!-- STATUS & FEEDBACK                                                         -->
    <!-- ========================================================================= -->
    <Color x:Key="ValidColor">#4CAF50</Color>
    <Color x:Key="SuccessColor">#4CAF50</Color>
    <Color x:Key="SuccessDark">#2E7D32</Color>
    <Color x:Key="SuccessLight">#81C784</Color>
    <Color x:Key="SuccessAccent">#80EF80</Color>
    <Color x:Key="SuccessBg">#1B3B22</Color>
    <Color x:Key="SuccessBadgeBg">#E8F5E9</Color>
    <Color x:Key="SuccessBadgeText">#2E7D32</Color>
    <Color x:Key="SuccessChipText">#C8E6C9</Color>

    <Color x:Key="WarningColor">#FFC107</Color>
    <Color x:Key="WarningBg">#2D2200</Color>
    <Color x:Key="WarningLight">#FFD54F</Color>

    <Color x:Key="ErrorColor">#FF5252</Color>
    <Color x:Key="ErrorDark">#B00020</Color>
    <Color x:Key="ErrorAccent">#FF746C</Color>
    <Color x:Key="ErrorBg">#3B1B1B</Color>
    <Color x:Key="ErrorText">#FF8A80</Color>
    <Color x:Key="ErrorLight">#E57373</Color>

    <!--<Color x:Key="EditColor">#ADD8E6</Color>-->
    <Color x:Key="EditColor">#4CAF50</Color>
    <Color x:Key="InfoColor">#1976D2</Color>
    <Color x:Key="ActionColor">#ADD8E6</Color>
    <Color x:Key="ConnectedBackground">Green</Color>
    <Color x:Key="ConnectedStroke">Lime</Color>
    <Color x:Key="RedSide">Red</Color>
    <Color x:Key="MoreRedSide">Red</Color>
    <Color x:Key="LessRedSide">DarkRed</Color>
    <Color x:Key="BlueSide">Blue</Color>
    <Color x:Key="MoreBlueSide">Blue</Color>
    <Color x:Key="LessBlueSide">DarkBlue</Color>

    <!-- ========================================================================= -->
    <!-- BORDERS                                                                   -->
    <!-- ========================================================================= -->
    <Color x:Key="BorderColor">#383838</Color>
    <Color x:Key="BorderSubtle">#262626</Color>
    <Color x:Key="BorderMedium">#3E3E3E</Color>
    <Color x:Key="BorderStrong">#555555</Color>
    <Color x:Key="BorderFocus">#757575</Color>
    <Color x:Key="BorderLight">#EEEEEE</Color>

    <!-- ========================================================================= -->
    <!-- CONTROLS & FORMS                                                          -->
    <!-- ========================================================================= -->
    <Color x:Key="EntryBackgroundColor">#2A2A2A</Color>
    <Color x:Key="EntryBorderColor">#444444</Color>
    <Color x:Key="KeypadButtonBg">#424242</Color>
    <Color x:Key="KeypadButtonText">#FFFFFF</Color>
    <Color x:Key="KeypadDigitBg">#FFFFFF</Color>
    <Color x:Key="KeypadDigitText">#000000</Color>

    <!-- ========================================================================= -->
    <!-- OVERLAYS                                                                  -->
    <!-- ========================================================================= -->
    <Color x:Key="OverlayModalColor">#80000000</Color>
    <Color x:Key="OverlayHeavyColor">#AA000000</Color>
    <Color x:Key="OverlayLightColor">#33FFFFFF</Color>

    <!-- ========================================================================= -->
    <!-- BRUSHES                                                                   -->
    <!-- ========================================================================= -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="{StaticResource PageBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>
    <SolidColorBrush x:Key="RedCornerBrush" Color="{StaticResource RedCornerColor}"/>
    <SolidColorBrush x:Key="BlueCornerBrush" Color="{StaticResource BlueCornerColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>
</ResourceDictionary>