<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="House.Of.Arbitration.Views.Core.Styles.MartialTheme">

    <Color x:Key="Primary">#D32F2F</Color>
    <Color x:Key="Secondary">#FFC107</Color>
    <Color x:Key="Tertiary">#1E1E1E</Color>
    <Color x:Key="SurfaceColor">#1E1E1E</Color>
    <Color x:Key="SecondaryTextColor">#B0B0B0</Color>



    <Color x:Key="Error">#FF746C</Color>
    <Color x:Key="Valid">#80EF80</Color>
    <Color x:Key="Placeholder">Gray</Color>

    <Color x:Key="PrimaryTextColor">#000000</Color>
    <Color x:Key="PageBackgroundColor">Gray</Color>
    <Color x:Key="EntryBackgroundColor">LightGray</Color>
    <x:Int32 x:Key="ButtonCornerRadius">20</x:Int32>
    <x:Int32 x:Key="EntryCornerRadius">5</x:Int32>

</ResourceDictionary>