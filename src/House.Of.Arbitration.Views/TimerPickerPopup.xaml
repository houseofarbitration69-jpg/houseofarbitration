<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    x:Class="House.Of.Arbitration.Views.TimerPickerPopup"
    x:DataType="vm:TimerPickerPopupViewModel"
    BackgroundColor="Transparent"
    Padding="0">

    <Border 
        Stroke="{DynamicResource BorderStrong}" 
        StrokeThickness="1.5" 
        BackgroundColor="{DynamicResource SurfaceElevation2}" 
        Padding="20" 
        WidthRequest="{OnIdiom Tablet='340', Phone='280'}"
        HorizontalOptions="Center" 
        VerticalOptions="Center"
    >
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="15"/>
        </Border.StrokeShape>

        <VerticalStackLayout Spacing="12">
            <Label 
                Text="DÉFINIR LE TEMPS" 
                FontSize="18" 
                FontAttributes="Bold" 
                HorizontalOptions="Center" 
                TextColor="{DynamicResource PrimaryTextColor}"
                Margin="0,0,0,4"
            />

            <!-- Choix des durées -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Button Grid.Row="0" Grid.Column="0" Text="0:30"
                        Command="{Binding SelectCommand}" CommandParameter="0:30"
                        BackgroundColor="{DynamicResource SurfaceElevation7}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontSize="16" FontAttributes="Bold" HeightRequest="50"/>
                <Button Grid.Row="0" Grid.Column="1" Text="1:00"
                        Command="{Binding SelectCommand}" CommandParameter="1:00"
                        BackgroundColor="{DynamicResource SurfaceElevation7}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontSize="16" FontAttributes="Bold" HeightRequest="50"/>
                <Button Grid.Row="1" Grid.Column="0" Text="1:30"
                        Command="{Binding SelectCommand}" CommandParameter="1:30"
                        BackgroundColor="{DynamicResource SurfaceElevation7}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontSize="16" FontAttributes="Bold" HeightRequest="50"/>
                <Button Grid.Row="1" Grid.Column="1" Text="2:00"
                        Command="{Binding SelectCommand}" CommandParameter="2:00"
                        BackgroundColor="{DynamicResource SurfaceElevation7}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontSize="16" FontAttributes="Bold" HeightRequest="50"/>
                <Button Grid.Row="2" Grid.Column="0" Text="3:00"
                        Command="{Binding SelectCommand}" CommandParameter="3:00"
                        BackgroundColor="{DynamicResource SurfaceElevation7}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontSize="16" FontAttributes="Bold" HeightRequest="50"/>
                <Button Grid.Row="2" Grid.Column="1" Text="5:00"
                        Command="{Binding SelectCommand}" CommandParameter="5:00"
                        BackgroundColor="{DynamicResource SurfaceElevation7}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontSize="16" FontAttributes="Bold" HeightRequest="50"/>
            </Grid>

            <!-- Annuler -->
            <Button 
                Text="ANNULER" 
                Command="{Binding CancelCommand}"
                BackgroundColor="{DynamicResource SurfaceElevation4}"
                TextColor="{DynamicResource SecondaryTextColor}"
                Margin="0,4,0,0"
                HeightRequest="44"
            />
        </VerticalStackLayout>
    </Border>
</mct:Popup>
