<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    x:TypeArguments="vm:HomeViewModel"
    x:Class="House.Of.Arbitration.Views.HomePage"
    x:DataType="vm:HomeViewModel"
    x:Name="this"
>
    <Grid 
        RowDefinitions="*,Auto,*" 
        ColumnDefinitions="*,250,*"
    >
        <Label 
            Grid.Row="0" 
            Grid.ColumnSpan="3" 
            Text="{Binding Resources.APPLICATION_NAME}" 
            Style="{StaticResource ApplicationNameStyle}"
        />
        
        <VerticalStackLayout 
            Grid.Row="1" 
            Grid.Column="1" 
            Spacing="10"
            VerticalOptions="Center"
        >
            <controls:IconButton 
                Text="{Binding Resources.MASTER}"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding NavigateToCommand}"
                CommandParameter="{x:Static models:Constants+Navigation+Page.MASTER}"
            />
            
            <controls:IconButton 
                Text="{Binding Resources.JUDGE}"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding NavigateToCommand}"
                CommandParameter="{x:Static models:Constants+Navigation+Page.JUDGE_CONNECTION}"
            />
            
            <controls:IconButton 
                Text="{Binding Resources.HISTORICS}"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding NavigateToCommand}"
                CommandParameter="{x:Static models:Constants+Navigation+Page.REFEREE_DATA}"
            />
            
            <controls:IconButton 
                Text="{Binding Resources.TAOLU_CODES}"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding NavigateToCommand}"
                CommandParameter="{x:Static models:Constants+Navigation+Page.TAOLU_CODES}"
            />

            <controls:IconButton 
                IsVisible="{Binding IsDebug}"
                Text="Test"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding TestCommand}"
                Margin="0,20,0,0"
            />

            <controls:IconButton 
                Text="{Binding Resources.GENERATE_DATA}"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding SeedDataCommand}"
                Margin="0,20,0,0"
            />
            
            <controls:IconButton 
                IsVisible="{Binding IsDebug}"
                Text="{Binding Resources.CLEAR_DATA}"
                Style="{StaticResource PrimaryButtonStyle}"
                Command="{Binding ClearDataCommand}"
            />
        </VerticalStackLayout>
    </Grid>
</base:BasePage>