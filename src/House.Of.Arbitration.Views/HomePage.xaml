<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    x:TypeArguments="vm:HomeViewModel"
    x:Class="House.Of.Arbitration.Views.HomePage"
    x:DataType="vm:HomeViewModel"
    x:Name="this"
    Title="{Binding Title}">

    <ScrollView>
        <CollectionView 
            x:Name="CompetitionsList" 
            ItemsSource="{Binding Competitions}" 
            SelectionMode="None"
            Margin="20,0,20,0">

            <CollectionView.Header>
                <Grid ColumnDefinitions="*,Auto">
                    <Label 
                        Grid.Column="0"
                        Text="Compétitions" 
                        Style="{DynamicResource Headline}" 
                        HorizontalOptions="Start"
                        FontSize="32" 
                    />
                    <controls:IconButton
                        Grid.Column="1"
                        Text="{Binding Resources.ADD_COMPETITION}"
                        ButtonBackgroundColor="LightGreen"
                        TextColor="Black"
                        TextFontSize="18"
                    >
                        <controls:IconButton.Icons>
                            <controls:IconInfo Icon="{x:Static helpers:FontCustomIcons.ADD}" Color="Black" FontSize="16" />
                            <controls:IconInfo Icon="{x:Static helpers:FontCustomIcons.CIRCLE}" Color="Black" FontSize="24" />
                        </controls:IconButton.Icons>
                    </controls:IconButton>
                </Grid>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,100" Spacing="20">
                    <Label Text="🥋" FontSize="64" HorizontalOptions="Center" />
                    <Label Text="Aucune compétition trouvée" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Button Text="Créer une compétition" Command="{Binding CreateCommand}" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CompetitionModel">
                    <controls:Card>
                        <Grid RowDefinitions="*,*" ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="10">
                                <Label Text="{Binding Date, StringFormat='{0:dd/MM/yyyy}'}" 
                                           VerticalOptions="Center"
                                           TextColor="Black" />
                                <Label Text="{Binding Name}" TextColor="Black"/>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="5">
                                <Label Text="🥋" VerticalOptions="Center" />
                                <Label 
                                    Text="{Binding Categories.Count, StringFormat='{0} catégories'}" 
                                    FontSize="12" 
                                    VerticalOptions="Center"
                                    TextColor="Black"
                                />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.RowSpan="2" Grid.Column="1" VerticalOptions="Center" Spacing="5">
                                <controls:IconButton
                                    IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                                    Icon="{x:Static helpers:FontCustomIcons.PEN}"
                                    ButtonBackgroundColor="LightBlue"
                                    IconColor="Black"
                                    Command="{Binding BindingContext.EditCompetitionCommand, Source={x:Reference this}}"
                                    CommandParameter="{Binding .}"
                                />
                                <controls:IconButton
                                    IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                                    Icon="{x:Static helpers:FontCustomIcons.TRASH}"
                                    ButtonBackgroundColor="Red"
                                    IconColor="{StaticResource PrimaryTextColor}"
                                    Command="{Binding BindingContext.DeleteCompetitionCommand, Source={x:Reference this}}"
                                    CommandParameter="{Binding .}"
                                />
                                <controls:IconButton
                                    IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                                    Icon="{x:Static helpers:FontCustomIcons.PLAY}"
                                    ButtonBackgroundColor="LightGreen"
                                    IconColor="Black"
                                    Command="{Binding BindingContext.StartCompetitionCommand, Source={x:Reference this}}"
                                    CommandParameter="{Binding .}"
                                />
                            </HorizontalStackLayout>
                        </Grid>
                    </controls:Card>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.Footer>
                <BoxView HeightRequest="20" Color="Transparent" />
            </CollectionView.Footer>
        </CollectionView>
    </ScrollView>
</base:BasePage>
