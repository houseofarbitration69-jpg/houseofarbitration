                                HorizontalOptions="Center" 
                                Spacing="10" 
                                Padding="75,5,0,0"
                            >
                                <!-- Circular Photo / Icon -->
                                <Border 
                                    StrokeShape="RoundRectangle 50" 
                                    HeightRequest="100" 
                                    WidthRequest="100" 
                                    HorizontalOptions="Center" 
                                    Stroke="White" 
                                    BackgroundColor="White"
                                    StrokeThickness="3"
