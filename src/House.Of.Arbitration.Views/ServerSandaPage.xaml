                >
                    <!-- Current Match Area -->
                    <Grid 
                        Grid.Column="0"
                        BindingContext="{Binding CurrentDraw}"
                        x:DataType="{x:Null}"
                    >
                        <!-- Background Layers (Red / Blue) -->
                        <Grid 
                            x:DataType="models:IDrawModel"
                            RowDefinitions="*" 
                            ColumnDefinitions="*,*"
                        >
                            <Border 
                                Grid.Column="0" 
                                Background="{DynamicResource RedSide}" 
                                StrokeThickness="0" 
                                Opacity="0.8" 
                                StrokeShape="RoundRectangle 8,0,8,0"
                                IsVisible="{Binding Type, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='NotOrder'}"
                            />

                            <Border 
                                Grid.Column="1" 
                                Background="{DynamicResource BlueSide}" 
                                StrokeThickness="0" 
                                Opacity="0.8"
                                IsVisible="{Binding Type, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='NotOrder'}" 
                                StrokeShape="RoundRectangle 0,8,0,8"
                            />
                        </Grid>

                        <!-- Knockout / Round Robin Mode -->
                        <Grid 
                            ColumnDefinitions="*,150,*"
                        >
                            <!-- Competitor 1 (Red Side) -->
                            <VerticalStackLayout 
                                Grid.Column="0" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Center" 
                                Spacing="10" 
                                Padding="75,5,0,0"
                            >
                                <!-- Circular Photo / Icon -->
                                <Border 
                                    StrokeShape="RoundRectangle 50" 
                                    HeightRequest="{OnIdiom Tablet='100', Phone='50'}" 
                                    WidthRequest="{OnIdiom Tablet='100', Phone='50'}" 
                                    HorizontalOptions="Center" 
                                    Stroke="White" 
                                    BackgroundColor="White"
                                    StrokeThickness="3"
                                    IsVisible="{Binding Competitor1.Photo, Converter={StaticResource IsNullOrEmptyConverter}, ConverterParameter='Invert'}"
                                >
                                    <Image 
                                        Source="{Binding Competitor1, Converter={StaticResource GenreToImageConverter}, ConverterParameter=10}" 
                                        Aspect="AspectFill" 
                                    />
                                </Border>

                                <Border 
                                    StrokeShape="RoundRectangle 50" 
                                    HeightRequest="{OnIdiom Tablet='100', Phone='50'}" 
                                    WidthRequest="{OnIdiom Tablet='100', Phone='50'}" 
                                    HorizontalOptions="Center" 
                                    Stroke="White" 
                                    StrokeThickness="3"
                                    BackgroundColor="White"
                                    IsVisible="{Binding Competitor1.Photo, Converter={StaticResource IsNullOrEmptyConverter}}"
                                >
                                    <Label 
                                        Text="{Binding Competitor1.Genre, Converter={StaticResource GenreToFontConverter}}" 
                                        FontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}" 
                                        FontSize="{OnIdiom Tablet='90', Phone='45'}" 
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                    />
                                </Border>

                                <!-- Name on two lines -->
                                <VerticalStackLayout HorizontalOptions="Center">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.LastName}" 
                                        Style="{StaticResource MainCompetitorNameStyle}" 
                                        FontSize="{OnIdiom Tablet='28', Phone='20'}" 
                                    />
                                    
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.FirstName}" 
                                        Style="{StaticResource MainCompetitorNameStyle}" 
                                        FontSize="{OnIdiom Tablet='32', Phone='20'}" 
                                        Margin="0,-5,0,0" 
                                    />
                                </VerticalStackLayout>

                                <!-- Club & Country -->
                                <VerticalStackLayout Spacing="2">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.Club}" 
                                        Style="{StaticResource MainCompetitorClubStyle}" 
                                        FontSize="{OnIdiom Tablet='18', Phone='16'}" 
                                    />

                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                        <Image 
                                            Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                            WidthRequest="25" 
                                            HeightRequest="15" 
                                            VerticalOptions="Center" 
                                        />
                                        
                                        <Label 
                                            Text="{Binding Competitor1.Country.Name}" 
                                            Style="{StaticResource MainCompetitorCountryStyle}" 
                                            FontSize="16" 
                                            VerticalOptions="Center" 
                                        />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- Winner Button -->
                                <Button 
                                    Text="VAINQUEUR" 
                                    Command="{Binding BindingContext.SetWinnerCommand, Source={x:Reference this}}"
                                    CommandParameter="Red"
                                    BackgroundColor="{DynamicResource LessRedSide}"
                                    BorderColor="{DynamicResource LessRedSide}"
                                    TextColor="{StaticResource PrimaryTextColor}"
                                    FontAttributes="Bold"
                                    CornerRadius="20"
                                    HeightRequest="40"
                                    WidthRequest="130"
                                    Margin="0,0,0,0" 
                                />
                            </VerticalStackLayout>

                            <!-- ROUND -->
                            <VerticalStackLayout 
                                Grid.Column="1" 
                                VerticalOptions="Start" 
                                HorizontalOptions="Center" 
                                Spacing="5" 
                                Padding="10,0"
                            >
                                <!-- Current Round Score (Real Time) -->
                                <Border 
                                    StrokeShape="RoundRectangle 8" 
                                    BackgroundColor="{DynamicResource SurfaceElevation2}" 
                                    Stroke="{DynamicResource PrimaryTextColor}" 
                                    Padding="15,5" 
                                    Margin="0,2,0,10"
                                >
                                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                        <Label 
                                            Text="{Binding CurrentRound, StringFormat='R{0}'}" 
                                            TextColor="{DynamicResource PrimaryTextColor}" 
                                            FontAttributes="Bold" 
                                            VerticalOptions="Center" 
                                        />

                                        <Label 
                                            Text="{Binding BindingContext.CurrentRedVotes, Source={x:Reference this}}" 
                                            TextColor="{DynamicResource RedSide}" 
                                            FontAttributes="Bold" 
                                            FontSize="18" 
                                            VerticalOptions="Center" 
                                        />

                                        <Label 
                                            Text="-" 
                                            TextColor="{DynamicResource PrimaryTextColor}" 
                                            VerticalOptions="Center" 
                                        />

                                        <Label 
                                            Text="{Binding BindingContext.CurrentBlueVotes, Source={x:Reference this}}" 
                                            TextColor="{DynamicResource BlueSide}" 
                                            FontAttributes="Bold" 
                                            FontSize="18" 
                                            VerticalOptions="Center" 
                                        />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- ROUNDS -->
                                <CollectionView 
                                    ItemsSource="{Binding BindingContext.RoundResults, Source={x:Reference this}}"
                                >
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:RoundResultModel">
                                            <Border 
                                                StrokeShape="RoundRectangle 8" 
                                                BackgroundColor="{DynamicResource SurfaceElevation6}" 
                                                Stroke="{DynamicResource Gray200}" 
                                                Padding="15,5" 
                                                Margin="0,2"
                                            >
                                                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                                                    <Label 
                                                        Text="{Binding RoundNumber, StringFormat='R{0}'}" 
                                                        TextColor="{DynamicResource PrimaryTextColor}" 
                                                        FontAttributes="Bold" 
                                                        VerticalOptions="Center" 
                                                    />
                                                    
                                                    <Label 
                                                        Text="{Binding RedVotes}" 
                                                        TextColor="{DynamicResource RedCornerColor}" 
                                                        FontAttributes="Bold" 
                                                        FontSize="18" 
                                                        VerticalOptions="Center" 
                                                    />
                                                    
                                                    <Label 
                                                        Text="-" 
                                                        TextColor="{DynamicResource PrimaryTextColor}" 
                                                        VerticalOptions="Center" 
                                                    />
                                                    
                                                    <Label 
                                                        Text="{Binding BlueVotes}" 
                                                        TextColor="{DynamicResource BlueCornerColor}" 
                                                        FontAttributes="Bold" 
                                                        FontSize="18" 
                                                        VerticalOptions="Center" 
                                                    />
                                                </HorizontalStackLayout>
                                            </Border>
