                                    HeightRequest="100" 
                                    WidthRequest="100" 
                                    HorizontalOptions="Center" 
                                    Stroke="White" 
                                    StrokeThickness="3"
                                    BackgroundColor="White"
                                    IsVisible="{Binding Competitor1.Photo, Converter={StaticResource IsNullOrEmptyConverter}}"
