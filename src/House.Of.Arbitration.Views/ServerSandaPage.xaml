<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    xmlns:selectors="clr-namespace:House.Of.Arbitration.Views.Selectors;assembly=House.Of.Arbitration.Views"
    xmlns:local="clr-namespace:House.Of.Arbitration.Views"
    x:TypeArguments="vm:ServerViewModel"
    x:Class="House.Of.Arbitration.Views.ServerSandaPage"
    x:DataType="vm:ServerViewModel"
    x:Name="this"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="false"
>
    <base:BasePage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="KnockoutTemplate" x:DataType="models:DrawKnockoutModel">
                <Border 
                    Padding="10,10,10,10" 
                    Stroke="{DynamicResource SurfaceLight}" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource SurfaceLight}"
                >
                    <Grid 
                        RowDefinitions="Auto, Auto, Auto, Auto" 
                        ColumnDefinitions="*"
                    >
                        <Label 
                            Grid.Column="0"
                            Grid.Row="0"
                            Text="{Binding StageName}"
                            FontAttributes="Bold"
                            FontSize="13"
                            TextColor="{DynamicResource PrimaryColor}"
                            HorizontalOptions="Center"
                            Margin="0,0,0,6"
                        />

                        <Grid 
                            Grid.Column="0" 
                            Grid.Row="1" 
                            ColumnDefinitions="Auto, *"
                        >
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                            />

                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout 
                                    Spacing="5" 
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                                >
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.LastName}" 
                                        FontAttributes="Bold"
                                    />

                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>

                                <Label 
                                    Text="{Binding x:DataType='vm:ServerViewModel', Source={RelativeSource AncestorType={x:Type vm:ServerViewModel}}, Path=Resources.WAITING}"
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                />

                                <controls:ScrollingText 
                                    Text="{Binding Competitor1.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>

                        <Label 
                            Grid.Column="0" 
                            Grid.Row="2" 
                            Text="{Binding x:DataType='vm:ServerViewModel', Source={RelativeSource AncestorType={x:Type vm:ServerViewModel}}, Path=Resources.VS}"
                            HorizontalOptions="Center"
                            TextColor="DarkGray" 
                            FontAttributes="Bold" 
                            Margin="0,5"
                        />

                        <Grid 
                            Grid.Column="0" 
                            Grid.Row="3" 
                            ColumnDefinitions="Auto, *"
                        >
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}"
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                            />

                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout 
                                    Spacing="5" 
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                                >
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor2.LastName}" 
                                        FontAttributes="Bold"
                                    />

                                    <controls:ScrollingText
                                        Text="{Binding Competitor2.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>

                                <Label 
                                    Text="{Binding x:DataType='vm:ServerViewModel', Source={RelativeSource AncestorType={x:Type vm:ServerViewModel}}, Path=Resources.WAITING}"
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor2.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="PoolTemplate" x:DataType="models:DrawPoolsModel">
                <Border 
                    Margin="0,2" 
                    Padding="10"
                    Stroke="{DynamicResource SurfaceLight}" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource SurfaceLight}"
                >
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*">
                        <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                            />

                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente match précédent" 
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor1.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>

                        <Label 
                            Grid.Column="1" 
                            Grid.Row="1" 
                            Text="VS" 
                            HorizontalOptions="Center" 
                            TextColor="DarkGray" 
                            FontAttributes="Bold" 
                            Margin="0,5"
                        />

                        <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor2.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor2.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente match précédent" 
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor2.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="OrderTemplate" x:DataType="models:DrawOrderModel">
                <Border 
                    Margin="0,2" 
                    Padding="10" 
                    Stroke="{DynamicResource SurfaceLight}" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource SurfaceLight}"
                >
                    <Grid ColumnDefinitions="*">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente" 
                                    IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="HeaderTemplate" x:DataType="x:String">
                <Border
                    Padding="10,10,10,10" 
                    Stroke="{DynamicResource PrimaryTextColor}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource SurfaceElevation6}"
                >
                    <Label 
                        Text="{Binding .}" 
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontAttributes="Bold" 
                        FontSize="14"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                    />
                </Border>
            </DataTemplate>

            <selectors:DrawTemplateSelector x:Key="DrawTemplateSelector"
                                            KnockoutTemplate="{StaticResource KnockoutTemplate}"
                                            PoolTemplate="{StaticResource PoolTemplate}"
                                            OrderTemplate="{StaticResource OrderTemplate}"
                                            HeaderTemplate="{StaticResource HeaderTemplate}"/>
        </ResourceDictionary>
    </base:BasePage.Resources>

    <Grid x:Name="RootGrid">
        <Grid 
            ColumnDefinitions="300,*" 
            ColumnSpacing="15" 
            Margin="10,5,10,10"
        >
            <Grid 
                Grid.Column="0"
                RowDefinitions="Auto,Auto,Auto,*" 
                RowSpacing="10"
            >
                <HorizontalStackLayout 
                    Grid.Row="0" 
                    Spacing="10" 
                    VerticalOptions="Center"
                >
                    <!-- RETOUR -->
                    <Border
                        StrokeShape="RoundRectangle 50"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{DynamicResource SurfaceElevation4}"
                        Stroke="{DynamicResource BorderMuted}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                    >
                        <Label 
                            FontFamily="{x:Static helpers:FontHelper.FONTAWESOME_SOLID_NAME}"
                            Text="{x:Static helpers:FontAwesomeIcons.ARROW_LEFT}" 
                            FontSize="20" 
                            TextColor="{DynamicResource PrimaryTextColor}" 
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            FontAttributes="Bold"
                        />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding RequestBackNavigationCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- EXPORT PDF -->
                    <Border
                        StrokeShape="RoundRectangle 50"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{DynamicResource SurfaceElevation4}"
                        Stroke="{DynamicResource BorderMuted}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        ToolTipProperties.Text="Exporter les tirages en PDF"
                    >
                        <Label 
                            FontFamily="{x:Static helpers:FontHelper.FONTAWESOME_SOLID_NAME}"
                            Text="{x:Static helpers:FontAwesomeIcons.FILE_PDF}" 
                            FontSize="22" 
                            TextColor="{DynamicResource SuccessColor}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                        />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ExportDrawsToPdfCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- TIRAGES / CORRECTIONS -->
                    <Border
                        StrokeShape="RoundRectangle 50"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{DynamicResource SurfaceElevation4}"
                        Stroke="{DynamicResource BorderMuted}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        ToolTipProperties.Text="Afficher et modifier les tirages"
                    >
                        <Label
                            FontFamily="{x:Static helpers:FontHelper.FONTAWESOME_SOLID_NAME}"
                            Text="{x:Static helpers:FontAwesomeIcons.SITEMAP}"
                            FontSize="20"
                            TextColor="{DynamicResource SuccessColor}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                        />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenServerDrawsCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- HISTORIQUE -->
                    <Border
                        StrokeShape="RoundRectangle 50"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{DynamicResource SurfaceElevation4}"
                        Stroke="{DynamicResource BorderMuted}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        ToolTipProperties.Text="Afficher et modifier les tirages"
                    >
                        <Label
                            FontFamily="{x:Static helpers:FontHelper.FONTAWESOME_SOLID_NAME}"
                            Text="{x:Static helpers:FontAwesomeIcons.BOOKS}"
                            FontSize="20"
                            TextColor="{DynamicResource SuccessColor}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                        />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenServerHistoricCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- RESULTATS -->
                    <Border
                        StrokeShape="RoundRectangle 50"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{DynamicResource SurfaceElevation4}"
                        Stroke="{DynamicResource BorderMuted}"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                        ToolTipProperties.Text="Afficher et modifier les tirages"
                    >
                        <Label
                            FontFamily="{x:Static helpers:FontHelper.FONTAWESOME_SOLID_NAME}"
                            Text="{x:Static helpers:FontAwesomeIcons.TROPHY}"
                            FontSize="20"
                            TextColor="{DynamicResource SuccessColor}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                        />
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenServerResultsCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <!-- ETAT DU SERVEUR -->
                <Grid
                    Grid.Row="1"
                >
                    <!-- Démarré -->
                    <Border
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        StrokeShape="RoundRectangle 5"
                        Padding="12,6"
                        StrokeThickness="1.5"
                        BackgroundColor="{DynamicResource SuccessBg}"
                        Stroke="{DynamicResource SuccessColor}"
                        IsVisible="{Binding IsServerStarted}"
                    >
                        <Label
                            Text="SERVEUR ACTIF"
                            TextColor="{DynamicResource SuccessLight}"
                            FontAttributes="Bold"
                            FontSize="13"
                            VerticalTextAlignment="Center"
                            HorizontalTextAlignment="Center"
                        />

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding StopServerCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- Arrêté -->
                    <Border
                        HorizontalOptions="Fill"
                        VerticalOptions="Center"
                        StrokeShape="RoundRectangle 5"
                        Padding="12,6"
                        StrokeThickness="1.5"
                        BackgroundColor="{DynamicResource ErrorBg}"
                        Stroke="{DynamicResource ErrorColor}"
                        IsVisible="{Binding IsServerStarted, Converter={StaticResource InvertBoolConverter}}"
                    >
                        <!-- Texte -->
                        <Label
                            Text="SERVEUR ARRÊTÉ"
                            TextColor="{DynamicResource ErrorLight}"
                            FontAttributes="Bold"
                            FontSize="13"
                            VerticalTextAlignment="Center"
                            HorizontalTextAlignment="Center"
                        />

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding StartServerCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </Grid>

                <!-- COMPTEUR COMBATS RESTANTS -->
                <Border
                    Grid.Row="2"
                    Padding="10,6"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource SurfaceElevation4}"
                    Stroke="{DynamicResource BorderMuted}"
                    StrokeThickness="1"
                >
                    <Label
                        Text="{Binding RemainingMatchesCount, StringFormat='Combats restants : {0}'}"
                        FontAttributes="Bold"
                        FontSize="14"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                    />
                </Border>

                <CollectionView 
                    Grid.Row="3"
                    ItemsSource="{Binding Draws}"
                    ItemTemplate="{StaticResource DrawTemplateSelector}"
                    IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}}"
                >
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                </CollectionView>
            </Grid>

            <!-- RING -->
            <Grid 
                Grid.Column="1" 
                RowDefinitions="Auto,105,*,115" 
                RowSpacing="15" 
                ColumnDefinitions="85,80,*,80,85"
                IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}}"
            >
                <!-- HEADER ROW (CATEGORIE + STATUT DU SERVEUR) -->
                <Grid
                    Grid.Row="0"
                    Grid.ColumnSpan="5"
                    ColumnDefinitions="Auto, *, Auto"
                    ColumnSpacing="10"
                    VerticalOptions="Center"
                    Margin="5,0"
                >
                    <!-- CATEGORIE & ETAPE DU MATCH -->
                    <Border 
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="0,0,0,0"
                        Padding="15,4,15,4"
                        BackgroundColor="{DynamicResource SurfaceElevation6}"
                        Stroke="{DynamicResource PrimaryTextColor}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 15"
                    >
                        <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                            <controls:ScrollingText 
                                Text="{Binding CurrentDraw.Draw.Category.Name}"
                                TextColor="{DynamicResource PrimaryTextColor}" 
                                FontSize="26"
                                FontAttributes="Bold"
                            />
                            
                            <Label 
                                Text="{Binding CurrentMatchStageName}"
                                TextColor="LightGray" 
                                FontSize="18"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                IsVisible="{Binding CurrentMatchStageName, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- JUGE 1 -->
                <VerticalStackLayout 
                    Grid.Row="1" 
                    Grid.ColumnSpan="2"
                    VerticalOptions="Start"
                    HorizontalOptions="Start"
                    Spacing="5"
                >
                    <!-- JUGE -->
                    <Border 
                        Background="{StaticResource Gray200}"
                        WidthRequest="100"
                        HeightRequest="60"
                        StrokeShape="RoundRectangle 5"
                    >
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Judges[0].IsConnected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ConnectedBackground}" />
                                <Setter Property="Stroke" Value="{DynamicResource ConnectedStroke}" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>

                        <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                            <Label 
                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Text="{Binding Judges[0].Name}"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                TextColor="{DynamicResource InverseTextColor}"
                                FontSize="18"
                            />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding Judges[0].RedPoints}"
                                FontSize="18"
                                TextColor="{DynamicResource RedSide}"
                                HorizontalOptions="Center"
                            />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Judges[0].BluePoints}"
                                TextColor="{DynamicResource BlueSide}"
                                FontSize="18"
                                HorizontalOptions="Center"
                            />
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[0]}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- ACTIONS -->
                    <Grid 
                        ColumnDefinitions="*,*,*,*" 
                        ColumnSpacing="5" 
                    >
                        <!-- -1 RED -->
                        <Border
                            Grid.Column="0"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="{DynamicResource LessRedSide}"
                            Stroke="{DynamicResource LessRedSide}"
                        >
                            <Label 
                                Text="-1" 
                                VerticalOptions="Center"
                                HorizontalOptions="Center" 
                                FontSize="12" 
                                TextColor="{StaticResource PrimaryTextColor}" 
                                FontAttributes="Bold"
                            />

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RemoveRedPointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- +1 RED -->
                        <Border
                            Grid.Column="1"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="{DynamicResource MoreRedSide}"
                            Stroke="{DynamicResource MoreRedSide}"
                        >
                            <Label 
                                Text="+1" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Center" 
                                FontSize="12" 
                                TextColor="{StaticResource PrimaryTextColor}" 
                                FontAttributes="Bold"
                            />

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddRedPointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- -1 BLUE -->
                        <Border
                            Grid.Column="2"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="{DynamicResource LessBlueSide}"
                            Stroke="{DynamicResource LessBlueSide}"
                        >
                            <Label 
                                Text="-1" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Center" 
                                FontSize="12" 
                                TextColor="{DynamicResource PrimaryTextColor}" 
                                FontAttributes="Bold"
                            />

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RemoveBluePointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- +1 BLUE -->
                        <Border
                            Grid.Column="3"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="{DynamicResource MoreBlueSide}"
                            Stroke="{DynamicResource MoreBlueSide}"
                        >
                            <Label 
                                Text="+1" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Center" 
                                FontSize="12" 
                                TextColor="{DynamicResource PrimaryTextColor}" 
                                FontAttributes="Bold"
                            />

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddBluePointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- JUGE 2 -->
                <VerticalStackLayout
                    Grid.Row="1" 
                    Grid.ColumnSpan="2"
                    Grid.Column="3"
                    VerticalOptions="Start"
                    HorizontalOptions="End"
                    Spacing="5"
                >
                    <!-- JUGE -->
                    <Border
                            Background="{StaticResource Gray200}"
                            WidthRequest="100"
                            HeightRequest="60"
                            StrokeShape="RoundRectangle 5"
                        >
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Judges[1].IsConnected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ConnectedBackground}" />
                                    <Setter Property="Stroke" Value="{DynamicResource ConnectedStroke}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>

                            <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                <Label 
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Judges[1].Name}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    TextColor="{DynamicResource InverseTextColor}"
