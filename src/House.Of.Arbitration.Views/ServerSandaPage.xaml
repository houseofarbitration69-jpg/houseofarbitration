<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    xmlns:selectors="clr-namespace:House.Of.Arbitration.Views.Selectors;assembly=House.Of.Arbitration.Views"
    xmlns:local="clr-namespace:House.Of.Arbitration.Views"
    x:TypeArguments="vm:ServerViewModel"
    x:Class="House.Of.Arbitration.Views.ServerSandaPage"
    x:DataType="vm:ServerViewModel"
    x:Name="this"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="false"
>
    <base:BasePage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="KnockoutTemplate" x:DataType="models:DrawKnockoutModel">
                <Border 
                    Padding="10,10,10,10" 
                    Stroke="{DynamicResource SurfaceLight}" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource SurfaceLight}"
                >
                    <Grid 
                        RowDefinitions="Auto, Auto, Auto" 
                        ColumnDefinitions="*"
                    >
                        <Grid 
                            Grid.Column="0" 
                            Grid.Row="0" 
                            ColumnDefinitions="Auto, *"
                        >
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                            />

                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout 
                                    Spacing="5" 
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                                >
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                
                                <Label 
                                    Text="{Binding Resources.WAITING}" 
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                />
                                
                                <controls:ScrollingText 
                                    Text="{Binding Competitor1.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>

                        <Label 
                            Grid.Column="0" 
                            Grid.Row="1" 
                            Text="{Binding Resources.VS}" 
                            HorizontalOptions="Center" 
                            TextColor="DarkGray" 
                            FontAttributes="Bold" 
                            Margin="0,5"
                        />

                        <Grid 
                            Grid.Column="0" 
                            Grid.Row="2" 
                            ColumnDefinitions="Auto, *"
                        >
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}"
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                        
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout 
                                    Spacing="5" 
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                                >
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor2.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                
                                    <controls:ScrollingText
                                        Text="{Binding Competitor2.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                
                                <Label 
                                    Text="{Binding Resources.WAITING}" 
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor2.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="PoolTemplate" x:DataType="models:DrawPoolsModel">
                <Border 
                    Margin="0,2" 
                    Padding="10"
                    Stroke="{DynamicResource SurfaceLight}" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource SurfaceLight}"
                >
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*">
                        <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente match prÃ©cÃ©dent" 
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor1.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>

                        <Label 
                            Grid.Column="1" 
                            Grid.Row="1" 
                            Text="VS" 
                            HorizontalOptions="Center" 
                            TextColor="DarkGray" 
                            FontAttributes="Bold" 
                            Margin="0,5"
                        />

                        <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor2.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor2.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente match prÃ©cÃ©dent" 
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor2.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="OrderTemplate" x:DataType="models:DrawOrderModel">
                <Border 
                    Margin="0,2" 
                    Padding="10" 
                    Stroke="{DynamicResource SurfaceLight}" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource SurfaceLight}"
                >
                    <Grid ColumnDefinitions="*">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente" 
                                    IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="HeaderTemplate" x:DataType="x:String">
                <Border
                    Padding="10,10,10,10" 
                    Stroke="{DynamicResource PrimaryTextColor}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="{DynamicResource SurfaceElevation6}"
                >
                    <Label 
                        Text="{Binding .}" 
                        TextColor="{DynamicResource PrimaryTextColor}"
                        FontAttributes="Bold" 
                        FontSize="14"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                    />
                </Border>
            </DataTemplate>

            <selectors:DrawTemplateSelector x:Key="DrawTemplateSelector"
                                            KnockoutTemplate="{StaticResource KnockoutTemplate}"
                                            PoolTemplate="{StaticResource PoolTemplate}"
                                            OrderTemplate="{StaticResource OrderTemplate}"
                                            HeaderTemplate="{StaticResource HeaderTemplate}"/>
        </ResourceDictionary>
    </base:BasePage.Resources>

    <Grid x:Name="RootGrid">
        <Grid 
            ColumnDefinitions="{OnIdiom Tablet='300,*', Phone='*'}" 
            ColumnSpacing="15" 
            Margin="{OnIdiom Tablet='10,5,10,10', Phone='5,0,5,0'}"
        >
            <Grid 
                Grid.Column="0"
                RowDefinitions="Auto,*" 
                RowSpacing="10"
                IsVisible="{OnIdiom Tablet='true', Phone='false'}"
            >
                <HorizontalStackLayout 
                    Grid.Row="0" 
                    Spacing="10" 
                    VerticalOptions="Center"
                    IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}}"
                >
                    <!-- MENU -->
                    <Border
                        StrokeShape="RoundRectangle 50"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{StaticResource ValidColor}"
                        Stroke="{StaticResource ValidColor}"
                    >
                        <Label 
                            FontFamily="{x:Static helpers:FontHelper.FONTAWESOME_SOLID_NAME}"
                            Text="{x:Static helpers:FontAwesomeIcons.BARS}" 
                            FontSize="25" 
                            TextColor="{DynamicResource PrimaryTextColor}" 
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            FontAttributes="Bold"
                        />
                        
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSideSheetCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- INDICATEUR STATUT SERVEUR -->
                    <Border
                        Grid.Column="{OnIdiom Tablet='2', Phone='1'}"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        StrokeShape="RoundRectangle 18"
                        Padding="12,6"
                        StrokeThickness="1.5"
                        BackgroundColor="{DynamicResource SurfaceElevation4}"
                        Stroke="{DynamicResource BorderMuted}"
                    >
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsServerStarted}" Value="True">
                                <Setter Property="Stroke" Value="{DynamicResource SuccessColor}" />
                                <Setter Property="BackgroundColor" Value="{DynamicResource SuccessBg}" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsServerStarted}" Value="False">
                                <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                                <Setter Property="BackgroundColor" Value="{DynamicResource ErrorBg}" />
                            </DataTrigger>
                        </Border.Triggers>

                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <!-- Pastille de statut -->
                            <BoxView
                                WidthRequest="10"
                                HeightRequest="10"
                                CornerRadius="5"
                                VerticalOptions="Center"
                                Color="{DynamicResource ErrorColor}"
                            >
                                <BoxView.Triggers>
                                    <DataTrigger TargetType="BoxView" Binding="{Binding IsServerStarted}" Value="True">
                                        <Setter Property="Color" Value="{DynamicResource SuccessColor}" />
                                    </DataTrigger>
                                </BoxView.Triggers>
                            </BoxView>

                            <!-- Texte statut DEMARRE -->
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center" IsVisible="{Binding IsServerStarted}">
                                <Label
                                    Text="Serveur actif"
                                    TextColor="{DynamicResource SuccessLight}"
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    VerticalOptions="Center"
                                />
                                
                                <!--<Label
                                    Text="{Binding ServerName}"
                                    TextColor="{DynamicResource PrimaryTextColor}"
                                    FontSize="12"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding ServerName, Converter={StaticResource EmptyToBoolConverter}}"
                                />-->
                            </HorizontalStackLayout>

                            <!-- Texte statut ARRETE -->
                            <Label
                                Text="Serveur arrêté"
                                TextColor="{DynamicResource ErrorLight}"
                                FontAttributes="Bold"
                                FontSize="13"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsServerStarted, Converter={StaticResource InvertBoolConverter}}"
                            />
                        </HorizontalStackLayout>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSideSheetCommand}" />
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <CollectionView 
                    Grid.Row="1"
                    ItemsSource="{Binding Draws}"
                    ItemTemplate="{StaticResource DrawTemplateSelector}"
                    IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}}"
                >
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                </CollectionView>
            </Grid>

            <Grid 
                Grid.Column="1" 
                RowDefinitions="{OnIdiom Tablet='60,105,*,115', Phone='60,250,30,30,30,30,30,*'}" 
                RowSpacing="15" 
                ColumnDefinitions="{OnIdiom Tablet='85,80,*,80,85', Phone='*'}"
                IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}}"
            >
                <!-- HEADER ROW (CATEGORIE + STATUT DU SERVEUR) -->
                <Grid
                    Grid.Row="0"
                    Grid.ColumnSpan="5"
                    ColumnDefinitions="{OnIdiom Tablet='Auto, *, Auto', Phone='*, Auto'}"
                    ColumnSpacing="10"
                    VerticalOptions="Center"
                    Margin="5,0"
                >
                    <!-- CATEGORIE -->
                    <Border 
                        Grid.Column="{OnIdiom Tablet='1', Phone='0'}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="0,0,0,0"
                        Padding="15,5,15,5"
                        BackgroundColor="{DynamicResource SurfaceElevation6}"
                        Stroke="{DynamicResource PrimaryTextColor}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 15"
                    >
                        <controls:ScrollingText 
                            Text="{Binding CurrentDraw.Draw.Category.Name}"
                            TextColor="{DynamicResource PrimaryTextColor}" 
                            FontSize="{OnIdiom Tablet='32', Phone='20'}" 
                            FontAttributes="Bold"
                        />
                    </Border>
                </Grid>

                <!-- JUGE 1 -->
                <Grid
                    Grid.Row="{OnIdiom Tablet='1', Phone='2'}" 
                    Grid.ColumnSpan="{OnIdiom Tablet='2', Phone='0'}"
                    ColumnDefinitions="{OnIdiom Tablet='*', Phone='*, 20, 20, 20, 170'}"
                    ColumnSpacing="10"
                >
                    <VerticalStackLayout 
                        VerticalOptions="Start"
                        HorizontalOptions="Start"
                        Spacing="5"
                        IsVisible="{OnIdiom Tablet='true', Phone='false'}"
                    >
                        <!-- JUGE -->
                        <Border 
                            Background="{StaticResource Gray200}"
                            WidthRequest="100"
                            HeightRequest="60"
                            StrokeShape="RoundRectangle 5"
                        >
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Judges[0].IsConnected}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource ConnectedBackground}" />
                                    <Setter Property="Stroke" Value="{DynamicResource ConnectedStroke}" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            
                            <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                <Label 
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Judges[0].Name}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    TextColor="{DynamicResource InverseTextColor}"
                                    FontSize="18"
                                />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Judges[0].RedPoints}"
                                    FontSize="18"
                                    TextColor="{DynamicResource RedSide}"
                                    HorizontalOptions="Center"
                                />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Judges[0].BluePoints}"
                                    TextColor="{DynamicResource BlueSide}"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                />
                            </Grid>
                            
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[0]}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- ACTIONS -->
                        <Grid 
                            ColumnDefinitions="*,*,*,*" 
                            ColumnSpacing="5" 
                        >
                            <!-- -1 RED -->
                            <Border
                                Grid.Column="0"
                                StrokeShape="RoundRectangle 50"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="{DynamicResource LessRedSide}"
                                Stroke="{DynamicResource LessRedSide}"
                            >
                                <Label 
                                    Text="-1" 
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center" 
                                    FontSize="12" 
                                    TextColor="{StaticResource PrimaryTextColor}" 
                                    FontAttributes="Bold"
                                />

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RemoveRedPointCommand}" CommandParameter="{Binding Judges[0]}"/>
                                </Border.GestureRecognizers>
                            </Border>
                            
                            <!-- +1 RED -->
                            <Border
                                Grid.Column="1"
                                StrokeShape="RoundRectangle 50"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="{DynamicResource MoreRedSide}"
                                Stroke="{DynamicResource MoreRedSide}"
                            >
                                <Label 
                                    Text="+1" 
                                    VerticalOptions="Center" 
                                    HorizontalOptions="Center" 
                                    FontSize="12" 
                                    TextColor="{StaticResource PrimaryTextColor}" 
                                    FontAttributes="Bold"
                                />

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddRedPointCommand}" CommandParameter="{Binding Judges[0]}"/>
                                </Border.GestureRecognizers>
                            </Border>
                            
                            <!-- -1 BLUE -->
                            <Border
                                Grid.Column="2"
                                StrokeShape="RoundRectangle 50"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="{DynamicResource LessBlueSide}"
                                Stroke="{DynamicResource LessBlueSide}"
                            >
                                <Label 
                                    Text="-1" 
                                    VerticalOptions="Center" 
                                    HorizontalOptions="Center" 
                                    FontSize="12" 
                                    TextColor="{DynamicResource PrimaryTextColor}" 
                                    FontAttributes="Bold"
                                />

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RemoveBluePointCommand}" CommandParameter="{Binding Judges[0]}"/>
                                </Border.GestureRecognizers>
                            </Border>
                            
                            <!-- +1 BLUE -->
                            <Border
                                Grid.Column="3"
                                StrokeShape="RoundRectangle 50"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="{DynamicResource MoreBlueSide}"
                                Stroke="{DynamicResource MoreBlueSide}"
                            >
                                <Label 
                                    Text="+1" 
                                    VerticalOptions="Center" 
                                    HorizontalOptions="Center" 
                                    FontSize="12" 
                                    TextColor="{DynamicResource PrimaryTextColor}" 
                                    FontAttributes="Bold"
                                />

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddBluePointCommand}" CommandParameter="{Binding Judges[0]}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                    
                    <!-- PHONE -->
                    <Border 
                        Grid.Column="0"
                        Background="{DynamicResource PlaceholderColor}"
                        WidthRequest="100"
                        HeightRequest="30"
                        StrokeShape="RoundRectangle 5"
                        IsVisible="{OnIdiom Tablet='false', Phone='true'}"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                    >
                        <Label 
                            Text="{Binding Judges[0].Name}"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="Black"
                            FontSize="18"
                        />
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Judges[0].IsConnected}" Value="True">
                                <Setter Property="Background" Value="Green" />
                                <Setter Property="Stroke" Value="Lime" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[0]}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- PHONE RED POINT -->
                    <Grid
                        Grid.Column="1"
                    >
                        <Label
                            Text="{Binding Judges[0].RedPoints}"
                            FontSize="18"
                            TextColor="Red"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Style="{StaticResource JudgePointsLabelStyle}"
                            IsVisible="{OnIdiom Tablet='false', Phone='true'}"
                        />

                    </Grid>

                    <!-- PHONE BLUE POINT -->
                    <Grid
                        Grid.Column="2"
                    >
                        <Label
                            Text="{Binding Judges[0].BluePoints}"
                            TextColor="Blue"
                            FontSize="18"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Style="{StaticResource JudgePointsLabelStyle}"
                            IsVisible="{OnIdiom Tablet='false', Phone='true'}"
                        />

                    </Grid>

                    <!-- PHONE ACTIONS -->
                    <Grid 
                        Grid.Column="4"
                        ColumnDefinitions="*,*,*,*" 
                        ColumnSpacing="5" 
                        IsVisible="{OnIdiom Tablet='false', Phone='true'}"
                    >
                        <Border
                            Grid.Column="0"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="DarkRed"
                            Stroke="DarkRed"
                        >
                            <Label Text="-1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RemoveRedPointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            Grid.Column="1"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="Red"
                            Stroke="Red"
                        >
                            <Label Text="+1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddRedPointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            Grid.Column="2"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="DarkBlue"
                            Stroke="DarkBlue"
                        >
                            <Label Text="-1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RemoveBluePointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            Grid.Column="3"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="Blue"
                            Stroke="Blue"
                        >
                            <Label Text="+1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddBluePointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>


                    </Grid>
                </Grid>

