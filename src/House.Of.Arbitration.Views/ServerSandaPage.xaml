                                    TextColor="{StaticResource PrimaryTextColor}"
                                    FontAttributes="Bold"
                                    CornerRadius="20"
                                    HeightRequest="40"
                                    WidthRequest="130"
                                    Margin="0,0,0,0" 
                                />
                            </VerticalStackLayout>

                            <!-- ROUND -->
