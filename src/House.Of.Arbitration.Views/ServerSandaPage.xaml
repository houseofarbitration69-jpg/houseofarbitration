                                Grid.Row="0"
                                Grid.ColumnSpan="2"
                                Text="{Binding Judges[3].Name}"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                TextColor="{DynamicResource InverseTextColor}"
                                FontSize="18"
                            />

                            <Label
                                Grid.Row="1"
                                Grid.Column="0"
                                Text="{Binding Judges[3].RedPoints}"
                                FontSize="18"
                                TextColor="{DynamicResource RedSide}"
                                HorizontalOptions="Center"
                            />

                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Text="{Binding Judges[3].BluePoints}"
                                TextColor="{DynamicResource BlueSide}"
                                FontSize="18"
                                HorizontalOptions="Center"
                            />
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[3]}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <!-- ACTIONS -->
                    <Grid 
                        ColumnDefinitions="*,*,*,*" 
                        ColumnSpacing="5"
                    >
                        <!-- -1 RED -->
                        <Border
                            Grid.Column="0"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="{DynamicResource LessRedSide}"
                            Stroke="{DynamicResource LessRedSide}"
                        >
                            <Label 
                                Text="-1" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Center" 
                                FontSize="12" 
                                TextColor="{StaticResource PrimaryTextColor}" 
                                FontAttributes="Bold"
                            />

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RemoveRedPointCommand}" CommandParameter="{Binding Judges[3]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- +1 RED -->
                        <Border
                            Grid.Column="1"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="{DynamicResource MoreRedSide}"
                            Stroke="{DynamicResource MoreRedSide}"
                        >
                            <Label 
                                Text="+1" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Center" 
                                FontSize="12" 
                                TextColor="{StaticResource PrimaryTextColor}" 
                                FontAttributes="Bold"
                            />

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddRedPointCommand}" CommandParameter="{Binding Judges[3]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- -1 BLUE -->
                        <Border
                            Grid.Column="2"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="{DynamicResource LessBlueSide}"
                            Stroke="{DynamicResource LessBlueSide}"
                        >
                            <Label 
                                Text="-1" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Center" 
                                FontSize="12" 
                                TextColor="{DynamicResource PrimaryTextColor}" 
                                FontAttributes="Bold"
                            />

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RemoveBluePointCommand}" CommandParameter="{Binding Judges[3]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- +1 BLUE -->
                        <Border
                            Grid.Column="3"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="{DynamicResource MoreBlueSide}"
                            Stroke="{DynamicResource MoreBlueSide}"
                        >
                            <Label 
                                Text="+1" 
                                VerticalOptions="Center" 
                                HorizontalOptions="Center" 
                                FontSize="12" 
                                TextColor="{DynamicResource PrimaryTextColor}" 
                                FontAttributes="Bold"
                            />

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddBluePointCommand}" CommandParameter="{Binding Judges[3]}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- CHRONO & CONTROLS -->
                <Grid
                    Grid.Row="0"
                    Grid.RowSpan="4"
                    Grid.ColumnSpan="5" 
                    ColumnDefinitions="90,*,90"
                >
                    <Border 
                        Grid.Column="1"
                        HorizontalOptions="Center"
                        VerticalOptions="End"
                        Margin="0,0,0,0"
                        Padding="15,10,15,10"
                        BackgroundColor="{DynamicResource SurfaceElevation6}"
                        Stroke="{DynamicResource PrimaryTextColor}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 15"
                    >
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding BindingContext.CurrentDraw.Type, Source={x:Reference this}, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Border.Triggers>
                        
                        <VerticalStackLayout Spacing="5">
                            <Label 
                                Text="{Binding CurrentDraw.CurrentRound, StringFormat='ROUND {0}'}" 
                                HorizontalOptions="Center" 
                                TextColor="{DynamicResource SecondaryTextColor}" 
                                FontSize="18" 
                                FontAttributes="Bold" 
                            />

                            <Label 
                                Text="{Binding TimeLeftDisplay}" 
                                HorizontalOptions="Center" 
                                TextColor="{DynamicResource PrimaryTextColor}" 
                                FontSize="48" 
                                FontAttributes="Bold"
                                FontFamily="Monospace"
                            >
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SetTimerCommand}" />
                                </Label.GestureRecognizers>
                            </Label>

                            <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                                <!-- Reset -->
                                <Border 
                                    BackgroundColor="{DynamicResource BorderMuted}"
                                    HeightRequest="40"
                                    WidthRequest="40"
                                    StrokeThickness="0"
                                >
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>

                                    <Label 
                                        Text="↻" 
                                        TextColor="{DynamicResource PrimaryTextColor}"
                                        FontSize="20"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" 
                                        Padding="0,0,0,5"
                                    />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ResetTimerCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <!-- Start -->
                                <Border 
                                    BackgroundColor="{DynamicResource SuccessColor}"
                                    HeightRequest="40"
                                    WidthRequest="40"
                                    StrokeThickness="0"
                                    IsVisible="{Binding IsTimerRunning, Converter={StaticResource InvertBoolConverter}}"
                                >
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>

                                    <Path 
                                        Data="M 0,0 L 12,8 L 0,16 Z" 
                                        Fill="{DynamicResource PrimaryTextColor}" 
                                        HorizontalOptions="Center" 
                                        VerticalOptions="Center" 
                                        TranslationX="2" 
                                    />
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding StartTimerCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <!-- Pause -->
                                <Border 
                                    BackgroundColor="{DynamicResource WarningColor}"
                                    HeightRequest="40"
                                    WidthRequest="40"
                                    StrokeThickness="0"
                                    IsVisible="{Binding IsTimerRunning}"
                                >
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20"/>
                                    </Border.StrokeShape>

                                    <Grid 
                                        ColumnDefinitions="4, 4, 4" 
                                          HorizontalOptions="Center" 
                                          VerticalOptions="Center" 
                                          HeightRequest="16"
                                          ColumnSpacing="0">
                                        <BoxView Grid.Column="0" BackgroundColor="{DynamicResource PrimaryTextColor}" WidthRequest="4" CornerRadius="1"/>
                                        <BoxView Grid.Column="2" BackgroundColor="{DynamicResource PrimaryTextColor}" WidthRequest="4" CornerRadius="1"/>
                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PauseTimerCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </Grid>

            <!-- PAS DE MATCH DISPONIBLE -->
            <VerticalStackLayout 
                Grid.ColumnSpan="2"
                HorizontalOptions="Center"
                VerticalOptions="Center" 
                Spacing="20"
                IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
            >
                <Label 
                    Text="{Binding Resources.EMPTY_MATCH}" 
                    TextColor="{DynamicResource PrimaryTextColor}" 
                    FontSize="28" 
                    FontAttributes="Bold" 
                    HorizontalOptions="Center"
                />
                <Button 
                    Text="RETOUR"
                    Command="{Binding RequestBackNavigationCommand}"
                    BackgroundColor="{DynamicResource PrimaryColor}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    WidthRequest="160"
                    HeightRequest="46"
                    HorizontalOptions="Center"
                />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</base:BasePage>