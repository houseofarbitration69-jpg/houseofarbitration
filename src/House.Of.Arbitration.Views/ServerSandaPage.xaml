                                          ColumnSpacing="0">
                                        <BoxView Grid.Column="0" BackgroundColor="{DynamicResource PrimaryTextColor}" WidthRequest="4" CornerRadius="1"/>
                                        <BoxView Grid.Column="2" BackgroundColor="{DynamicResource PrimaryTextColor}" WidthRequest="4" CornerRadius="1"/>
                                    </Grid>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding PauseTimerCommand}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </HorizontalStackLayout>

                            <Button 
                                Text="ROUND SUIVANT" 
                                Command="{Binding NextRoundCommand}"
                                BackgroundColor="{DynamicResource SurfaceElevation7}"
                                TextColor="{DynamicResource PrimaryTextColor}"
                                FontAttributes="Bold"
                                CornerRadius="20"
                                HeightRequest="40"
                                Margin="0,10,0,0" 
                            />
                        </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="2"
                        StrokeShape="RoundRectangle 50"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{DynamicResource ValidColor}"
                        Stroke="{DynamicResource ValidColor}"
                        IsVisible="{OnIdiom Tablet='false', Phone='true'}"
                    >
                        <Label 
                            FontFamily="{x:Static helpers:FontHelper.FONTAWESOME_SOLID_NAME}"
                            Text="{x:Static helpers:FontAwesomeIcons.BARS}" 
                            FontSize="25" 
                            TextColor="{DynamicResource PrimaryTextColor}" 
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            FontAttributes="Bold"
                        />

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSideSheetCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>
            </Grid>

            <!-- PAS DE MATCH DISPONIBLE -->
            <Label 
                Grid.ColumnSpan="2"
                Text="{Binding Resources.EMPTY_MATCH}" 
                TextColor="{DynamicResource PrimaryTextColor}" 
                FontSize="28" 
                FontAttributes="Bold" 
                HorizontalOptions="Center"
                VerticalOptions="Center" 
                IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
            />
        </Grid>

        <!-- Side Sheet Control -->
        <controls:SideSheetControl 
            IsOpen="{Binding IsSideSheetOpen}"
            CloseCommand="{Binding CloseSideSheetCommand}"
        >
            <controls:SideSheetControl.SheetContent>
                <VerticalStackLayout Spacing="20">
                    <Label 
                        Text="MENU" 
                        FontSize="24" 
                        FontAttributes="Bold" 
                        TextColor="{DynamicResource PrimaryTextColor}" 
                        HorizontalOptions="Center" 
                        Margin="0,0,0,10" 
                    />

                    <!-- Statut du serveur dans la feuille latérale -->
                    <!--<Border
                        StrokeShape="RoundRectangle 12"
