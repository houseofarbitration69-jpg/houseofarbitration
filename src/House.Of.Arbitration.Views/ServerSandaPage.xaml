                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    TextColor="{DynamicResource InverseTextColor}"
                                    FontSize="18"
                                />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Judges[2].RedPoints}"
                                    FontSize="18"
                                    TextColor="{DynamicResource RedSide}"
                                    HorizontalOptions="Center"
                                />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Judges[2].BluePoints}"
                                    TextColor="{DynamicResource BlueSide}"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                />
                            </Grid>
                            
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[2]}" />
                            </Border.GestureRecognizers>
