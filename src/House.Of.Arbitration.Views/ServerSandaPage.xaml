                                    />
                                </Border>

                                <Border 
                                    StrokeShape="RoundRectangle 50" 
                                    HeightRequest="100" 
                                    WidthRequest="100" 
                                    HorizontalOptions="Center" 
                                    Stroke="White" 
                                    StrokeThickness="3"
                                    BackgroundColor="White"
                                    IsVisible="{Binding Competitor2.Photo, Converter={StaticResource IsNullOrEmptyConverter}}"
                                >
                                    <Label 
