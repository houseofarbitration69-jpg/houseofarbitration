                    <Button 
                        Text="DÉMARRER" 
                        Command="{Binding StartServerCommand}"
                        BackgroundColor="{DynamicResource ValidColor}"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="50"
                        IsVisible="{Binding IsServerStarted, Converter={StaticResource InvertBoolConverter}}"
                    />

                    <Button 
                        Text="ARRÉTER" 
                        Command="{Binding StopServerCommand}"
                        BackgroundColor="Red"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="50"
                        IsVisible="{Binding IsServerStarted}"
                    />

                    <Button 
                        Text="DIFFUSER" 
                        Command="{Binding BroadcastMatchInfoCommand}"
                        BackgroundColor="{DynamicResource ValidColor}"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="50"
                    />

                    <Button 
                        Text="VOIR LES TIRAGES" 
                        Command="{Binding GoToDrawsCommand}"
                        BackgroundColor="{DynamicResource ValidColor}"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="50"
                    />

                    <Button 
                        Text="FERMER" 
                        Command="{Binding CloseSideSheetCommand}"
                        BackgroundColor="Gray"
                        TextColor="White"
                        CornerRadius="20"
                        HeightRequest="40"
                        Margin="0,20,0,0"
                    />
                </VerticalStackLayout>
            </controls:SideSheetControl.SheetContent>
        </controls:SideSheetControl>
    </Grid>
</base:BasePage>