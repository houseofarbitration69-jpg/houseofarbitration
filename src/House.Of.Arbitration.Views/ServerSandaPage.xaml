                                                        <Label 
                                                            Text="{Binding RoundNumber, StringFormat='R{0}'}" 
                                                            TextColor="{DynamicResource PrimaryTextColor}" 
                                                            FontAttributes="Bold" 
                                                            VerticalOptions="Center" 
                                                        />

                                                        <Label 
                                                            Text="{Binding RedVotes}" 
                                                            TextColor="{DynamicResource RedCornerColor}" 
                                                            FontAttributes="Bold" 
                                                            FontSize="18" 
                                                            VerticalOptions="Center" 
                                                        />

