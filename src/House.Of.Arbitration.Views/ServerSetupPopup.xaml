<?xml version="1.0" encoding="utf-8" ?>
<base:BaseView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    x:TypeArguments="vm:ServerSetupPopupViewModel"
    x:Class="House.Of.Arbitration.Views.ServerSetupPopup"
    x:DataType="vm:ServerSetupPopupViewModel"
    BackgroundColor="#333333">

    <Border Stroke="White" StrokeThickness="2" BackgroundColor="#222222" Padding="20" WidthRequest="400" HorizontalOptions="Center" VerticalOptions="Center">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="15"/>
        </Border.StrokeShape>
        
        <VerticalStackLayout Spacing="15">
            <Label Text="CONFIGURATION DU SERVEUR" FontSize="20" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White"/>
            
            <VerticalStackLayout Spacing="5">
                <Label Text="Nom du serveur" TextColor="LightGray" FontSize="14"/>
                <Entry Text="{Binding ServerName}" Placeholder="Nom (ex: SERVEUR_KUNGFU)" TextColor="White" BackgroundColor="#444444"/>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label Text="Description / Ring" TextColor="LightGray" FontSize="14"/>
                <Entry Text="{Binding ServerDescription}" Placeholder="Description (ex: Ring 1)" TextColor="White" BackgroundColor="#444444"/>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="ANNULER" Command="{Binding CancelCommand}" BackgroundColor="Gray" TextColor="White"/>
                <Button Grid.Column="1" Text="DÉMARRER" Command="{Binding ConfirmCommand}" BackgroundColor="{DynamicResource ValidColor}" TextColor="White"/>
            </Grid>
        </VerticalStackLayout>
    </Border>
</base:BaseView>
