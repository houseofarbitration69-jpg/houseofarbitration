<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    x:TypeArguments="vm:MasterViewModel"
    x:Class="House.Of.Arbitration.Views.OldHomePage"
    x:DataType="vm:MasterViewModel"
    x:Name="this">

    <ScrollView>
        <Grid>
            <Label Text="{Binding Title}" TextColor="White" HorizontalOptions="Center" FontSize="60"/>
            <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="20" Margin="0,20,0,0">
                <controls:IconButton
                    WidthRequest="250"
                    Text="{Binding Resources.ADD_COMPETITION}"
                    IsFullWidth="True"
                    IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                    Icon="{x:Static helpers:FontCustomIcons.ADD}"
                    ButtonBackgroundColor="{StaticResource Primary}"
                    IconColor="{StaticResource PrimaryTextColor}"
                    TextColor="{StaticResource PrimaryTextColor}"
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="CompetitionWizard"
                />
                <controls:IconButton
                    WidthRequest="250"
                    Text="{Binding Resources.START_COMPETITION}"
                    IsFullWidth="True"
                    IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                    Icon="{x:Static helpers:FontCustomIcons.TROPHY}"
                    ButtonBackgroundColor="{StaticResource Primary}"
                    IconColor="{StaticResource PrimaryTextColor}"
                    TextColor="{StaticResource PrimaryTextColor}"
                    IsEnabled="{Binding StartCompetitionIsEnabled}"
                    Command="{Binding NavigateToCommand}"
                    CommandParameter="Competitions"
                />
            </VerticalStackLayout>
        </Grid>
    </ScrollView>

</base:BasePage>
