<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    xmlns:selectors="clr-namespace:House.Of.Arbitration.Views.Selectors;assembly=House.Of.Arbitration.Views"
    x:TypeArguments="vm:ServerViewModel"
    x:Class="House.Of.Arbitration.Views.ServerPage"
    x:DataType="vm:ServerViewModel"
    x:Name="this"
    Title="{Binding Title}"
    >
    <base:BasePage.Resources>
        <ResourceDictionary>
            <converters:IsoCodeToFlagPathConverter x:Key="IsoCodeToFlagPathConverter" />
            <converters:EmptyToBoolConverter x:Key="EmptyToBoolConverter" />
            <converters:CategoryTypeToBoolConverter x:Key="CategoryTypeToBoolConverter" />
            <converters:RoundTypeToBoolConverter x:Key="RoundTypeToBoolConverter" />
            <converters:GenreToImageConverter x:Key="GenreToImageConverter" />
            <converters:GenreToBoolConverter x:Key="GenreToBoolConverter" />
            <converters:GenreToFontConverter x:Key="GenreToFontConverter" />
            <converters:InvertBoolConverter x:Key="InvertBoolConverter" />
            <converters:IsNullOrEmptyConverter x:Key="IsNullOrEmptyConverter" />

            <Style x:Key="CompetitorInfoLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="Gray"/>
            </Style>

            <Style x:Key="MainCompetitorNameStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="36"/>
                <Setter Property="CharacterSpacing" Value="2"/>
            </Style>

            <Style x:Key="MainCompetitorClubStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>

            <Style x:Key="MainCompetitorCountryStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Opacity" Value="0.8"/>
                <Setter Property="FontAttributes" Value="Italic"/>
            </Style>

            <DataTemplate x:Key="KnockoutTemplate" x:DataType="models:DrawKnockoutModel">
                <Border 
                    Padding="10,10,10,10" 
                    Stroke="#EEEEEE" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#EEEEEE"
                >
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*">
                        <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}">
                                    <Label Text="{Binding Competitor1.LastName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Competitor1.FirstName}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente" 
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                />
                                <Label 
                                    Text="{Binding Competitor1.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>

                        <Label 
                            Grid.Column="0" 
                            Grid.Row="1" 
                            Text="VS" 
                            HorizontalOptions="Center" 
                            TextColor="DarkGray" 
                            FontAttributes="Bold" 
                            Margin="0,5"
                        />

                        <Grid Grid.Column="0" Grid.Row="2" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}"
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}">
                                    <Label Text="{Binding Competitor2.LastName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Competitor2.FirstName}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente" 
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                />

                                <Label 
                                    Text="{Binding Competitor2.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="PoolTemplate" x:DataType="models:DrawPoolsModel">
                <Border 
                    Margin="0,2" 
                    Padding="10"
                    Stroke="#EEEEEE" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#EEEEEE"
                >
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*">
                        <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}">
                                    <Label Text="{Binding Competitor1.LastName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Competitor1.FirstName}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente match précédent" 
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <Label 
                                    Text="{Binding Competitor1.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>

                        <Label 
                            Grid.Column="1" 
                            Grid.Row="1" 
                            Text="VS" 
                            HorizontalOptions="Center" 
                            TextColor="DarkGray" 
                            FontAttributes="Bold" 
                            Margin="0,5"
                        />

                        <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}">
                                    <Label Text="{Binding Competitor2.LastName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Competitor2.FirstName}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente match précédent" 
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <Label 
                                    Text="{Binding Competitor2.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="OrderTemplate" x:DataType="models:DrawOrderModel">
                <Border 
                    Margin="0,2" 
                    Padding="10" 
                    Stroke="#EEEEEE" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#EEEEEE"
                >
                    <Grid ColumnDefinitions="*">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}">
                                    <Label Text="{Binding Competitor.LastName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Competitor.FirstName}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente" 
                                    IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <Label 
                                    Text="{Binding Competitor.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="HeaderTemplate" x:DataType="x:String">
                <Label 
                    Text="{Binding .}" 
                    BackgroundColor="#F5F5F5" 
                    TextColor="#333333"
                    FontAttributes="Bold" 
                    Padding="10,8"
                    FontSize="14"
                    Margin="0,10,0,5"
                />
            </DataTemplate>

            <selectors:DrawTemplateSelector x:Key="DrawTemplateSelector"
                                            KnockoutTemplate="{StaticResource KnockoutTemplate}"
                                            PoolTemplate="{StaticResource PoolTemplate}"
                                            OrderTemplate="{StaticResource OrderTemplate}"
                                            HeaderTemplate="{StaticResource HeaderTemplate}"/>
        </ResourceDictionary>
    </base:BasePage.Resources>

    <Grid ColumnDefinitions="300,*" ColumnSpacing="15" Margin="10">
        <CollectionView 
            ItemsSource="{Binding Draws}"
            ItemTemplate="{StaticResource DrawTemplateSelector}"
        >
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
            </CollectionView.ItemsLayout>
        </CollectionView>

        <Grid Grid.Column="1" RowDefinitions="85,*,85" ColumnDefinitions="85,*,85">
            <Border 
                Grid.Row="0" 
                Grid.Column="0" 
                Background="LightGray"
                WidthRequest="80"
                HeightRequest="45"
                Rotation="-45"
                StrokeShape="RoundRectangle 5"
            >
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                    <Label 
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Text="{Binding Judges[0].Name}"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="Black"
                    />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{Binding Judges[0].RedPoints}"
                        FontSize="16"
                        TextColor="Red"
                        HorizontalOptions="Center"
                    />

                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding Judges[0].BluePoints}"
                        TextColor="Blue"
                        FontSize="16"
                        HorizontalOptions="Center"
                    />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[0]}" />
                </Border.GestureRecognizers>
            </Border>

            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="10" HorizontalOptions="Center">
                <Border 
                    Grid.Column="0"
                    Background="LightGray"
                    WidthRequest="80"
                    HeightRequest="45"
                    VerticalOptions="Start"
                    StrokeShape="RoundRectangle 5"
                />
                <Border 
                    Grid.Column="1"
                    Background="LightGray"
                    WidthRequest="80"
                    HeightRequest="45"
                    VerticalOptions="Start"
                    StrokeShape="RoundRectangle 5"
                />
                <Border 
                    Grid.Column="2"
                    Background="LightGray"
                    WidthRequest="80"
                    HeightRequest="45"
                    VerticalOptions="Start"
                    StrokeShape="RoundRectangle 5"
                />
                <Border 
                    Grid.Column="3"
                    Background="LightGray"
                    WidthRequest="80"
                    HeightRequest="45"
                    VerticalOptions="Start"
                    StrokeShape="RoundRectangle 5"
                />
            </HorizontalStackLayout>

            <Border
                Grid.Row="0" 
                Grid.Column="2" 
                Background="LightGray"
                WidthRequest="80"
                HeightRequest="45"
                Rotation="45"
                StrokeShape="RoundRectangle 5"
            >
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                    <Label 
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Text="{Binding Judges[1].Name}"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="Black"
                    />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{Binding Judges[1].RedPoints}"
                        FontSize="16"
                        TextColor="Red"
                        HorizontalOptions="Center"
                    />

                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding Judges[1].BluePoints}"
                        TextColor="Blue"
                        FontSize="16"
                        HorizontalOptions="Center"
                    />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[1]}" />
                </Border.GestureRecognizers>
            </Border>

            <Grid 
                Grid.Row="1" 
                Grid.Column="1" 
                RowDefinitions="Auto,*,Auto" 
                ColumnDefinitions="*,*"
            >
                <!-- Fallback when no matches are remaining -->
                <VerticalStackLayout 
                    Grid.RowSpan="3" 
                    Grid.ColumnSpan="2" 
                    VerticalOptions="Center" 
                    HorizontalOptions="Center" 
                    Spacing="20"
                    IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                >
                    <Label Text="🏆" FontSize="64" HorizontalOptions="Center"/>
                    <Label Text="Tous les matchs sont terminés" TextColor="White" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Current Match Area -->
                <Grid 
                    Grid.RowSpan="3" 
                    Grid.ColumnSpan="2" 
                    x:DataType="{x:Null}"
                    BindingContext="{Binding CurrentDraw}"
                    IsVisible="{Binding CurrentDraw, Source={RelativeSource AncestorType={x:Type vm:ServerViewModel}}, Converter={StaticResource EmptyToBoolConverter}}"
                >
                    <!-- Background Layers (Red / Blue) -->
                    <Grid RowDefinitions="*" ColumnDefinitions="*,*">
                        <Border 
                            Grid.Column="0" 
                            Background="Red" 
                            StrokeThickness="0" 
                            Opacity="0.8" 
                            StrokeShape="RoundRectangle 8,0,8,0"
                        />
                        <Border 
                            Grid.Column="1" 
                            Background="Blue" 
                            StrokeThickness="0" 
                            Opacity="0.8"
                            IsVisible="{Binding Draw.Category.RoundType, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='NotOrder'}" 
                            StrokeShape="RoundRectangle 0,8,0,8"
                        />

                        <!-- For Order mode, red covers full width -->
                        <Border Grid.ColumnSpan="2" Background="Red" StrokeThickness="0" Opacity="0.8"
                                IsVisible="{Binding Draw.Category.RoundType, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" />
                    </Grid>

                    <!-- Knockout / Round Robin Mode -->
                    <Grid ColumnDefinitions="*,*" IsVisible="False">
                        <!-- Competitor 1 (Red Side) -->
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="10">
                            <!-- Circular Photo / Icon -->
                            <Border 
                                StrokeShape="RoundRectangle 50" 
                                HeightRequest="100" 
                                WidthRequest="100" 
                                HorizontalOptions="Center" 
                                Stroke="White" 
                                BackgroundColor="White"
                                StrokeThickness="3"
                                IsVisible="{Binding Competitor1.Photo, Converter={StaticResource IsNullOrEmptyConverter}, ConverterParameter='Invert'}"
                            >
                                <Image 
                                    Source="{Binding Competitor1, Converter={StaticResource GenreToImageConverter}, ConverterParameter=20}" 
                                    Aspect="AspectFill" 
                                />
                            </Border>

                            <Border 
                                StrokeShape="RoundRectangle 50" 
                                HeightRequest="100" 
                                WidthRequest="100" 
                                HorizontalOptions="Center" 
                                Stroke="White" 
                                StrokeThickness="3"
                                BackgroundColor="White"
                                IsVisible="{Binding Competitor1.Photo, Converter={StaticResource IsNullOrEmptyConverter}}"
                            >
                                <Label 
                                    Text="{Binding Competitor1.Genre, Converter={StaticResource GenreToFontConverter}}" 
                                    FontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}" 
                                    FontSize="99" 
                                    VerticalOptions="Center" 
                                    HorizontalOptions="Center"
                                />
                            </Border>

                            <!-- Name on two lines -->
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding Competitor1.LastName}" Style="{StaticResource MainCompetitorNameStyle}" FontSize="28" />
                                <Label Text="{Binding Competitor1.FirstName}" Style="{StaticResource MainCompetitorNameStyle}" FontSize="32" Margin="0,-5,0,0" />
                            </VerticalStackLayout>

                            <!-- Club & Country -->
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Competitor1.Club}" Style="{StaticResource MainCompetitorClubStyle}" FontSize="18" />
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Image Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                           WidthRequest="25" HeightRequest="15" VerticalOptions="Center" />
                                    <Label Text="{Binding Competitor1.Country.Name}" Style="{StaticResource MainCompetitorCountryStyle}" FontSize="16" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Winner Button -->
                            <Button Text="GAGNANT ROUGE" 
                                    Command="{Binding x:DataType='vm:ServerViewModel', Source={RelativeSource AncestorType={x:Type vm:ServerViewModel}}, Path=SetWinnerCommand}"
                                    CommandParameter="Red"
                                    BackgroundColor="DarkRed"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="20"
                                    HeightRequest="40"
                                    Margin="0,10,0,0" />
                        </VerticalStackLayout>

                        <!-- Competitor 2 (Blue Side) -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10" Padding="10">
                            <!-- Circular Photo / Icon -->
                            <Border 
                                StrokeShape="RoundRectangle 50" 
                                HeightRequest="100" 
                                WidthRequest="100" 
                                HorizontalOptions="Center" 
                                Stroke="White" 
                                BackgroundColor="White"
                                StrokeThickness="3"
                                IsVisible="{Binding Competitor1.Photo, Converter={StaticResource IsNullOrEmptyConverter}, ConverterParameter='Invert'}"
                            >
                                <Image Source="{Binding Competitor2, Converter={StaticResource GenreToImageConverter}, ConverterParameter=10}" 
                                       Aspect="AspectFill" />
                            </Border>

                            <Border 
                                StrokeShape="RoundRectangle 50" 
                                HeightRequest="100" 
                                WidthRequest="100" 
                                HorizontalOptions="Center" 
                                Stroke="White" 
                                StrokeThickness="3"
                                BackgroundColor="White"
                                IsVisible="{Binding Competitor2.Photo, Converter={StaticResource IsNullOrEmptyConverter}}"
                            >
                                <Label 
                                    Text="{Binding Competitor2.Genre, Converter={StaticResource GenreToFontConverter}}" 
                                    FontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}" 
                                    FontSize="99" 
                                    VerticalOptions="Center" 
                                    HorizontalOptions="Center"
                                />
                            </Border>

                            <!-- Name on two lines -->
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding Competitor2.LastName}" Style="{StaticResource MainCompetitorNameStyle}" FontSize="28" />
                                <Label Text="{Binding Competitor2.FirstName}" Style="{StaticResource MainCompetitorNameStyle}" FontSize="32" Margin="0,-5,0,0" />
                            </VerticalStackLayout>

                            <!-- Club & Country -->
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding Competitor2.Club}" Style="{StaticResource MainCompetitorClubStyle}" FontSize="18" />
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                    <Image Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                           WidthRequest="25" HeightRequest="15" VerticalOptions="Center" />
                                    <Label Text="{Binding Competitor2.Country.Name}" Style="{StaticResource MainCompetitorCountryStyle}" FontSize="16" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Winner Button -->
                            <Button Text="GAGNANT BLEU" 
                                    Command="{Binding x:DataType='vm:ServerViewModel', Source={RelativeSource AncestorType={x:Type vm:ServerViewModel}}, Path=SetWinnerCommand}"
                                    CommandParameter="Blue"
                                    BackgroundColor="DarkBlue"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="20"
                                    HeightRequest="40"
                                    Margin="0,10,0,0" />
                        </VerticalStackLayout>

                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding Draw.Category.RoundType, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='NotOrder'}" Value="True">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Grid.Triggers>
                    </Grid>

                    <!-- Order Mode (Taolu) -->
                    <Grid IsVisible="False">
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                            <!-- Circular Photo / Icon -->
                            <Border StrokeShape="RoundRectangle 75" HeightRequest="150" WidthRequest="150" HorizontalOptions="Center" Stroke="White" StrokeThickness="4">
                                <Image Source="{Binding Competitor, Converter={StaticResource GenreToImageConverter}, ConverterParameter=90}" 
                                       Aspect="AspectFill" />
                            </Border>

                            <!-- Name on two lines -->
                            <VerticalStackLayout HorizontalOptions="Center">
                                <Label Text="{Binding Competitor.LastName}" Style="{StaticResource MainCompetitorNameStyle}" FontSize="36" />
                                <Label Text="{Binding Competitor.FirstName}" Style="{StaticResource MainCompetitorNameStyle}" FontSize="48" Margin="0,-8,0,0" />
                            </VerticalStackLayout>

                            <!-- Club & Country -->
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Competitor.Club}" Style="{StaticResource MainCompetitorClubStyle}" FontSize="28" />
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12">
                                    <Image Source="{Binding Competitor.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                           WidthRequest="40" HeightRequest="25" VerticalOptions="Center" />
                                    <Label Text="{Binding Competitor.Country.Name}" Style="{StaticResource MainCompetitorCountryStyle}" FontSize="24" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <!-- Finish Button for Order mode -->
                            <Button Text="VALIDER LE PASSAGE" 
                                    Command="{Binding x:DataType='vm:ServerViewModel', Source={RelativeSource AncestorType={x:Type vm:ServerViewModel}}, Path=SetWinnerCommand}"
                                    CommandParameter="Finish"
                                    BackgroundColor="DarkGreen"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="20"
                                    HeightRequest="50"
                                    WidthRequest="250"
                                    Margin="0,20,0,0" />
                        </VerticalStackLayout>

                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding Draw.Category.RoundType, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" Value="True">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Grid.Triggers>
                    </Grid>
                </Grid>
            </Grid>

            <Border 
                Grid.Row="2" 
                Grid.Column="0" 
                Background="LightGray"
                WidthRequest="80"
                HeightRequest="45"
                Rotation="45"
                StrokeShape="RoundRectangle 5"
            >
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                    <Label 
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Text="{Binding Judges[2].Name}"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="Black"
                    />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{Binding Judges[2].RedPoints}"
                        FontSize="16"
                        TextColor="Red"
                        HorizontalOptions="Center"
                    />

                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding Judges[2].BluePoints}"
                        TextColor="Blue"
                        FontSize="16"
                        HorizontalOptions="Center"
                    />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[2]}" />
                </Border.GestureRecognizers>
            </Border>

            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,*">
                <Border 
                    Grid.Column="1"
                    Background="LightGray"
                    WidthRequest="80"
                    HeightRequest="45"
                    VerticalOptions="End"
                    StrokeShape="RoundRectangle 5"
                >
                    <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                        <Label 
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Text="{Binding Judges[3].Name}"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="Black"
                    />

                        <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{Binding Judges[3].RedPoints}"
                        FontSize="16"
                        TextColor="Red"
                        HorizontalOptions="Center"
                    />

                        <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding Judges[3].BluePoints}"
                        TextColor="Blue"
                        FontSize="16"
                        HorizontalOptions="Center"
                    />
                    </Grid>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[3]}" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <Border 
                Grid.Row="2" 
                Grid.Column="2" 
                Background="LightGray"
                WidthRequest="80"
                HeightRequest="45"
                Rotation="-45"
                StrokeShape="RoundRectangle 5"
            >
                <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                    <Label 
                        Grid.Row="0"
                        Grid.ColumnSpan="2"
                        Text="{Binding Judges[4].Name}"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        TextColor="Black"
                    />

                    <Label
                        Grid.Row="1"
                        Grid.Column="0"
                        Text="{Binding Judges[4].RedPoints}"
                        FontSize="16"
                        TextColor="Red"
                        HorizontalOptions="Center"
                    />

                    <Label
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{Binding Judges[4].BluePoints}"
                        TextColor="Blue"
                        FontSize="16"
                        HorizontalOptions="Center"
                    />
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[4]}" />
                </Border.GestureRecognizers>
            </Border>
            <!-- CATEGORY -->
            <Border 
                Grid.RowSpan="3"
                Grid.ColumnSpan="3" 
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="0,30,0,0"
                StrokeThickness="0"
            >
                <Label 
                    Text="{Binding CurrentDraw.Draw.Category.Name}"
                    TextColor="White" 
                    FontSize="32" 
                    FontAttributes="Bold"
                    Padding="0,10,0,0"
                />
            </Border>

            <!-- CHRONO & CONTROLS -->
            <Border 
                Grid.RowSpan="3"
                Grid.ColumnSpan="3" 
                HorizontalOptions="Center"
                VerticalOptions="End"
                Margin="0,0,0,50"
                Padding="15,10,15,10"
                BackgroundColor="#333"
                Stroke="White"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 15"
            >
                <VerticalStackLayout Spacing="5">
                    <Label 
                        Text="{Binding TimeLeftDisplay}" 
                        HorizontalOptions="Center" 
                        TextColor="White" 
                        FontSize="48" 
                        FontAttributes="Bold"
                        FontFamily="Monospace"
                    >
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SetTimerCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                        <!-- Reset -->
                        <Border BackgroundColor="Gray"
                                HeightRequest="36"
                                WidthRequest="36"
                                StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <Label Text="↺" 
                                   TextColor="White"
                                   FontSize="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ResetTimerCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Start -->
                        <Border BackgroundColor="Green"
                                HeightRequest="36"
                                WidthRequest="36"
                                StrokeThickness="0"
                                IsVisible="{Binding IsTimerRunning, Converter={StaticResource InvertBoolConverter}}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <Path Data="M 0,0 L 12,8 L 0,16 Z" 
                                  Fill="White" 
                                  HorizontalOptions="Center" 
                                  VerticalOptions="Center" 
                                  TranslationX="2" />
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding StartTimerCommand}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- Pause -->
                        <Border BackgroundColor="Orange"
                                HeightRequest="36"
                                WidthRequest="36"
                                StrokeThickness="0"
                                IsVisible="{Binding IsTimerRunning}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18"/>
                            </Border.StrokeShape>
                            <Grid ColumnDefinitions="4, 4, 4" 
                                  HorizontalOptions="Center" 
                                  VerticalOptions="Center" 
                                  HeightRequest="16"
                                  ColumnSpacing="0">
                                <BoxView Grid.Column="0" BackgroundColor="White" WidthRequest="4" CornerRadius="1"/>
                                <BoxView Grid.Column="2" BackgroundColor="White" WidthRequest="4" CornerRadius="1"/>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding PauseTimerCommand}" />
                            </Border.GestureRecognizers>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</base:BasePage>
