                        Padding="15,10,15,10"
                        BackgroundColor="#333"
                        Stroke="White"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 15"
                        IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}}"
                    >
                        <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding BindingContext.CurrentDraw.Type, Source={x:Reference this}, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" Value="True">
                            <Setter Property="IsVisible" Value="False" />
                        </DataTrigger>
                    </Border.Triggers>
                        <VerticalStackLayout Spacing="5">
                        <Label 
                            Text="{Binding TimeLeftDisplay}" 
                            HorizontalOptions="Center" 
                            TextColor="White" 
                            FontSize="48" 
                            FontAttributes="Bold"
                            FontFamily="Monospace"
                        >
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SetTimerCommand}" />
                            </Label.GestureRecognizers>
                        </Label>

                        <HorizontalStackLayout Spacing="15" HorizontalOptions="Center">
                            <!-- Reset -->
                            <Border 
                                BackgroundColor="Gray"
                                HeightRequest="40"
                                WidthRequest="40"
                                StrokeThickness="0"
                            >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Label 
                                    Text="↺" 
                                    TextColor="White"
                                    FontSize="20"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center" 
                                    Padding="0,0,0,5"
                                />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ResetTimerCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Start -->
                            <Border BackgroundColor="Green"
                                    HeightRequest="40"
                                    WidthRequest="40"
                                    StrokeThickness="0"
                                    IsVisible="{Binding IsTimerRunning, Converter={StaticResource InvertBoolConverter}}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Path 
                                    Data="M 0,0 L 12,8 L 0,16 Z" 
                                    Fill="White" 
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center" 
                                    TranslationX="2" 
                                />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding StartTimerCommand}" />
                                </Border.GestureRecognizers>
                            </Border>

                            <!-- Pause -->
                            <Border 
                                BackgroundColor="Orange"
                                HeightRequest="40"
                                WidthRequest="40"
                                StrokeThickness="0"
                                IsVisible="{Binding IsTimerRunning}"
                            >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="20"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="4, 4, 4" 
                                      HorizontalOptions="Center" 
                                      VerticalOptions="Center" 
                                      HeightRequest="16"
                                      ColumnSpacing="0">
                                    <BoxView Grid.Column="0" BackgroundColor="White" WidthRequest="4" CornerRadius="1"/>
                                    <BoxView Grid.Column="2" BackgroundColor="White" WidthRequest="4" CornerRadius="1"/>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding PauseTimerCommand}" />
                                </Border.GestureRecognizers>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    </Border>

                    <Border
                        Grid.Column="2"
                        StrokeShape="RoundRectangle 50"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{StaticResource ValidColor}"
                        Stroke="{StaticResource ValidColor}"
                        IsVisible="{OnIdiom Tablet='false', Phone='true'}"
                    >
                        <Label 
                            Text="≡" 
                            VerticalOptions="Center" 
                            HorizontalOptions="Center" 
                            FontSize="30" 
                            TextColor="{StaticResource PrimaryTextColor}" 
                            FontAttributes="Bold"
                        />

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSideSheetCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>

                </Grid>
            </Grid>
        </Grid>

        <!-- Side Sheet Control -->
        <controls:SideSheetControl 
            IsOpen="{Binding IsSideSheetOpen}"
            CloseCommand="{Binding CloseSideSheetCommand}"
        >
            <controls:SideSheetControl.SheetContent>
                <VerticalStackLayout Spacing="20">
                    <Label Text="CONTRÔLE" FontSize="24" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" Margin="0,0,0,10" />

                    <Button 
                        Text="DEMARRER" 
                        Command="{Binding StartServerCommand}"
                        BackgroundColor="{DynamicResource ValidColor}"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="50"
                        IsVisible="{Binding IsServerStarted, Converter={StaticResource InvertBoolConverter}}"
                    />

                    <Button 
                        Text="ARRETER" 
                        Command="{Binding StopServerCommand}"
                        BackgroundColor="Red"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="50"
                        IsVisible="{Binding IsServerStarted}"
                    />

                    <Button 
                        Text="DIFFUSER" 
                        Command="{Binding BroadcastMatchInfoCommand}"
                        BackgroundColor="{DynamicResource ValidColor}"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="50"
                    />

                    <Button 
                        Text="VOIR LES TIRAGES" 
                        Command="{Binding GoToDrawsCommand}"
                        BackgroundColor="{DynamicResource ValidColor}"
                        TextColor="Black"
                        FontAttributes="Bold"
                        CornerRadius="20"
                        HeightRequest="50"
                    />

                    <Button 
                        Text="FERMER" 
                        Command="{Binding CloseSideSheetCommand}"
                        BackgroundColor="Gray"
                        TextColor="White"
                        CornerRadius="20"
                        HeightRequest="40"
                        Margin="0,20,0,0"
                    />
                </VerticalStackLayout>
            </controls:SideSheetControl.SheetContent>
        </controls:SideSheetControl>
    </Grid>
</base:BasePage>