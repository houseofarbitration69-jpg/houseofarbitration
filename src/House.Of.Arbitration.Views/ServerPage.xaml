<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    xmlns:selectors="clr-namespace:House.Of.Arbitration.Views.Selectors;assembly=House.Of.Arbitration.Views"
    xmlns:local="clr-namespace:House.Of.Arbitration.Views"
    x:TypeArguments="vm:ServerViewModel"
    x:Class="House.Of.Arbitration.Views.ServerPage"
    x:DataType="vm:ServerViewModel"
    x:Name="this"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="false"
>
    <base:BasePage.Resources>
        <ResourceDictionary>
            <DataTemplate x:Key="KnockoutTemplate" x:DataType="models:DrawKnockoutModel">
                <Border 
                    Padding="10,10,10,10" 
                    Stroke="#EEEEEE" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#EEEEEE"
                >
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*">
                        <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                            />

                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente" 
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                />
                                <controls:ScrollingText 
                                    Text="{Binding Competitor1.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>

                        <Label 
                            Grid.Column="0" 
                            Grid.Row="1" 
                            Text="VS" 
                            HorizontalOptions="Center" 
                            TextColor="DarkGray" 
                            FontAttributes="Bold" 
                            Margin="0,5"
                        />

                        <Grid Grid.Column="0" Grid.Row="2" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}"
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor2.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText
                                        Text="{Binding Competitor2.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente" 
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                    HorizontalOptions="Center"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor2.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="PoolTemplate" x:DataType="models:DrawPoolsModel">
                <Border 
                    Margin="0,2" 
                    Padding="10"
                    Stroke="#EEEEEE" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#EEEEEE"
                >
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="*">
                        <Grid Grid.Column="0" Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor1.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente match précédent" 
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor1.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>

                        <Label 
                            Grid.Column="1" 
                            Grid.Row="1" 
                            Text="VS" 
                            HorizontalOptions="Center" 
                            TextColor="DarkGray" 
                            FontAttributes="Bold" 
                            Margin="0,5"
                        />

                        <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor2.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor2.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente match précédent" 
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor2.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="OrderTemplate" x:DataType="models:DrawOrderModel">
                <Border 
                    Margin="0,2" 
                    Padding="10" 
                    Stroke="#EEEEEE" 
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#EEEEEE"
                >
                    <Grid ColumnDefinitions="*">
                        <Grid Grid.Column="0" ColumnDefinitions="Auto, *">
                            <Image 
                                Grid.Column="0" 
                                Source="{Binding Competitor.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                WidthRequest="24" 
                                HeightRequest="16" 
                                VerticalOptions="Start" 
                                Margin="0,2,8,0"
                                IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}"
                            />
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5" IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}">
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor.LastName}" 
                                        FontAttributes="Bold"
                                    />
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor.FirstName}" 
                                        FontAttributes="Bold"
                                    />
                                </HorizontalStackLayout>
                                <Label 
                                    Text="En attente" 
                                    IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                    FontAttributes="Italic" 
                                    TextColor="Gray" 
                                    FontSize="14"
                                />

                                <controls:ScrollingText
                                    Text="{Binding Competitor.Club}" 
                                    Style="{StaticResource CompetitorInfoLabelStyle}"
                                    IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}"
                                />
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>

            <DataTemplate x:Key="HeaderTemplate" x:DataType="x:String">
                <Border
                    Padding="10,10,10,10" 
                    Stroke="White"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#333"
                >
                    <Label 
                        Text="{Binding .}" 
                        TextColor="White"
                        FontAttributes="Bold" 
                        FontSize="14"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                    />
                </Border>
            </DataTemplate>

            <selectors:DrawTemplateSelector x:Key="DrawTemplateSelector"
                                            KnockoutTemplate="{StaticResource KnockoutTemplate}"
                                            PoolTemplate="{StaticResource PoolTemplate}"
                                            OrderTemplate="{StaticResource OrderTemplate}"
                                            HeaderTemplate="{StaticResource HeaderTemplate}"/>
        </ResourceDictionary>
    </base:BasePage.Resources>

    <Grid x:Name="RootGrid">
        <Grid 
            ColumnDefinitions="{OnIdiom Tablet='300,*', Phone='*'}" 
            ColumnSpacing="15" 
            Margin="{OnIdiom Tablet='10,5,10,10', Phone='5,0,5,0'}"
        >
            <Grid 
                Grid.Column="0"
                RowDefinitions="Auto,*" 
                RowSpacing="10"
                IsVisible="{OnIdiom Tablet='true', Phone='false'}"
            >
                <HorizontalStackLayout Grid.Row="0" Spacing="10" VerticalOptions="Center">
                    <Border
                        StrokeShape="RoundRectangle 50"
                        HeightRequest="50"
                        WidthRequest="50"
                        BackgroundColor="{StaticResource ValidColor}"
                        Stroke="{StaticResource ValidColor}"
                    >
                        <Label 
                            Text="≡" 
                            VerticalOptions="Center" 
                            HorizontalOptions="Center" 
                            FontSize="30" 
                            TextColor="{StaticResource PrimaryTextColor}" 
                            FontAttributes="Bold"
                        />

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSideSheetCommand}"/>
                        </Border.GestureRecognizers>
                    </Border>
                </HorizontalStackLayout>

                <CollectionView 
                    Grid.Row="1"
                    ItemsSource="{Binding Draws}"
                    ItemTemplate="{StaticResource DrawTemplateSelector}"
                >
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="5" />
                    </CollectionView.ItemsLayout>
                </CollectionView>
            </Grid>

            <Grid 
                Grid.Column="1" 
                RowDefinitions="{OnIdiom Tablet='60,105,*,115', Phone='60,*,40,40,40,40,40,150'}" 
                RowSpacing="15" 
                ColumnDefinitions="{OnIdiom Tablet='85,80,*,80,85', Phone='*'}"
            >
                <!-- CATEGORIE -->
                <Border 
                    Grid.Row="0"
                    Grid.ColumnSpan="5" 
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="0,0,0,0"
                    Padding="15,5,15,5"
                    BackgroundColor="#333"
                    Stroke="White"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 15"
                    IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}}"
                >
                    <controls:ScrollingText 
                        Text="{Binding CurrentDraw.Draw.Category.Name}"
                        TextColor="White" 
                        FontSize="32" 
                        FontAttributes="Bold"
                    />
                </Border>

                <!-- JUGE 1 -->
                <Grid
                    Grid.Row="{OnIdiom Tablet='1', Phone='2'}" 
                    Grid.ColumnSpan="{OnIdiom Tablet='2', Phone='0'}"
                    ColumnDefinitions="{OnIdiom Tablet='*', Phone='*, 20, 20, 20, 170'}"
                    ColumnSpacing="10"
                    IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}}"
                >
                    <VerticalStackLayout 
                        VerticalOptions="Start"
                        HorizontalOptions="Start"
                        Spacing="5"
                        IsVisible="{OnIdiom Tablet='true', Phone='false'}"
                    >
                        <Border 
                            Background="LightGray"
                            WidthRequest="100"
                            HeightRequest="60"
                            StrokeShape="RoundRectangle 5"
                        >
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Judges[0].IsConnected}" Value="True">
                                    <Setter Property="Background" Value="Green" />
                                    <Setter Property="Stroke" Value="Lime" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                <Label 
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Judges[0].Name}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    TextColor="Black"
                                    FontSize="18"
                                />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Judges[0].RedPoints}"
                                    FontSize="18"
                                    TextColor="Red"
                                    HorizontalOptions="Center"
                                />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Judges[0].BluePoints}"
                                    TextColor="Blue"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[0]}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Grid 
                            ColumnDefinitions="*,*,*,*" 
                            ColumnSpacing="5" 
                            IsVisible="True"
                        >
                            <Border
                                Grid.Column="0"
                                StrokeShape="RoundRectangle 50"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="DarkRed"
                                Stroke="DarkRed"
                            >
                                <Label Text="-1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RemoveRedPointCommand}" CommandParameter="{Binding Judges[0]}"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border
                                Grid.Column="1"
                                StrokeShape="RoundRectangle 50"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="Red"
                                Stroke="Red"
                            >
                                <Label Text="+1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddRedPointCommand}" CommandParameter="{Binding Judges[0]}"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border
                                Grid.Column="2"
                                StrokeShape="RoundRectangle 50"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="DarkBlue"
                                Stroke="DarkBlue"
                            >
                                <Label Text="-1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RemoveBluePointCommand}" CommandParameter="{Binding Judges[0]}"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border
                                Grid.Column="3"
                                StrokeShape="RoundRectangle 50"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="Blue"
                                Stroke="Blue"
                            >
                                <Label Text="+1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddBluePointCommand}" CommandParameter="{Binding Judges[0]}"/>
                                </Border.GestureRecognizers>
                            </Border>

                            <Grid.Triggers>
                                <DataTrigger TargetType="Grid" Binding="{Binding CurrentDraw.Type, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" Value="True">
                                    <Setter Property="IsVisible" Value="False"/>
                                </DataTrigger>
                            </Grid.Triggers>
                        </Grid>
                    </VerticalStackLayout>

                    <Border 
                        Grid.Column="0"
                        Background="LightGray"
                        WidthRequest="100"
                        HeightRequest="30"
                        StrokeShape="RoundRectangle 5"
                        IsVisible="{OnIdiom Tablet='false', Phone='true'}"
                        HorizontalOptions="Start"
                        VerticalOptions="Center"
                    >
                        <Label 
                            Text="{Binding Judges[0].Name}"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            TextColor="Black"
                            FontSize="18"
                        />
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding Judges[0].IsConnected}" Value="True">
                                <Setter Property="Background" Value="Green" />
                                <Setter Property="Stroke" Value="Lime" />
                                <Setter Property="StrokeThickness" Value="2" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[0]}" />
                        </Border.GestureRecognizers>
                    </Border>

                    <Grid
                        Grid.Column="1"
                    >
                        <Label
                            Text="{Binding Judges[0].RedPoints}"
                            FontSize="18"
                            TextColor="Red"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Style="{StaticResource JudgePointsLabelStyle}"
                            IsVisible="{OnIdiom Tablet='false', Phone='true'}"
                        />
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding CurrentDraw.Type, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" Value="True">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Grid.Triggers>
                    </Grid>

                    <Grid
                        Grid.Column="2"
                    >
                        <Label
                            Text="{Binding Judges[0].BluePoints}"
                            TextColor="Blue"
                            FontSize="18"
                            HorizontalOptions="Start"
                            VerticalOptions="Center"
                            Style="{StaticResource JudgePointsLabelStyle}"
                            IsVisible="{OnIdiom Tablet='false', Phone='true'}"
                        />
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding CurrentDraw.Type, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" Value="True">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Grid.Triggers>
                    </Grid>

                    <Grid
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        IsVisible="False"
                    >
                        <Label 
                            Text="{Binding Judges[0].Score}"
                            FontSize="18"
                            VerticalOptions="Center"
                            TextColor="Green"
                            FontAttributes="Bold"
                        />
                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding CurrentDraw.Type, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" Value="True">
                                <Setter Property="IsVisible" Value="{OnIdiom Tablet='false', Phone='true'}"/>
                            </DataTrigger>
                        </Grid.Triggers>
                    </Grid>
                    
                    <Grid 
                        Grid.Column="4"
                        ColumnDefinitions="*,*,*,*" 
                        ColumnSpacing="5" 
                        IsVisible="{OnIdiom Tablet='false', Phone='true'}"
                    >
                        <Border
                            Grid.Column="0"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="DarkRed"
                            Stroke="DarkRed"
                        >
                            <Label Text="-1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RemoveRedPointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            Grid.Column="1"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="Red"
                            Stroke="Red"
                        >
                            <Label Text="+1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddRedPointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            Grid.Column="2"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="DarkBlue"
                            Stroke="DarkBlue"
                        >
                            <Label Text="-1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RemoveBluePointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>
                        <Border
                            Grid.Column="3"
                            StrokeShape="RoundRectangle 50"
                            HeightRequest="40"
                            WidthRequest="40"
                            BackgroundColor="Blue"
                            Stroke="Blue"
                        >
                            <Label Text="+1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding AddBluePointCommand}" CommandParameter="{Binding Judges[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding CurrentDraw.Type, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" Value="True">
                                <Setter Property="IsVisible" Value="False"/>
                            </DataTrigger>
                        </Grid.Triggers>
                    </Grid>
                </Grid>

                <!-- JUGE 2 -->
                <Grid
                    Grid.Row="{OnIdiom Tablet='1', Phone='3'}" 
                    Grid.ColumnSpan="{OnIdiom Tablet='2', Phone='0'}"
                    Grid.Column="{OnIdiom Tablet='3', Phone='0'}"
                    ColumnDefinitions="{OnIdiom Tablet='*', Phone='*, 20, 20, 20, 170'}"
                    ColumnSpacing="10"
                    IsVisible="{Binding CurrentDraw, Converter={StaticResource EmptyToBoolConverter}}"
                >
                    <VerticalStackLayout
                        VerticalOptions="Start"
                        HorizontalOptions="End"
                        Spacing="5"
                        IsVisible="{OnIdiom Tablet='true', Phone='false'}"
                    >
                        <Border
                            Background="LightGray"
                            WidthRequest="100"
                            HeightRequest="60"
                            StrokeShape="RoundRectangle 5"
                        >
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Judges[1].IsConnected}" Value="True">
                                    <Setter Property="Background" Value="Green" />
                                    <Setter Property="Stroke" Value="Lime" />
                                    <Setter Property="StrokeThickness" Value="2" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
                                <Label 
                                    Grid.Row="0"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding Judges[1].Name}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    TextColor="Black"
                                    FontSize="18"
                                />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="0"
                                    Text="{Binding Judges[1].RedPoints}"
                                    FontSize="18"
                                    TextColor="Red"
                                    HorizontalOptions="Center"
                                />

                                <Label
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    Text="{Binding Judges[1].BluePoints}"
                                    TextColor="Blue"
                                    FontSize="18"
                                    HorizontalOptions="Center"
                                />
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenJudgePopupCommand}" CommandParameter="{Binding Judges[1]}" />
                            </Border.GestureRecognizers>
                        </Border>

                        <Grid 
                            ColumnDefinitions="*,*,*,*" 
                            ColumnSpacing="2">
                            <Border
                                Grid.Column="0"
                                StrokeShape="RoundRectangle 50"
                                HeightRequest="40"
                                WidthRequest="40"
                                BackgroundColor="DarkRed"
                                Stroke="DarkRed"
                            >
                                <Label Text="-1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="12" TextColor="White" FontAttributes="Bold"/>

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding RemoveRedPointCommand}" CommandParameter="{Binding Judges[1]}"/>
                                </Border.GestureRecognizers>
                            </Border>
                            <Border
                                Grid.Column="1"
                                StrokeShape="RoundRectangle 50"
                                HeightRequest="40"
