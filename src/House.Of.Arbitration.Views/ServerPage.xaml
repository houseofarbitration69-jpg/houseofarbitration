<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    xmlns:selectors="clr-namespace:House.Of.Arbitration.Views.Selectors;assembly=House.Of.Arbitration.Views"
    x:TypeArguments="vm:ServerViewModel"
    x:Class="House.Of.Arbitration.Views.ServerPage"
    x:DataType="vm:ServerViewModel"
    x:Name="this"
    Title="{Binding Title}"
    >
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IsoCodeToFlagPathConverter x:Key="IsoCodeToFlagPathConverter" />
            
            <Style x:Key="CompetitorInfoLabelStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor" Value="Gray"/>
            </Style>

            <DataTemplate x:Key="KnockoutTemplate" x:DataType="models:DrawKnockoutModel">
                <Frame Margin="0,2" Padding="10" BorderColor="#EEEEEE" CornerRadius="8" HasShadow="False">
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *">
                        <Label Text="MATCH" Grid.RowSpan="3" VerticalOptions="Center" HorizontalOptions="Center"
                               FontAttributes="Bold" TextColor="Red" Rotation="-90" WidthRequest="60"/>
                        
                        <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                   WidthRequest="24" HeightRequest="16" VerticalOptions="Start" Margin="0,2,8,0"/>
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Competitor1.FirstName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Competitor1.LastName}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Competitor1.Club}" Style="{StaticResource CompetitorInfoLabelStyle}"/>
                                    <Label Text="{Binding Competitor1.Country.Name}" Style="{StaticResource CompetitorInfoLabelStyle}" FontAttributes="Italic"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Grid.Column="1" Grid.Row="1" Text="VS" HorizontalOptions="Center" 
                               TextColor="#DDDDDD" FontAttributes="Bold" Margin="0,5"/>

                        <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                   WidthRequest="24" HeightRequest="16" VerticalOptions="Start" Margin="0,2,8,0"/>
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Competitor2.FirstName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Competitor2.LastName}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Competitor2.Club}" Style="{StaticResource CompetitorInfoLabelStyle}"/>
                                    <Label Text="{Binding Competitor2.Country.Name}" Style="{StaticResource CompetitorInfoLabelStyle}" FontAttributes="Italic"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Frame>
            </DataTemplate>

            <DataTemplate x:Key="PoolTemplate" x:DataType="models:DrawPoolsModel">
                <Frame Margin="0,2" Padding="10" BorderColor="#EEEEEE" CornerRadius="8" HasShadow="False">
                    <Grid RowDefinitions="Auto, Auto, Auto" ColumnDefinitions="Auto, *">
                        <Label Text="POOL" Grid.RowSpan="3" VerticalOptions="Center" HorizontalOptions="Center"
                               FontAttributes="Bold" TextColor="Blue" Rotation="-90" WidthRequest="60"/>

                        <Grid Grid.Column="1" Grid.Row="0" ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                   WidthRequest="24" HeightRequest="16" VerticalOptions="Start" Margin="0,2,8,0"/>
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Competitor1.FirstName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Competitor1.LastName}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Competitor1.Club}" Style="{StaticResource CompetitorInfoLabelStyle}"/>
                                    <Label Text="{Binding Competitor1.Country.Name}" Style="{StaticResource CompetitorInfoLabelStyle}" FontAttributes="Italic"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <Label Grid.Column="1" Grid.Row="1" Text="VS" HorizontalOptions="Center" 
                               TextColor="#DDDDDD" FontAttributes="Bold" Margin="0,5"/>

                        <Grid Grid.Column="1" Grid.Row="2" ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                   WidthRequest="24" HeightRequest="16" VerticalOptions="Start" Margin="0,2,8,0"/>
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Competitor2.FirstName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Competitor2.LastName}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Competitor2.Club}" Style="{StaticResource CompetitorInfoLabelStyle}"/>
                                    <Label Text="{Binding Competitor2.Country.Name}" Style="{StaticResource CompetitorInfoLabelStyle}" FontAttributes="Italic"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Frame>
            </DataTemplate>

            <DataTemplate x:Key="OrderTemplate" x:DataType="models:DrawOrderModel">
                <Frame Margin="0,2" Padding="10" BorderColor="#EEEEEE" CornerRadius="8" HasShadow="False">
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Text="ORDER" VerticalOptions="Center" HorizontalOptions="Center"
                               FontAttributes="Bold" TextColor="Green" Rotation="-90" WidthRequest="60"/>

                        <Grid Grid.Column="1" ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="{Binding Competitor.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                   WidthRequest="24" HeightRequest="16" VerticalOptions="Start" Margin="0,2,8,0"/>
                            <VerticalStackLayout Grid.Column="1">
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Competitor.FirstName}" FontAttributes="Bold"/>
                                    <Label Text="{Binding Competitor.LastName}" FontAttributes="Bold"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="5">
                                    <Label Text="{Binding Competitor.Club}" Style="{StaticResource CompetitorInfoLabelStyle}"/>
                                    <Label Text="{Binding Competitor.Country.Name}" Style="{StaticResource CompetitorInfoLabelStyle}" FontAttributes="Italic"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Grid>
                </Frame>
            </DataTemplate>

            <DataTemplate x:Key="HeaderTemplate" x:DataType="x:String">
                <Label Text="{Binding .}" 
                       BackgroundColor="#F5F5F5" 
                       TextColor="#333333"
                       FontAttributes="Bold" 
                       Padding="10,8"
                       FontSize="14"
                       Margin="0,10,0,5"/>
            </DataTemplate>

            <selectors:DrawTemplateSelector x:Key="DrawTemplateSelector"
                                            KnockoutTemplate="{StaticResource KnockoutTemplate}"
                                            PoolTemplate="{StaticResource PoolTemplate}"
                                            OrderTemplate="{StaticResource OrderTemplate}"
                                            HeaderTemplate="{StaticResource HeaderTemplate}"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid ColumnDefinitions="300,*" ColumnSpacing="15" Margin="10">
        <CollectionView ItemsSource="{Binding Draws}"
                        ItemTemplate="{StaticResource DrawTemplateSelector}">
        </CollectionView>

        <Grid Grid.Column="1" RowDefinitions="85,*,85" ColumnDefinitions="85,*,85">
            <BoxView 
                Grid.Row="0" 
                Grid.Column="0" 
                Background="LightGray"
                WidthRequest="80"
                HeightRequest="40"
                Rotation="-45"
            />

            <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="10" HorizontalOptions="Center">
                <BoxView 
                    Grid.Column="0"
                    Background="LightGray"
                    WidthRequest="80"
                    HeightRequest="40"
                    VerticalOptions="Start"
                />
                <BoxView 
                    Grid.Column="1"
                    Background="LightGray"
                    WidthRequest="80"
                    HeightRequest="40"
                    VerticalOptions="Start"
                />
                <BoxView 
                    Grid.Column="2"
                    Background="LightGray"
                    WidthRequest="80"
                    HeightRequest="40"
                    VerticalOptions="Start"
                />
                <BoxView 
                    Grid.Column="3"
                    Background="LightGray"
                    WidthRequest="80"
                    HeightRequest="40"
                    VerticalOptions="Start"
                />
            </HorizontalStackLayout>

            <BoxView 
                Grid.Row="0" 
                Grid.Column="2" 
                Background="LightGray"
                WidthRequest="80"
                HeightRequest="40"
                Rotation="45"
            />

            <Grid 
                Grid.Row="1" 
                Grid.Column="1" 
                RowDefinitions="Auto,*,Auto" 
                ColumnDefinitions="*,*"
            >
                <BoxView 
                    Grid.RowSpan="3"
                    Grid.Column="0" 
                    Background="Red"
                />

                <BoxView 
                    Grid.RowSpan="3"
                    Grid.Column="1" 
                    Background="Blue"
                />

                <Label Text="CATEGORIES" Grid.Row="0" Grid.ColumnSpan="2" HorizontalOptions="Center"/>

                <Label Text="CHRONO" Grid.Row="2" Grid.ColumnSpan="2" HorizontalOptions="Center"/>
            </Grid>

            <BoxView 
                Grid.Row="2" 
                Grid.Column="0" 
                Background="LightGray"
                WidthRequest="80"
                HeightRequest="40"
                Rotation="45"
            />

            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,*">
                <BoxView 
                    Grid.Column="1"
                    Background="LightGray"
                    WidthRequest="80"
                    HeightRequest="40"
                    VerticalOptions="End"
                />
            </Grid>

            <BoxView 
                Grid.Row="2" 
                Grid.Column="2" 
                Background="LightGray"
                WidthRequest="80"
                HeightRequest="40"
                Rotation="-45"
            />
        </Grid>
    </Grid>
</base:BasePage>
