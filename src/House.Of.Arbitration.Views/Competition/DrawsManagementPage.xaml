<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels.Competition;assembly=House.Of.Arbitration.ViewModels"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    xmlns:selectors="clr-namespace:House.Of.Arbitration.Views.Selectors;assembly=House.Of.Arbitration.Views"
    x:TypeArguments="vm:DrawsManagementViewModel"
    x:Class="House.Of.Arbitration.Views.Competition.DrawsManagementPage"
    x:DataType="vm:DrawsManagementViewModel"
    BackgroundColor="{DynamicResource PageBackgroundColor}"
    Shell.PresentationMode="ModalAnimated">

    <base:BasePage.Resources>
        <ResourceDictionary>
            <!-- Category Header Banner Template -->
            <DataTemplate x:Key="CategoryHeaderTemplate" x:DataType="vm:DrawCategoryHeaderItem">
                <Border 
                    Margin="0, 16, 0, 6" 
                    Padding="14, 10" 
                    BackgroundColor="#222222"
                    Stroke="White"
                    StrokeThickness="2">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="8"/>
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="Auto, *">
                        <Label 
                            Grid.Column="0" 
                            Text="🥋" 
                            FontSize="22" 
                            VerticalOptions="Center" 
                            Margin="0,0,12,0" 
                        />
                        <Label 
                            Grid.Column="1" 
                            VerticalOptions="Center"
                            Text="{Binding CategoryName}" 
                            TextColor="White" 
                            FontSize="16" 
                            FontAttributes="Bold" 
                        />
                        <!--<VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label 
                                Text="{Binding CategoryName}" 
                                TextColor="White" 
                                FontSize="16" 
                                FontAttributes="Bold" 
                            />
                            <Label 
                                Text="{Binding Details}" 
                                TextColor="#AAAAAA" 
                                FontSize="12"
                                IsVisible="{Binding Details, Converter={StaticResource StringToBoolConverter}}" 
                            />
                        </VerticalStackLayout>-->
                        <!--<Border 
                            Grid.Column="2" 
                            BackgroundColor="#333333" 
                            Stroke="White" 
                            StrokeThickness="1" 
                            Padding="8, 4" 
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="6"/>
                            </Border.StrokeShape>
                            <Label 
                                Text="Catégorie" 
                                TextColor="White" 
                                FontSize="11" 
                                FontAttributes="Bold" 
                            />
                        </Border>-->
                    </Grid>
                </Border>
            </DataTemplate>

            <!-- Match Card Template -->
            <DataTemplate x:Key="MatchTemplate" x:DataType="vm:DrawMatchItemViewModel">
                <Border 
                    Margin="0, 3" 
                    Padding="10, 8" 
                    BackgroundColor="#1E1E1E"
                    Stroke="#383838"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8">
                    <Grid ColumnDefinitions="50, *" ColumnSpacing="12">
                        <!-- Order Controls (Left) -->
                        <Grid Grid.Column="0" RowDefinitions="28, 34, 28" RowSpacing="3" VerticalOptions="Center" HorizontalOptions="Center">
                            <!-- Move Up Button -->
                            <Border 
                                Grid.Row="0"
                                BackgroundColor="#2D2D2D" 
                                Stroke="#555555" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 6"
                                HeightRequest="28" 
                                WidthRequest="46"
                                Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding MoveUpCommand}" />
                                </Border.GestureRecognizers>
                                <Label 
                                    Text="▲" 
                                    TextColor="{DynamicResource Primary}" 
                                    FontSize="13" 
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center" 
                                    HorizontalTextAlignment="Center" 
                                    VerticalTextAlignment="Center"
                                />
                            </Border>

                            <!-- Global Order Number Badge / Button (Click to edit order via popup) -->
                            <Border 
                                Grid.Row="1" 
                                BackgroundColor="{DynamicResource Primary}" 
                                Stroke="{DynamicResource PrimaryDark}" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 6"
                                HeightRequest="34" 
                                WidthRequest="46"
                                Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding EditOrderCommand}" />
                                </Border.GestureRecognizers>
                                <Label 
                                    Text="{Binding GlobalOrder}" 
                                    TextColor="White" 
                                    FontSize="15" 
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center" 
                                    HorizontalTextAlignment="Center" 
                                    VerticalTextAlignment="Center"
                                />
                            </Border>

                            <!-- Move Down Button -->
                            <Border 
                                Grid.Row="2"
                                BackgroundColor="#2D2D2D" 
                                Stroke="#555555" 
                                StrokeThickness="1" 
                                StrokeShape="RoundRectangle 6"
                                HeightRequest="28" 
                                WidthRequest="46"
                                Padding="0">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding MoveDownCommand}" />
                                </Border.GestureRecognizers>
                                <Label 
                                    Text="▼" 
                                    TextColor="{DynamicResource Primary}" 
                                    FontSize="13" 
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center" 
                                    VerticalOptions="Center" 
                                    HorizontalTextAlignment="Center" 
                                    VerticalTextAlignment="Center"
                                />
                            </Border>
                        </Grid>

                        <!-- Match Content (Center) -->
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="4">
                            <!-- Match Subtitle & Category info -->
                            <HorizontalStackLayout Spacing="8">
                                <Border BackgroundColor="#333333" Padding="6, 2" StrokeShape="RoundRectangle 4">
                                    <Label Text="{Binding MatchTitle}" TextColor="White" FontSize="11" FontAttributes="Bold"/>
                                </Border>
                                <Label Text="{Binding CategoryName}" TextColor="#AAAAAA" FontSize="11" VerticalOptions="Center"/>
                            </HorizontalStackLayout>

                            <!-- Duel View (Knockouts / Pools) -->
                            <Grid IsVisible="{Binding IsDuel}" ColumnDefinitions="*, Auto, *" ColumnSpacing="8" VerticalOptions="Center">
                                <!-- Red Slot / Competitor 1 -->
                                <Border Grid.Column="0" BackgroundColor="#262626" Stroke="#D32F2F" StrokeThickness="1.5" StrokeShape="RoundRectangle 6" Padding="8, 6">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                        <Image 
                                            Grid.Column="0" 
                                            Source="{Binding Competitor1.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                            WidthRequest="22" 
                                            HeightRequest="15" 
                                            VerticalOptions="Center" 
                                            IsVisible="{Binding Competitor1, Converter={StaticResource EmptyToBoolConverter}}" 
                                        />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                            <Label 
                                                Text="{Binding Competitor1.Name, FallbackValue='(BYE / En attente)'}" 
                                                TextColor="White" 
                                                FontAttributes="Bold" 
                                                FontSize="12" 
                                                LineBreakMode="TailTruncation"
                                            />
                                            <Label 
                                                Text="{Binding Competitor1.Club}" 
                                                TextColor="#999999" 
                                                FontSize="11"
                                                LineBreakMode="TailTruncation"
                                                IsVisible="{Binding Competitor1.Club, Converter={StaticResource StringToBoolConverter}}" 
                                            />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                                <!-- VS Badge -->
                                <Label 
                                    Grid.Column="1" 
                                    Text="VS" 
                                    TextColor="{DynamicResource Secondary}" 
                                    FontAttributes="Bold" 
                                    FontSize="12" 
                                    VerticalOptions="Center" 
                                    HorizontalOptions="Center" 
                                />

                                <!-- Blue Slot / Competitor 2 -->
                                <Border Grid.Column="2" BackgroundColor="#262626" Stroke="#1976D2" StrokeThickness="1.5" StrokeShape="RoundRectangle 6" Padding="8, 6">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                        <Image 
                                            Grid.Column="0" 
                                            Source="{Binding Competitor2.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                            WidthRequest="22" 
                                            HeightRequest="15" 
                                            VerticalOptions="Center" 
                                            IsVisible="{Binding Competitor2, Converter={StaticResource EmptyToBoolConverter}}" 
                                        />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                            <Label 
                                                Text="{Binding Competitor2.Name, FallbackValue='(BYE / En attente)'}" 
                                                TextColor="White" 
                                                FontAttributes="Bold" 
                                                FontSize="12" 
                                                LineBreakMode="TailTruncation"
                                            />
                                            <Label 
                                                Text="{Binding Competitor2.Club}" 
                                                TextColor="#999999" 
                                                FontSize="11"
                                                LineBreakMode="TailTruncation"
                                                IsVisible="{Binding Competitor2.Club, Converter={StaticResource StringToBoolConverter}}" 
                                            />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Single View (Taolu / Order) -->
                            <Grid IsVisible="{Binding IsSingle}" ColumnDefinitions="*" VerticalOptions="Center">
                                <Border BackgroundColor="#262626" Stroke="{DynamicResource Secondary}" StrokeThickness="1.5" StrokeShape="RoundRectangle 6" Padding="8, 6">
                                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                        <Image 
                                            Grid.Column="0" 
                                            Source="{Binding Competitor.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                            WidthRequest="22" 
                                            HeightRequest="15" 
                                            VerticalOptions="Center" 
                                            IsVisible="{Binding Competitor, Converter={StaticResource EmptyToBoolConverter}}" 
                                        />
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                                            <Label 
                                                Text="{Binding Competitor.Name, FallbackValue='(En attente)'}" 
                                                TextColor="White" 
                                                FontAttributes="Bold" 
                                                FontSize="12" 
                                                LineBreakMode="TailTruncation"
                                            />
                                            <Label 
                                                Text="{Binding Competitor.Club}" 
                                                TextColor="#999999" 
                                                FontSize="11"
                                                LineBreakMode="TailTruncation"
                                                IsVisible="{Binding Competitor.Club, Converter={StaticResource StringToBoolConverter}}" 
                                            />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Grid>
                </Border>
            </DataTemplate>

            <selectors:DrawsManagementTemplateSelector 
                x:Key="DrawsManagementTemplateSelector"
                HeaderTemplate="{StaticResource CategoryHeaderTemplate}"
                MatchTemplate="{StaticResource MatchTemplate}" 
            />
        </ResourceDictionary>
    </base:BasePage.Resources>

    <Grid 
        RowDefinitions="Auto, *, Auto" 
        Padding="20" 
        RowSpacing="15"
    >
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="2">
                <Label 
                    Text="{Binding Competition.Name}" 
                    TextColor="{DynamicResource PageTitleColor}"
                    FontSize="26" 
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                />
                <Label 
                    Text="GESTION DES TIRAGES &amp; ORDRE DES PASSAGES"
                    FontSize="13"
                    TextColor="White"
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                    HorizontalOptions="Start"
                />
            </VerticalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                <Border BackgroundColor="#262626" Stroke="#444444" StrokeThickness="1" Padding="12, 8">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="🥊" FontSize="14" VerticalOptions="Center"/>
                        <Label Text="{Binding TotalMatchesCount, StringFormat='{0} rencontres'}" TextColor="White" FontSize="13" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- Main Matches & Headers List -->
        <Grid Grid.Row="1">
            <CollectionView 
                x:Name="MatchesCollectionView"
                ItemsSource="{Binding DisplayItems}"
                ItemTemplate="{StaticResource DrawsManagementTemplateSelector}"
                IsVisible="{Binding HasMatches}"
            />

            <!-- Empty State View -->
            <VerticalStackLayout 
                IsVisible="{Binding HasMatches, Converter={StaticResource InvertBoolConverter}}"
                HorizontalOptions="Center" 
                VerticalOptions="Center" 
                Spacing="12">
                <Label Text="🥋" FontSize="48" HorizontalOptions="Center" Opacity="0.5" />
                <Label Text="Aucune rencontre ou catégorie configurée pour cette compétition." TextColor="Gray" FontSize="14" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Loading Indicator Overlay during operations / reordering -->
            <Border 
                IsVisible="{Binding IsBusy}" 
                BackgroundColor="#80000000" 
                StrokeThickness="0"
                HorizontalOptions="Fill" 
                VerticalOptions="Fill"
                InputTransparent="False">
                <Border 
                    BackgroundColor="#1E1E1E" 
                    Stroke="{DynamicResource Primary}" 
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 16"
                    Padding="24, 20" 
                    HorizontalOptions="Center" 
                    VerticalOptions="Center">
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                        <ActivityIndicator IsRunning="True" Color="{DynamicResource Primary}" WidthRequest="44" HeightRequest="44"/>
                        <Label Text="Mise à jour de l'ordre..." TextColor="White" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>
            </Border>
        </Grid>

        <!-- Bottom Actions & Direct Order Navigation Bar -->
        <Grid 
            Grid.Row="2" 
            ColumnDefinitions="Auto, *, Auto, Auto" 
            ColumnSpacing="14" 
            VerticalOptions="Center"
            IsVisible="{OnIdiom Tablet='true', Phone='false'}"
        >
            <!-- Direct Order Navigation Button (Left) -->
            <Border 
                Grid.Column="0" 
                BackgroundColor="#222222" 
                Stroke="#3E3E3E" 
                StrokeThickness="1" 
                StrokeShape="RoundRectangle 10" 
                Padding="6, 4" 
                VerticalOptions="Center"
                IsVisible="{Binding HasMatches}">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Button 
                        Text="🔍 Aller au passage..." 
                        Command="{Binding ScrollToOrderCommand}" 
                        BackgroundColor="#333333" 
                        TextColor="White" 
                        FontSize="13" 
                        FontAttributes="Bold" 
                        HeightRequest="42" 
                        Padding="14, 0" 
                        CornerRadius="8"
                    />
                    <Button 
                        Text="⏮ Début (1)" 
                        Command="{Binding ScrollToTargetOrderCommand}" 
                        CommandParameter="1" 
                        BackgroundColor="#2A2A2A" 
                        BorderColor="#444444" 
                        BorderWidth="1"
                        TextColor="LightGray" 
                        FontSize="11" 
                        HeightRequest="36" 
                        Padding="10, 0" 
                        CornerRadius="6"
                    />
                    <Button 
                        Text="Dernier ⏭" 
                        Command="{Binding ScrollToTargetOrderCommand}" 
                        CommandParameter="{Binding TotalMatchesCount}" 
                        BackgroundColor="#2A2A2A" 
                        BorderColor="#444444" 
                        BorderWidth="1"
                        TextColor="LightGray" 
                        FontSize="11" 
                        HeightRequest="36" 
                        Padding="10, 0" 
                        CornerRadius="6"
                    />
                </HorizontalStackLayout>
            </Border>

            <!-- Spacer -->
            <Grid Grid.Column="1" />

            <!-- Close Action Button -->
            <Button 
                Grid.Column="2" 
                Text="{Binding Resources.CLOSE_ACTION}" 
                BackgroundColor="{DynamicResource ErrorColor}"
                TextColor="Black"
                FontAttributes="Bold"
                Command="{Binding CloseCommand}" 
                WidthRequest="160"
                HeightRequest="46"
                CornerRadius="10"
                Padding="0"
            />

            <!-- Validate Action Button -->
            <Button 
                Grid.Column="3" 
                Text="{Binding Resources.VALIDATE_ACTION}" 
                BackgroundColor="{DynamicResource ValidColor}"
                TextColor="Black"
                FontAttributes="Bold"
                Command="{Binding SaveCommand}" 
                WidthRequest="160"
                HeightRequest="46"
                CornerRadius="10"
                Padding="0"
            />
        </Grid>

        <VerticalStackLayout
            Grid.Row="2" 
            IsVisible="{OnIdiom Tablet='false', Phone='true'}"
            Spacing="10"
        >
            <Border 
                Grid.Column="0" 
                BackgroundColor="#222222" 
                Stroke="#3E3E3E" 
                StrokeThickness="1" 
                StrokeShape="RoundRectangle 10" 
                Padding="6, 4" 
                VerticalOptions="Center"
                IsVisible="{Binding HasMatches}">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Button 
                        Text="🔍 Aller au passage..." 
                        Command="{Binding ScrollToOrderCommand}" 
                        BackgroundColor="#333333" 
                        TextColor="White" 
                        FontSize="13" 
                        FontAttributes="Bold" 
                        HeightRequest="42" 
                        Padding="14, 0" 
                        CornerRadius="8"
                    />
                    <Button 
                        Text="⏮ Début (1)" 
                        Command="{Binding ScrollToTargetOrderCommand}" 
                        CommandParameter="1" 
                        BackgroundColor="#2A2A2A" 
                        BorderColor="#444444" 
                        BorderWidth="1"
                        TextColor="LightGray" 
                        FontSize="11" 
                        HeightRequest="36" 
                        Padding="10, 0" 
                        CornerRadius="6"
                    />
                    <Button 
                        Text="Dernier ⏭" 
                        Command="{Binding ScrollToTargetOrderCommand}" 
                        CommandParameter="{Binding TotalMatchesCount}" 
                        BackgroundColor="#2A2A2A" 
                        BorderColor="#444444" 
                        BorderWidth="1"
                        TextColor="LightGray" 
                        FontSize="11" 
                        HeightRequest="36" 
                        Padding="10, 0" 
                        CornerRadius="6"
                    />
                </HorizontalStackLayout>
            </Border>

            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="10"
            >
                <Button 
                Grid.Column="0" 
                Text="{Binding Resources.CLOSE_ACTION}" 
                BackgroundColor="{DynamicResource ErrorColor}"
                TextColor="Black"
                FontAttributes="Bold"
                Command="{Binding CloseCommand}" 
                WidthRequest="160"
                HeightRequest="46"
                CornerRadius="10"
                Padding="0"
            />

                <Button 
                Grid.Column="1" 
                Text="{Binding Resources.VALIDATE_ACTION}" 
                BackgroundColor="{DynamicResource ValidColor}"
                TextColor="Black"
                FontAttributes="Bold"
                Command="{Binding SaveCommand}" 
                WidthRequest="160"
                HeightRequest="46"
                CornerRadius="10"
                Padding="0"
            />
            </Grid>
        </VerticalStackLayout>
    </Grid>

</base:BasePage>
