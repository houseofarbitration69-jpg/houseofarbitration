<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    x:TypeArguments="vm:JudgeViewModel"
    x:Class="House.Of.Arbitration.Views.JudgePage"
    x:DataType="vm:JudgeViewModel"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="False">

    <base:BasePage.Resources>
        <ResourceDictionary>
            <converters:SignalToColorConverter x:Key="SignalToColorConverter" />
            <mct:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNullOrEmptyConverter x:Key="IsNullOrEmptyConverter" />
            <mct:IsNullConverter x:Key="IsNullConverter" />
            <mct:IsNotNullConverter x:Key="IsNotNullConverter" />

            <Style x:Key="MainCompetitorNameStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="36"/>
                <Setter Property="CharacterSpacing" Value="2"/>
            </Style>

            <Style x:Key="MainCompetitorClubStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>

            <Style x:Key="MainCompetitorCountryStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Opacity" Value="0.8"/>
                <Setter Property="FontAttributes" Value="Italic"/>
            </Style>
        </ResourceDictionary>
    </base:BasePage.Resources>

    <Grid RowDefinitions="Auto, *" Padding="20">
        <Label Text="{Binding Resources.JUDGE}" FontSize="32" FontAttributes="Bold" HorizontalOptions="Center" TextColor="White" Margin="0,0,0,20"/>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <!-- 1. Connection (Not Connected) -->
            <VerticalStackLayout Spacing="15" IsVisible="{Binding IsConnected, Converter={StaticResource InvertedBoolConverter}}" HorizontalOptions="Center">
                <Label Text="CONNEXION AU SERVEUR" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="White"/>
                
                <Button Text="SCANNER LES SERVEURS" Command="{Binding StartScanCommand}" 
                        BackgroundColor="{DynamicResource ValidColor}" TextColor="White" HorizontalOptions="Center" WidthRequest="250"/>
                
                <ActivityIndicator IsRunning="{Binding IsScanning}" Color="White" HorizontalOptions="Center"/>
                
                <Label Text="Appareils trouvés :" TextColor="White" IsVisible="{Binding DiscoveredDevices.Count, Converter={mct:IntToBoolConverter}}"/>
                
                <CollectionView ItemsSource="{Binding DiscoveredDevices}" HeightRequest="200" Margin="0,10">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DiscoveredDeviceModel">
                            <Border Stroke="White" StrokeThickness="1" BackgroundColor="#444444" Margin="5" Padding="10">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0">
                                        <Label Text="{Binding DisplayName}" TextColor="White" FontSize="18" FontAttributes="Bold"/>
                                        <Label Text="{Binding DeviceId}" TextColor="LightGray" FontSize="12"/>
                                    </VerticalStackLayout>
                                    
                                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                        <!-- Visual Signal Bars -->
                                        <Grid ColumnDefinitions="4,4,4,4" ColumnSpacing="2" HeightRequest="20" VerticalOptions="End" Margin="0,0,5,0">
                                            <BoxView Grid.Column="0" HeightRequest="5" WidthRequest="4" VerticalOptions="End" 
                                                     Color="{Binding Rssi, Converter={StaticResource SignalToColorConverter}, ConverterParameter=1}"/>
                                            <BoxView Grid.Column="1" HeightRequest="10" WidthRequest="4" VerticalOptions="End" 
                                                     Color="{Binding Rssi, Converter={StaticResource SignalToColorConverter}, ConverterParameter=2}"/>
                                            <BoxView Grid.Column="2" HeightRequest="15" WidthRequest="4" VerticalOptions="End" 
                                                     Color="{Binding Rssi, Converter={StaticResource SignalToColorConverter}, ConverterParameter=3}"/>
                                            <BoxView Grid.Column="3" HeightRequest="20" WidthRequest="4" VerticalOptions="End" 
                                                     Color="{Binding Rssi, Converter={StaticResource SignalToColorConverter}, ConverterParameter=4}"/>
                                        </Grid>
                                        <Label Text="{Binding Rssi, StringFormat='{0} dBm'}" TextColor="Gray" FontSize="12" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JudgeViewModel}}, Path=ConnectCommand}" 
                                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- 2. Connected Content -->
            <VerticalStackLayout Spacing="20" IsVisible="{Binding IsConnected}">
                <!-- A. Position Selection (Connected but no judge selected) -->
                <VerticalStackLayout Spacing="20" IsVisible="{Binding SelectedJudge, Converter={StaticResource IsNullConverter}}" HorizontalOptions="Center">
                    <Label Text="SÉLECTIONNEZ VOTRE POSITION" HorizontalOptions="Center" FontSize="20" FontAttributes="Bold" TextColor="White"/>

                    <Grid RowDefinitions="45,200,45" ColumnDefinitions="40,40,200,40,40" RowSpacing="5">
                        <!-- JUGE 1 -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Background="LightGray"
                            WidthRequest="80"
                            HeightRequest="45"
                            StrokeShape="RoundRectangle 5"
                        >
                            <Label Text="Juge" VerticalOptions="Center" HorizontalOptions="Center"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPositionCommand}" CommandParameter="{Binding JudgePositions[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- JUGE 2 -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            Background="LightGray"
                            WidthRequest="80"
                            HeightRequest="45"
                            StrokeShape="RoundRectangle 5"
                        >
                            <Label Text="Juge" VerticalOptions="Center" HorizontalOptions="Center"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPositionCommand}" CommandParameter="{Binding JudgePositions[1]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- JUGE 5 -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="2"
                            Background="LightGray"
                            WidthRequest="80"
                            HeightRequest="45"
                            StrokeShape="RoundRectangle 5"
                            HorizontalOptions="Center"
                        >
                            <Label Text="Juge" VerticalOptions="Center" HorizontalOptions="Center"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPositionCommand}" CommandParameter="{Binding JudgePositions[4]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- MATCH -->
                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Grid.ColumnSpan="3"
                            Background="LightGray"
                            StrokeShape="RoundRectangle 5"
                        >
                            <Label Text="Ring" VerticalOptions="Center" HorizontalOptions="Center"/>
                        </Border>

                        <!-- JUGE 3 -->
                        <Border
                            Grid.Row="2"
                            Grid.Column="3"
                            Grid.ColumnSpan="2"
                            Background="LightGray"
                            WidthRequest="80"
                            HeightRequest="45"
                            StrokeShape="RoundRectangle 5"
                            HorizontalOptions="Center"
                        >
                            <Label Text="Juge" VerticalOptions="Center" HorizontalOptions="Center"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPositionCommand}" CommandParameter="{Binding JudgePositions[2]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- JUGE 4 -->
                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Background="LightGray"
                            WidthRequest="80"
                            HeightRequest="45"
                            StrokeShape="RoundRectangle 5"
                            HorizontalOptions="Center"
                        >
                            <Label Text="Juge" VerticalOptions="Center" HorizontalOptions="Center"/>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPositionCommand}" CommandParameter="{Binding JudgePositions[3]}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- B. Match Info (Connected and judge selected) -->
                <VerticalStackLayout Spacing="20" IsVisible="{Binding SelectedJudge, Converter={StaticResource IsNotNullConverter}}">
                    <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                        <BoxView Color="{DynamicResource ValidColor}" WidthRequest="15" HeightRequest="15" CornerRadius="7.5" VerticalOptions="Center"/>
                        <Label Text="CONNECTÉ AU SERVEUR" TextColor="{DynamicResource ValidColor}" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                    
                    <Border Stroke="White" StrokeThickness="2" Padding="20" BackgroundColor="#222222" Margin="0,20">
                        <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                            <Label Text="{Binding CategoryName}" FontSize="20" FontAttributes="Bold" TextColor="Gray" HorizontalOptions="Center"/>
                            
                            <VerticalStackLayout IsVisible="{Binding CurrentMatchInfo, Converter={StaticResource IsNullOrEmptyConverter}}">
                                <Label Text="EN ATTENTE DU PROCHAIN MATCH..." TextColor="Yellow" HorizontalOptions="Center"/>
                                <ActivityIndicator IsRunning="True" Color="Yellow" Margin="0,10"/>
                            </VerticalStackLayout>

                            <!-- Match Display (Simulated like ServerPage) -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="50" IsVisible="{Binding CurrentMatchInfo, Converter={StaticResource IsNullOrEmptyConverter}, ConverterParameter='Invert'}">
                                <!-- Red Side -->
                                <VerticalStackLayout Grid.Column="0" Spacing="10">
                                    <Label Text="COMPÉTITEUR ROUGE" Style="{StaticResource MainCompetitorNameStyle}" FontSize="24" TextColor="Red"/>
                                    <Label Text="{Binding RedName}" Style="{StaticResource MainCompetitorNameStyle}" FontSize="28" />
                                    <!--<Label Text="Jean" Style="{StaticResource MainCompetitorNameStyle}" FontSize="32" Margin="0,-5,0,0" />-->
                                    <Label Text="Club Kung Fu" Style="{StaticResource MainCompetitorClubStyle}" FontSize="18" />
                                </VerticalStackLayout>

                                <!-- Blue Side -->
                                <VerticalStackLayout Grid.Column="1" Spacing="10">
                                    <Label Text="COMPÉTITEUR BLEU" Style="{StaticResource MainCompetitorNameStyle}" FontSize="24" TextColor="Blue"/>
                                    <Label Text="{Binding BlueName}" Style="{StaticResource MainCompetitorNameStyle}" FontSize="28" />
                                    <!--<Label Text="Marc" Style="{StaticResource MainCompetitorNameStyle}" FontSize="32" Margin="0,-5,0,0" />-->
                                    <Label Text="Elite Sanda" Style="{StaticResource MainCompetitorClubStyle}" FontSize="18" />
                                </VerticalStackLayout>
                            </Grid>
                            
                            <!-- Detailed Info -->
                            <Label Text="{Binding CurrentMatchInfo}" FontSize="20" TextColor="LightGray" HorizontalOptions="Center" HorizontalTextAlignment="Center" IsVisible="{Binding CurrentMatchInfo, Converter={StaticResource IsNullOrEmptyConverter}, ConverterParameter='Invert'}"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Grid>
    </Grid>
</base:BasePage>