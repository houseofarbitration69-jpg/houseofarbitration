<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    x:TypeArguments="vm:JudgeViewModel"
    x:Class="House.Of.Arbitration.Views.JudgePage"
    x:DataType="vm:JudgeViewModel"
    Title="{Binding Title}"
    Shell.NavBarIsVisible="False">

    <base:BasePage.Resources>
        <ResourceDictionary>
            <converters:SignalToColorConverter x:Key="SignalToColorConverter" />
            <mct:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:IsNullOrEmptyConverter x:Key="IsNullOrEmptyConverter" />
            <mct:IsNullConverter x:Key="IsNullConverter" />
            <mct:IsNotNullConverter x:Key="IsNotNullConverter" />

            <Style x:Key="MainCompetitorNameStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="36"/>
                <Setter Property="CharacterSpacing" Value="2"/>
            </Style>

            <Style x:Key="MainCompetitorClubStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="24"/>
                <Setter Property="Opacity" Value="0.9"/>
            </Style>

            <Style x:Key="MainCompetitorCountryStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="HorizontalOptions" Value="Center"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="Opacity" Value="0.8"/>
                <Setter Property="FontAttributes" Value="Italic"/>
            </Style>
        </ResourceDictionary>
    </base:BasePage.Resources>

    <Grid Padding="20">
        <!-- Main Content -->
        <Grid>
            <!-- 1. Connection (Not Connected) -->
            <VerticalStackLayout Spacing="15" IsVisible="{Binding IsConnected, Converter={StaticResource InvertedBoolConverter}}" VerticalOptions="Center" HorizontalOptions="Center">
                <Label Text="CONNEXION AU SERVEUR" HorizontalOptions="Center" FontSize="32" FontAttributes="Bold" TextColor="White" Margin="0,0,0,20"/>

                <Button Text="SCANNER LES SERVEURS" Command="{Binding StartScanCommand}" 
                        BackgroundColor="{DynamicResource ValidColor}" TextColor="Black" FontAttributes="Bold" CornerRadius="20" HeightRequest="60" WidthRequest="300"/>

                <ActivityIndicator IsRunning="{Binding IsScanning}" Color="White" HorizontalOptions="Center" Margin="0,20"/>

                <Label Text="Serveur trouvés :" TextColor="White" FontSize="18" IsVisible="{Binding DiscoveredDevices.Count, Converter={mct:IntToBoolConverter}}"/>

                <CollectionView ItemsSource="{Binding DiscoveredDevices}" HeightRequest="300" WidthRequest="500" Margin="0,10">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:DiscoveredDeviceModel">
                            <Border Stroke="White" StrokeThickness="1" BackgroundColor="#444444" Margin="5" Padding="15">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="10"/>
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayName}" TextColor="White" FontSize="22" FontAttributes="Bold"/>
                                        <Label Text="{Binding DeviceId}" TextColor="LightGray" FontSize="14"/>
                                    </VerticalStackLayout>

                                    <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                        <!-- Visual Signal Bars -->
                                        <Grid ColumnDefinitions="6,6,6,6" ColumnSpacing="3" HeightRequest="30" VerticalOptions="End">
                                            <BoxView Grid.Column="0" HeightRequest="8" WidthRequest="6" VerticalOptions="End" 
                                                     Color="{Binding Rssi, Converter={StaticResource SignalToColorConverter}, ConverterParameter=1}"/>
                                            <BoxView Grid.Column="1" HeightRequest="15" WidthRequest="6" VerticalOptions="End" 
                                                     Color="{Binding Rssi, Converter={StaticResource SignalToColorConverter}, ConverterParameter=2}"/>
                                            <BoxView Grid.Column="2" HeightRequest="22" WidthRequest="6" VerticalOptions="End" 
                                                     Color="{Binding Rssi, Converter={StaticResource SignalToColorConverter}, ConverterParameter=3}"/>
                                            <BoxView Grid.Column="3" HeightRequest="30" WidthRequest="6" VerticalOptions="End" 
                                                     Color="{Binding Rssi, Converter={StaticResource SignalToColorConverter}, ConverterParameter=4}"/>
                                        </Grid>
                                        <Label Text="{Binding Rssi, StringFormat='{0} dBm'}" TextColor="Gray" FontSize="14" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </Grid>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:JudgeViewModel}}, Path=ConnectCommand}" 
                                        CommandParameter="{Binding .}"
                                    />
                                </Border.GestureRecognizers>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>

            <!-- 2. Connected Content -->
            <Grid IsVisible="{Binding IsConnected}">
                <!-- A. Position Selection (Connected but no judge selected) -->
                <VerticalStackLayout Spacing="30" IsVisible="{Binding SelectedJudge, Converter={StaticResource IsNullConverter}}" VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="SÉLECTIONNEZ VOTRE POSITION" HorizontalOptions="Center" FontSize="32" FontAttributes="Bold" TextColor="White"/>

                    <Grid RowDefinitions="80,300,80" ColumnDefinitions="100,100,300,100,100" RowSpacing="10" ColumnSpacing="10">
                        <!-- JUGE 1 -->
                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="LightGray" WidthRequest="150" HeightRequest="80" StrokeShape="RoundRectangle 10">
                            <Label Text="JUGE 1" VerticalOptions="Center" HorizontalOptions="Center" FontSize="24" FontAttributes="Bold" TextColor="Black"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPositionCommand}" CommandParameter="{Binding JudgePositions[0]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- JUGE 2 -->
                        <Border Grid.Row="0" Grid.Column="3" Grid.ColumnSpan="2" Background="LightGray" WidthRequest="150" HeightRequest="80" StrokeShape="RoundRectangle 10">
                            <Label Text="JUGE 2" VerticalOptions="Center" HorizontalOptions="Center" FontSize="24" FontAttributes="Bold" TextColor="Black"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPositionCommand}" CommandParameter="{Binding JudgePositions[1]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- JUGE 5 -->
                        <Border Grid.Row="0" Grid.Column="2" Background="LightGray" WidthRequest="150" HeightRequest="80" StrokeShape="RoundRectangle 10" HorizontalOptions="Center">
                            <Label Text="JUGE 5" VerticalOptions="Center" HorizontalOptions="Center" FontSize="24" FontAttributes="Bold" TextColor="Black"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPositionCommand}" CommandParameter="{Binding JudgePositions[4]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- RING -->
                        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Background="#333" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 15">
                            <Label Text="RING" VerticalOptions="Center" HorizontalOptions="Center" FontSize="48" FontAttributes="Bold" TextColor="White"/>
                        </Border>

                        <!-- JUGE 3 -->
                        <Border Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2" Background="LightGray" WidthRequest="150" HeightRequest="80" StrokeShape="RoundRectangle 10">
                            <Label Text="JUGE 3" VerticalOptions="Center" HorizontalOptions="Center" FontSize="24" FontAttributes="Bold" TextColor="Black"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPositionCommand}" CommandParameter="{Binding JudgePositions[2]}"/>
                            </Border.GestureRecognizers>
                        </Border>

                        <!-- JUGE 4 -->
                        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="LightGray" WidthRequest="150" HeightRequest="80" StrokeShape="RoundRectangle 10">
                            <Label Text="JUGE 4" VerticalOptions="Center" HorizontalOptions="Center" FontSize="24" FontAttributes="Bold" TextColor="Black"/>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectPositionCommand}" CommandParameter="{Binding JudgePositions[3]}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </Grid>
                </VerticalStackLayout>

                <!-- B. Match Info & Timer (Connected and judge selected) -->
                <Grid IsVisible="{Binding SelectedJudge, Converter={StaticResource IsNotNullConverter}}" RowDefinitions="Auto, *, Auto" RowSpacing="20">
                    <!-- Category Name Header -->
                    <Border Grid.Row="0" HorizontalOptions="Center" Padding="30,10" BackgroundColor="#333" Stroke="White" StrokeThickness="2" StrokeShape="RoundRectangle 15">
                        <Label Text="{Binding CategoryName, FallbackValue='EN ATTENTE DE COMPÉTITION'}" TextColor="White" FontSize="36" FontAttributes="Bold"/>
                    </Border>

                    <!-- Main Match Display (The Ring) -->
                    <Grid Grid.Row="1">
                        <!-- Empty State -->
                        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20" IsVisible="{Binding CurrentMatchInfo, Converter={StaticResource IsNullOrEmptyConverter}}">
                            <Label Text="EN ATTENTE DU PROCHAIN MATCH..." TextColor="Yellow" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <ActivityIndicator IsRunning="True" Color="Yellow" WidthRequest="100" HeightRequest="100"/>
                        </VerticalStackLayout>

                        <!-- Active Match -->
                        <Grid IsVisible="{Binding CurrentMatchInfo, Converter={StaticResource IsNullOrEmptyConverter}, ConverterParameter='Invert'}">
                            <!-- Background Colors -->
                            <Grid ColumnDefinitions="*,*">
                                <Border Grid.Column="0" Background="Red" StrokeThickness="0" Opacity="0.8" StrokeShape="RoundRectangle 15,0,15,0"/>
                                <Border Grid.Column="1" Background="Blue" StrokeThickness="0" Opacity="0.8" StrokeShape="RoundRectangle 0,15,0,15"/>
                            </Grid>

                            <!-- Competitor Names -->
                            <Grid ColumnDefinitions="*,*">
                                <!-- Red Side -->
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                                    <Label Text="ROUGE" FontSize="24" FontAttributes="Bold" TextColor="White" Opacity="0.7" HorizontalOptions="Center"/>
                                    <Label Text="{Binding RedName}" Style="{StaticResource MainCompetitorNameStyle}" FontSize="48"/>
                                </VerticalStackLayout>

                                <!-- Blue Side -->
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" HorizontalOptions="Center" Spacing="10">
                                    <Label Text="BLEU" FontSize="24" FontAttributes="Bold" TextColor="White" Opacity="0.7" HorizontalOptions="Center"/>
                                    <Label Text="{Binding BlueName}" Style="{StaticResource MainCompetitorNameStyle}" FontSize="48"/>
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Timer Overlay -->
                            <Border HorizontalOptions="Center" VerticalOptions="Center" Padding="25,10" BackgroundColor="#333" Stroke="White" StrokeThickness="3" StrokeShape="RoundRectangle 20">
                                <Label Text="{Binding TimeLeftDisplay}" TextColor="White" FontSize="72" FontAttributes="Bold" FontFamily="Monospace"/>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Footer Info (Judge Position & Connection Status) -->
                    <HorizontalStackLayout Grid.Row="2" HorizontalOptions="Center" Spacing="30">
                        <HorizontalStackLayout Spacing="10">
                            <BoxView Color="{DynamicResource ValidColor}" WidthRequest="20" HeightRequest="20" CornerRadius="10" VerticalOptions="Center"/>
                            <Label Text="SERVEUR CONNECTÉ" TextColor="{DynamicResource ValidColor}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        
                        <Label Text="{Binding SelectedJudge.Name, StringFormat='POSITION : {0}'}" TextColor="White" FontSize="24" FontAttributes="Bold" VerticalOptions="Center"/>
                    </HorizontalStackLayout>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</base:BasePage>
