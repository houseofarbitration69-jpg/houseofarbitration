<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels.Wizard.Competition.Steps;assembly=House.Of.Arbitration.ViewModels"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    x:Class="House.Of.Arbitration.Views.Wizard.Competition.Steps.CategoriesStepView"
    x:DataType="vm:CategoriesStepViewModel"
    x:Name="this"
    Shell.NavBarIsVisible="False">

    <ContentView.Resources>
        <converters:CategoryToNameConverter x:Key="CategoryToNameConverter" />
    </ContentView.Resources>

    <Grid>
        <!-- Background/Main Content -->
        <ScrollView>
            <VerticalStackLayout Spacing="24" Padding="20">
                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto">
                    <Label 
                        Grid.Column="0"
                        Text="{Binding Resources.CATEGORY_LIST}" 
                        Style="{DynamicResource Headline}" 
                        TextColor="{DynamicResource Valid}"
                        FontSize="32" 
                        VerticalOptions="Center"
                        HorizontalOptions="Start"
                    />

                    <controls:IconButton 
                        Grid.Column="1"
                        Text="{Binding Resources.ADD_CATEGORY}"
                        ButtonBackgroundColor="LightGreen"
                        TextColor="Black"
                        Command="{Binding AddCategoryCommand}"
                        VerticalOptions="Center"
                    >
                        <controls:IconButton.Icons>
                            <controls:IconInfo Icon="{x:Static helpers:FontCustomIcons.ADD}" Color="Black" FontSize="16" />
                            <controls:IconInfo Icon="{x:Static helpers:FontCustomIcons.CIRCLE}" Color="Black" FontSize="24" />
                        </controls:IconButton.Icons>
                    </controls:IconButton>
                </Grid>

                <!-- Categories List -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="15">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryModel">
                            <controls:Card CardPadding="15" CardColor="White">
                                <Grid RowDefinitions="Auto,*" ColumnDefinitions="*,Auto">
                                    <Label 
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Text="{Binding ., Converter={StaticResource CategoryToNameConverter}}" 
                                        TextColor="Black"
                                        VerticalOptions="Center"
                                    />

                                    <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8">
                                        <controls:IconButton
                                            IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                                            Icon="{x:Static helpers:FontCustomIcons.PEN}"
                                            ButtonBackgroundColor="LightBlue"
                                            IconColor="Black"
                                            Command="{Binding x:DataType='vm:CategoriesStepViewModel', Source={RelativeSource AncestorType={x:Type vm:CategoriesStepViewModel}}, Path=EditCategoryCommand}"
                                            CommandParameter="{Binding}"
                                        />
                                        <controls:IconButton
                                            IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                                            Icon="{x:Static helpers:FontCustomIcons.DOGI}"
                                            ButtonBackgroundColor="LightGreen"
                                            IconColor="Black"
                                            Command="{Binding x:DataType='vm:CategoriesStepViewModel', Source={RelativeSource AncestorType={x:Type vm:CategoriesStepViewModel}}, Path=ShowCompetitorsCommand}"
                                            CommandParameter="{Binding}"
                                        />
                                        <controls:IconButton
                                            IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                                            Icon="{x:Static helpers:FontCustomIcons.TRASH}"
                                            ButtonBackgroundColor="Red"
                                            IconColor="White"
                                            Command="{Binding x:DataType='vm:CategoriesStepViewModel', Source={RelativeSource AncestorType={x:Type vm:CategoriesStepViewModel}}, Path=DeleteCategoryCommand}"
                                            CommandParameter="{Binding}"
                                        />
                                    </HorizontalStackLayout>
                                </Grid>
                            </controls:Card>
                            <!--<Border StrokeShape="RoundRectangle {DynamicResource ButtonCornerRadius}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1"
                                    Margin="0,0,0,12"
                                    BackgroundColor="{DynamicResource SurfaceColor}"
                                    Padding="16">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="🥋" FontSize="18" VerticalOptions="Center"/>
                                            <Label Text="{Binding Type}" FontAttributes="Bold" FontSize="18" VerticalOptions="Center"/>
                                            <Label Text="{Binding RoundType, StringFormat='({0})'}" FontSize="12" Opacity="0.6" IsVisible="{Binding RoundType, Converter={StaticResource StringToBoolConverter}}" VerticalOptions="Center"/>
                                        </HorizontalStackLayout>
                                        
                                        <Button Grid.Column="1" 
                                                Text="🗑️"
                                                BackgroundColor="Transparent"
                                                TextColor="{StaticResource MartialRed}"
                                                Command="{Binding x:DataType='vm:CategoriesStepViewModel', Source={RelativeSource AncestorType={x:Type vm:CategoriesStepViewModel}}, Path=RemoveCategoryCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>

                                    <Label Text="Participants :" FontAttributes="Bold" FontSize="12" Opacity="0.8" />
                                    
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Competitors}" Spacing="5">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:CompetitorModel">
                                                <Grid ColumnDefinitions="*, Auto, Auto" Padding="5,0">
                                                    <Label Text="{Binding Name}" VerticalOptions="Center" TextColor="White"/>
                                                    <Button Grid.Column="1" Text="✏️" BackgroundColor="Transparent" FontSize="12"
                                                            Command="{Binding x:DataType='vm:CategoriesStepViewModel', Source={RelativeSource AncestorType={x:Type vm:CategoriesStepViewModel}}, Path=EditCompetitorCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Grid.Column="2" Text="✕" BackgroundColor="Transparent" TextColor="Red"
                                                            Command="{Binding x:DataType='vm:CategoriesStepViewModel', Source={RelativeSource AncestorType={x:Type vm:CategoriesStepViewModel}}, Path=RemoveCompetitorCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Button Text="+ Ajouter un Participant" 
                                            Style="{StaticResource Button}"
                                            HeightRequest="35" FontSize="12" Padding="15,0"
                                            HorizontalOptions="Start"
                                            Command="{Binding x:DataType='vm:CategoriesStepViewModel', Source={RelativeSource AncestorType={x:Type vm:CategoriesStepViewModel}}, Path=AddCompetitorCommand}"
                                            CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </Border>-->
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Popup Ajout Catégorie (RESTORING ALL YOUR PICKERS) -->
        <Grid x:Name="PopupOverlay"
              BackgroundColor="#80000000" 
              IsVisible="False"
              Padding="20">
            
            <Border VerticalOptions="Center"
                    BackgroundColor="{DynamicResource PageBackgroundColor}"
                    StrokeShape="RoundRectangle {DynamicResource ButtonCornerRadius}"
                    Padding="20"
                    MaximumWidthRequest="400">
                <ScrollView>
                    <VerticalStackLayout Spacing="20">
                        <Label Text="Nouvelle Catégorie" Style="{DynamicResource Headline}" FontSize="20" />
                        
                        <!-- Style Picker -->
                        <Border StrokeShape="RoundRectangle {DynamicResource ButtonCornerRadius}" Stroke="{DynamicResource BorderColor}" Padding="10,0" BackgroundColor="{DynamicResource SurfaceColor}">
                            <Picker x:Name="TypePicker" Title="Style" TextColor="{DynamicResource PrimaryTextColor}" />
                        </Border>

                        <!-- Round Picker (Conditional) -->
                        <VerticalStackLayout x:Name="RoundContainer" Spacing="8" IsVisible="False">
                            <Border StrokeShape="RoundRectangle {DynamicResource ButtonCornerRadius}" Stroke="{DynamicResource BorderColor}" Padding="10,0" BackgroundColor="{DynamicResource SurfaceColor}">
                                <Picker x:Name="RoundPicker" Title="Type de round" TextColor="{DynamicResource PrimaryTextColor}" />
                            </Border>
                            <VerticalStackLayout.Triggers>
                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Source={x:Reference TypePicker}, Path=SelectedItem}" Value="{x:Static models:CategoryType.Sanda}">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Source={x:Reference TypePicker}, Path=SelectedItem}" Value="{x:Static models:CategoryType.SandaLight}">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>
                        </VerticalStackLayout>

                        <!-- Weights Entry -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <Grid Grid.Column="0" ColumnDefinitions="Auto, *">
                                <Label Text="⚖️" VerticalOptions="Center" Margin="0,0,5,0" />
                                <Entry Grid.Column="1" x:Name="MinWeightEntry" Placeholder="Min kg" Keyboard="Numeric" BackgroundColor="Transparent" />
                            </Grid>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto, *">
                                <Label Text="⚖️" VerticalOptions="Center" Margin="0,0,5,0" />
                                <Entry Grid.Column="1" x:Name="MaxWeightEntry" Placeholder="Max kg" Keyboard="Numeric" BackgroundColor="Transparent" />
                            </Grid>
                        </Grid>

                        <!-- Genre & Age Pickers -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <Picker x:Name="GenrePicker" Grid.Column="0" Title="Genre" />
                            <Picker x:Name="AgePicker" Grid.Column="1" Title="Âge" />
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                            <Button Text="Annuler" Clicked="OnClosePopupClicked" BackgroundColor="Transparent" TextColor="{DynamicResource PrimaryTextColor}" />
                            <Button Text="Ajouter" Clicked="OnSaveCategoryClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentView>
