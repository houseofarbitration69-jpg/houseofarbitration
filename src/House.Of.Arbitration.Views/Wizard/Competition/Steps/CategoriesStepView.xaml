<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels.Wizard.Competition.Steps;assembly=House.Of.Arbitration.ViewModels"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    x:Class="House.Of.Arbitration.Views.Wizard.Competition.Steps.CategoriesStepView"
    x:DataType="vm:CategoriesStepViewModel"
    x:Name="this">

    <Grid>
        <!-- Background/Main Content -->
        <ScrollView>
            <VerticalStackLayout Spacing="24" Padding="20">
                <!-- Header Section -->
                <VerticalStackLayout Spacing="4">
                    <Label Text="Gestion des Catégories" 
                           Style="{DynamicResource Headline}" 
                           HorizontalOptions="Start"
                           FontSize="24" />
                    <Label Text="Définissez les catégories et leurs participants" 
                           Style="{DynamicResource SubHeadline}" 
                           HorizontalOptions="Start"
                           FontSize="14" 
                           Opacity="0.7" />
                </VerticalStackLayout>

                <!-- Add Button -->
                <Button Text="+ Ajouter une Catégorie"
                        Style="{StaticResource Button}"
                        Margin="0,10"
                        Clicked="OnAddCategoryClicked" />

                <!-- Categories List -->
                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Categories}" Spacing="12">
                    <!--<VerticalStackLayout.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Margin="0,40" Spacing="10">
                            <Label Text="📭" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="Aucune catégorie ajoutée" FontAttributes="Italic" Opacity="0.6" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </VerticalStackLayout.EmptyView>-->
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryModel">
                            <Border StrokeShape="RoundRectangle {DynamicResource ButtonCornerRadius}"
                                    Stroke="{DynamicResource BorderColor}"
                                    StrokeThickness="1"
                                    Margin="0,0,0,12"
                                    BackgroundColor="{DynamicResource SurfaceColor}"
                                    Padding="16">
                                <Grid ColumnDefinitions="*, Auto">
                                    <VerticalStackLayout Spacing="8">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="🥋" />
                                            <Label Text="{Binding Type}" FontAttributes="Bold" />
                                            <Label Text="{Binding RoundType, StringFormat='({0})'}" FontSize="12" Opacity="0.6" IsVisible="{Binding RoundType, Converter={StaticResource StringToBoolConverter}}" />
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding Competitors.Count, StringFormat='👥 {0} participants inscrits'}" FontSize="12" TextColor="{DynamicResource MartialGray}" />

                                        <Button Text="Gérer les Participants" 
                                                FontSize="12" 
                                                HeightRequest="32" 
                                                Padding="12,0" 
                                                HorizontalOptions="Start"
                                                BackgroundColor="Transparent"
                                                TextColor="{DynamicResource Primary}"
                                                BorderColor="{DynamicResource Primary}"
                                                BorderWidth="1"
                                                Command="{Binding x:DataType='vm:CategoriesStepViewModel', Source={RelativeSource AncestorType={x:Type vm:CategoriesStepViewModel}}, Path=ManageCompetitorsCommand}"
                                                CommandParameter="{Binding}" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1" 
                                            Text="🗑️"
                                            BackgroundColor="Transparent"
                                            TextColor="{StaticResource MartialRed}"
                                            Command="{Binding x:DataType='vm:CategoriesStepViewModel', Source={RelativeSource AncestorType={x:Type vm:CategoriesStepViewModel}}, Path=RemoveCategoryCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Category Addition Popup (RESTORING YOUR LOGIC) -->
        <Grid x:Name="PopupOverlay"
              BackgroundColor="#80000000" 
              IsVisible="False"
              Padding="20">

            <Border VerticalOptions="Center"
                    BackgroundColor="{DynamicResource PageBackgroundColor}"
                    StrokeShape="RoundRectangle {DynamicResource ButtonCornerRadius}"
                    Padding="20"
                    MaximumWidthRequest="400">
                <ScrollView>
                    <VerticalStackLayout Spacing="20">
                        <Label Text="Nouvelle Catégorie" Style="{DynamicResource Headline}" FontSize="20" />

                        <!-- Style Picker -->
                        <!--<VerticalStackLayout Spacing="8">
                            <Label Text="Style" FontAttributes="Bold" FontSize="14" />-->
                        <Border StrokeShape="RoundRectangle {DynamicResource ButtonCornerRadius}" Stroke="{DynamicResource BorderColor}" Padding="10,0" BackgroundColor="{DynamicResource SurfaceColor}">
                            <Picker x:Name="TypePicker" Title="Style" TextColor="{DynamicResource PrimaryTextColor}" />
                        </Border>
                        <!--</VerticalStackLayout>-->

                        <!-- YOUR RESTORED ROUND PICKER LOGIC -->
                        <VerticalStackLayout x:Name="RoundContainer" Spacing="8" IsVisible="False">
                            <!--<Label Text="Type de Round" FontAttributes="Bold" FontSize="14" />-->
                            <Border StrokeShape="RoundRectangle {DynamicResource ButtonCornerRadius}" Stroke="{DynamicResource BorderColor}" Padding="10,0" BackgroundColor="{DynamicResource SurfaceColor}">
                                <Picker x:Name="RoundPicker" Title="Type de round" TextColor="{DynamicResource PrimaryTextColor}" />
                            </Border>
                            <VerticalStackLayout.Triggers>
                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Source={x:Reference TypePicker}, Path=SelectedItem}" Value="{x:Static models:CategoryType.Sanda}">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                                <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Source={x:Reference TypePicker}, Path=SelectedItem}" Value="{x:Static models:CategoryType.SandaLight}">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </VerticalStackLayout.Triggers>
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <Grid Grid.Column="0" ColumnDefinitions="Auto, *">
                                <Label Text="🏆" VerticalOptions="Center" Margin="0,0,10,0" />
                                <Entry Grid.Column="1"
                                       x:Name="MinWeightEntry"
                               Placeholder="Ex: 75"
                               PlaceholderColor="{DynamicResource SecondaryTextColor}"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                            </Grid>
                            <Grid Grid.Column="1" ColumnDefinitions="Auto, *">
                                <Label Text="🏆" VerticalOptions="Center" Margin="0,0,10,0" />
                                <Entry Grid.Column="1"
                                       x:Name="MaxWeightEntry"
                               Placeholder="Ex: 90"
                               PlaceholderColor="{DynamicResource SecondaryTextColor}"
                               TextColor="{DynamicResource PrimaryTextColor}"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                            </Grid>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <!--<VerticalStackLayout Spacing="8" Grid.Column="0">-->
                            <!--<Label Text="Genre" FontAttributes="Bold" FontSize="14" />-->
                            <Picker x:Name="GenrePicker" Grid.Column="0" Title="Genre" />
                            <!--</VerticalStackLayout>-->
                            <!--<VerticalStackLayout Spacing="8" Grid.Column="1">-->
                            <!--<Label Text="Âge" FontAttributes="Bold" FontSize="14" />-->
                            <Picker x:Name="AgePicker" Grid.Column="1" Title="Âge" />
                            <!--</VerticalStackLayout>-->
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                            <Button Text="Annuler" Clicked="OnClosePopupClicked" BackgroundColor="Transparent" TextColor="{DynamicResource PrimaryTextColor}" />
                            <Button Text="Ajouter" Clicked="OnSaveCategoryClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>

        <!-- Competitors Management Popup -->
        <Grid BackgroundColor="#80000000" IsVisible="{Binding IsCompetitorPopupVisible}" Padding="20">
            <Border VerticalOptions="Center" BackgroundColor="{DynamicResource PageBackgroundColor}" StrokeShape="RoundRectangle {DynamicResource ButtonCornerRadius}" Padding="20" MaximumWidthRequest="500">
                <VerticalStackLayout Spacing="20">
                    <Label Text="{Binding SelectedCategory.Type, StringFormat='Participants - {0}'}" Style="{DynamicResource Headline}" FontSize="20" />

                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                        <Entry x:Name="CompetitorNameEntry" Placeholder="Nom du compétiteur" TextColor="{DynamicResource PrimaryTextColor}" />
                        <Button Grid.Column="1" Text="+" Command="{Binding AddCompetitorCommand}" CommandParameter="{Binding Source={x:Reference CompetitorNameEntry}, Path=Text}" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding CurrentCompetitors}" HeightRequest="200">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:CompetitorModel">
                                <Grid ColumnDefinitions="*, Auto" Padding="10">
                                    <Label Text="{Binding Name}" VerticalOptions="Center" TextColor="{DynamicResource PrimaryTextColor}" />
                                    <Button Grid.Column="1" Text="✕" TextColor="Red" BackgroundColor="Transparent" 
                                            Command="{Binding BindingContext.RemoveCompetitorCommand, Source={x:Reference this}}" 
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Terminer" Command="{Binding SaveCompetitorsCommand}" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentView>
