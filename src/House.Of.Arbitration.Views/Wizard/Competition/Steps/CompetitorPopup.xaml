<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels.Wizard.Competition.Steps;assembly=House.Of.Arbitration.ViewModels"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    x:Class="House.Of.Arbitration.Views.Wizard.Competition.Steps.CompetitorPopup"
    x:DataType="vm:CompetitorPopupViewModel"
    BackgroundColor="Transparent"
    Padding="0"
>
    <ContentView.Resources>
        <converters:GenreToBoolConverter x:Key="GenreToBoolConverter" />
        <converters:BirthDateToBoolConverter x:Key="BirthDateToBoolConverter" />
        <converters:CategoryTypeToBoolConverter x:Key="CategoryTypeToBoolConverter" />
        <converters:BirthdayToOldConverter x:Key="BirthdayToOldConverter"/>
        <converters:IsoCodeToFlagPathConverter x:Key="IsoCodeToFlagPathConverter" />
    </ContentView.Resources>

    <Border 
        x:Name="PopupBorder"
        VerticalOptions="Center"
        BackgroundColor="{DynamicResource PageBackgroundColor}"
        Padding="15"
        MaximumWidthRequest="400"
        WidthRequest="350"
    >
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{DynamicResource ButtonCornerRadius}"/>
        </Border.StrokeShape>
        
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- TITRE -->
            <Label 
                Grid.Row="0"
                Text="{Binding Resources.COMPETITOR}" 
                Style="{DynamicResource Headline}" 
                FontSize="20" 
                TextColor="{DynamicResource ValidColor}"
            />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="15">
                    <!-- NOM -->
                    <VerticalStackLayout Spacing="5">
                        <Label 
                            Text="{Binding Resources.LASTNAME}" 
                            Style="{DynamicResource FormLabelStyle}"
                        />
        
                        <Border 
                            Stroke="{DynamicResource ValidColor}"
                            StrokeThickness="1"
                            BackgroundColor="{DynamicResource White}"
                            Padding="0"
                            Margin="0"
                        >
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding LastName, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                        
                            <Entry 
                                Margin="0"
                                Text="{Binding LastName}" 
                                Placeholder="{Binding Resources.LASTNAME}"
                                PlaceholderColor="{DynamicResource PlaceholderColor}"
                                TextColor="{DynamicResource InverseTextColor}"
                                VerticalOptions="Center" 
                                MinimumHeightRequest="30"
                            />
                        </Border>
                    </VerticalStackLayout>

                    <!-- PRENOM -->
                    <VerticalStackLayout Spacing="5">
                        <Label 
                            Text="{Binding Resources.FIRSTNAME}" 
                            Style="{DynamicResource FormLabelStyle}"
                        />

                        <Border 
                            Stroke="{DynamicResource ValidColor}"
                            StrokeThickness="1"
                            BackgroundColor="{DynamicResource White}"
                            Padding="0"
                            Margin="0"
                        >
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding FirstName, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            
                            <Entry 
                                Margin="0"
                                Text="{Binding FirstName}" 
                                Placeholder="{Binding Resources.FIRSTNAME}"
                                PlaceholderColor="{DynamicResource PlaceholderColor}"
                                TextColor="{DynamicResource InverseTextColor}"
                                VerticalOptions="Center" 
                                MinimumHeightRequest="30"
                            />
                        </Border>
                    </VerticalStackLayout>

                    <!-- GENRE -->
                    <VerticalStackLayout Spacing="5">
                        <Label 
                            Text="{Binding Resources.GENRE}" 
                            Style="{DynamicResource FormLabelStyle}"
                        />

                        <Border 
                            Stroke="{DynamicResource ValidColor}"
                            StrokeThickness="1"
                            BackgroundColor="{DynamicResource EntryBackgroundColor}"
                            MinimumHeightRequest="30"
                            Margin="0"
                            Padding="0"
                        >
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding SelectedGenre.Value, Converter={StaticResource GenreToBoolConverter}, ConverterParameter='Invert'}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            
                            <Picker 
                                ItemsSource="{Binding Genres}"
                                SelectedItem="{Binding SelectedGenre}"
                                ItemDisplayBinding="{Binding DisplayName}"
                                TextColor="{DynamicResource InverseTextColor}"
                                BackgroundColor="{DynamicResource White}"
                                MinimumHeightRequest="30"
                                IsEnabled="{Binding GenreIsEnabled}"
                            />
                        </Border>
                    </VerticalStackLayout>

                    <!-- CLUB / GRADE -->
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label 
                            Text="{Binding Resources.CLUB}" 
                            Style="{DynamicResource FormLabelStyle}"
                        />
                        
                        <Border 
                            Stroke="{DynamicResource ValidColor}"
                            StrokeThickness="1"
                            BackgroundColor="{DynamicResource White}"
                            Padding="0"
                            Margin="0"
                        >
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                            </Border.StrokeShape>
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding Club, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}" Value="True">
                                    <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                                </DataTrigger>
                            </Border.Triggers>
                            
                            <controls:SuggestEntry 
                                Placeholder="{Binding Resources.CLUB_PLACEHOLDER}"
                                PlaceholderColor="{DynamicResource PlaceholderColor}"
                                Text="{Binding Club}"
                                TextColor="{DynamicResource InverseTextColor}"
                                ItemsSource="{Binding Clubs}"
                                Stroke="Transparent"
                                StrokeThickness="0"
                                CornerRadius="10"
                            />
                        </Border>
                    </VerticalStackLayout>

                    <!-- PAYS -->
                    <VerticalStackLayout Spacing="5">
                        <Label 
                            Text="{Binding Resources.COUNTRY}" 
                            Style="{DynamicResource FormLabelStyle}"
                        />
                        
                        <Grid ColumnDefinitions="Auto, *">
                            <Image Grid.Column="0" Source="{Binding CountryName, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                   WidthRequest="32" HeightRequest="24" VerticalOptions="Center" Margin="0,0,10,0">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding CountryName}" Value="">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </Image.Triggers>
                            </Image>
                            
                            <Border 
                                Grid.Column="1"
                                Stroke="{DynamicResource ValidColor}"
                                StrokeThickness="1"
                                BackgroundColor="{DynamicResource White}"
                                Padding="0"
                                Margin="0"
                            >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding CountryName, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}" Value="True">
                                        <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                
                                <controls:SuggestEntry 
                                    Placeholder="{Binding Resources.COUNTRY_PLACEHOLDER}"
                                    PlaceholderColor="{DynamicResource PlaceholderColor}"
                                    Text="{Binding CountryName}"
                                    TextColor="{DynamicResource InverseTextColor}"
                                    ItemsSource="{Binding CountryNames}"
                                    Stroke="Transparent"
                                    StrokeThickness="0"
                                    CornerRadius="10"
                                />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                    <!-- DATE DE NAISSANCE ET POIDS -->
                    <Grid ColumnDefinitions="150,40,*" ColumnSpacing="15">
                        <VerticalStackLayout Grid.Column="0" Spacing="5">
                            <Label 
                                Text="{Binding Resources.BIRTHDATE}" 
                                Style="{DynamicResource FormLabelStyle}"
                            />
                            
                            <Border 
                                Stroke="{DynamicResource ValidColor}"
                                StrokeThickness="1"
                                BackgroundColor="{DynamicResource White}"
                                MinimumHeightRequest="30"
                                WidthRequest="122"
                                Margin="0"
                                Padding="0"
                                HorizontalOptions="Start"
                            >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding BirthDate, Converter={StaticResource BirthDateToBoolConverter}}" Value="False">
                                        <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                
                                <DatePicker 
                                    Date="{Binding BirthDate}" 
                                    Format="dd/MM/yyyy" 
                                    TextColor="{DynamicResource InverseTextColor}"
                                    BackgroundColor="{DynamicResource White}"
                                    MinimumHeightRequest="30"
                                />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" Spacing="5">
                            <Label 
                                Text="{Binding Resources.OLD}" 
                                Style="{DynamicResource FormLabelStyle}"
                            />
                            
                            <Border 
                                Stroke="{DynamicResource ValidColor}"
                                StrokeThickness="1"
                                BackgroundColor="{DynamicResource White}"
                                Margin="0"
                                Padding="0"
                            >
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                                </Border.StrokeShape>
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding BirthDate, Converter={StaticResource BirthDateToBoolConverter}}" Value="False">
                                        <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Entry Margin="0" IsReadOnly="True" MinimumHeightRequest="30">
                                    <Entry.Text>
                                        <MultiBinding Converter="{StaticResource BirthdayToOldConverter}">
                                            <Binding Path="BirthDate"/>
                                            <Binding Path="Category.Competition.Date"/>
                                        </MultiBinding>
                                    </Entry.Text>
                                </Entry>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout Grid.Column="1" Spacing="5" IsVisible="True">
                        <Label 
                            Text="{Binding Resources.WEIGHT}" 
                            Style="{DynamicResource FormLabelStyle}"
                        />
    
                        <Border 
                            Stroke="{DynamicResource ValidColor}"
                            StrokeThickness="1"
                            BackgroundColor="{DynamicResource White}"
                            Padding="0"
                            Margin="0"
                        >
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                            </Border.StrokeShape>
                            
                            <Entry 
                                Margin="0"
                                Text="{Binding Weight}" 
                                TextColor="{DynamicResource InverseTextColor}"
                                Placeholder="{Binding Resources.WEIGHT}"
                                PlaceholderColor="{DynamicResource PlaceholderColor}"
                                VerticalOptions="Center" 
                                MinimumHeightRequest="30"
                            />
                        </Border>
                        <VerticalStackLayout.Triggers>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Category.Type}" Value="{x:Static models:CategoryType.Taolu}">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Category.Type}" Value="{x:Static models:CategoryType.TaoluModerneNord}">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                            <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding Category.Type}" Value="{x:Static models:CategoryType.TaoluModerneSud}">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </VerticalStackLayout.Triggers>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- ACTIONS -->
            <Grid Grid.Row="2" ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,0">
                <controls:IconButton
                    Grid.Column="0" 
                    Text="{Binding Resources.CLOSE_ACTION}"
                    ButtonBackgroundColor="{DynamicResource ErrorColor}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                    Icon="{x:Static helpers:FontCustomIcons.CLOSE}"
                    IconColor="{DynamicResource PrimaryTextColor}"
                    Command="{Binding CloseCommand}"
                />

                <controls:IconButton
                    Grid.Column="1"
                    Text="{Binding Resources.VALIDATE_ACTION}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    ButtonBackgroundColor="{DynamicResource ValidColor}"
                    IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                    Icon="{x:Static helpers:FontCustomIcons.CHECK}"
                    IconColor="{DynamicResource PrimaryTextColor}"
                    Command="{Binding ValidateCommand}"
                />
            </Grid>
        </Grid>
    </Border>
</mct:Popup>
