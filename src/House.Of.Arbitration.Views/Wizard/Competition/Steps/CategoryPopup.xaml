<?xml version="1.0" encoding="utf-8" ?>
<mct:Popup 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels.Wizard.Competition.Steps;assembly=House.Of.Arbitration.ViewModels"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    x:Class="House.Of.Arbitration.Views.Wizard.Competition.Steps.CategoryPopup"
    x:DataType="vm:CategoryPopupViewModel"
    BackgroundColor="Transparent"
    Padding="0"
>
    <ContentView.Resources>
    </ContentView.Resources>

    <Border 
        VerticalOptions="Center"
        BackgroundColor="{DynamicResource PageBackgroundColor}"
        Padding="10"
        MaximumWidthRequest="400"
        WidthRequest="350"
    >
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{DynamicResource ButtonCornerRadius}"/>
        </Border.StrokeShape>
        <VerticalStackLayout Spacing="10">
            <Label 
                Text="{Binding Title}" 
                Style="{DynamicResource Headline}" 
                FontSize="20" 
                TextColor="{DynamicResource ValidColor}"
            />

            <!-- Style -->
            <VerticalStackLayout Spacing="5">
                <Label 
                    Text="{Binding Resources.STYLE}" 
                    FontAttributes="Bold" 
                    FontSize="14" 
                    Margin="4,0" 
                    TextColor="LightGray"
                />
                <Border 
                    Stroke="{DynamicResource ValidColor}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource EntryBackgroundColor}"
                    MinimumHeightRequest="30"
                    Margin="0"
                    Padding="0"
                >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedType.Value, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Invert'}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Picker
                        x:DataType="models:CategoryType"
                        ItemsSource="{Binding CategoryTypes}"
                        SelectedItem="{Binding SelectedType}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        TextColor="Black"
                        BackgroundColor="White"
                        MinimumHeightRequest="30"
                    />
                </Border>
            </VerticalStackLayout>

            <!-- Round (Conditional) -->
            <VerticalStackLayout Spacing="5" IsVisible="False">
                <Label 
                    Text="{Binding Resources.ROUND_TYPE}" 
                    FontAttributes="Bold" 
                    FontSize="14" 
                    Margin="4,0" 
                    TextColor="LightGray"
                />
                <Border 
                    Stroke="{DynamicResource ValidColor}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource EntryBackgroundColor}"
                    MinimumHeightRequest="30"
                    Margin="0"
                    Padding="0"
                >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedRoundType.Value, Converter={StaticResource RoundTypeToBoolConverter}, ConverterParameter='Invert'}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Picker 
                        ItemsSource="{Binding RoundTypes}"
                        SelectedItem="{Binding SelectedRoundType}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        TextColor="Black"
                        BackgroundColor="White"
                        MinimumHeightRequest="30"
                    />
                </Border>
                <VerticalStackLayout.Triggers>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding SelectedType.Value}" Value="{x:Static models:CategoryType.Sanda}">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                    <DataTrigger TargetType="VerticalStackLayout" Binding="{Binding SelectedType.Value}" Value="{x:Static models:CategoryType.SandaLight}">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </VerticalStackLayout.Triggers>
            </VerticalStackLayout>

            <!-- Genre & Age -->
            <VerticalStackLayout Spacing="5">
                <Label 
                    Text="{Binding Resources.GENRE}" 
                    FontAttributes="Bold" 
                    FontSize="14" 
                    Margin="4,0" 
                    TextColor="LightGray"
                />
                <Border 
                    Stroke="{DynamicResource ValidColor}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource EntryBackgroundColor}"
                    MinimumHeightRequest="30"
                    Margin="0"
                    Padding="0"
                >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedGenre.Value, Converter={StaticResource GenreToBoolConverter}, ConverterParameter='Invert'}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Picker 
                        ItemsSource="{Binding Genres}"
                        SelectedItem="{Binding SelectedGenre}"
                        ItemDisplayBinding="{Binding DisplayName}"
                        TextColor="Black"
                        BackgroundColor="White"
                        MinimumHeightRequest="30"
                    />
                </Border>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="5">
                <Label 
                    Text="{Binding Resources.OLD}" 
                    FontAttributes="Bold" 
                    FontSize="14" 
                    Margin="4,0" 
                    TextColor="LightGray"
                />
                <Border 
                    Stroke="{DynamicResource ValidColor}"
                    StrokeThickness="1"
                    BackgroundColor="{DynamicResource EntryBackgroundColor}"
                    MinimumHeightRequest="30"
                    Margin="0"
                    Padding="0"
                >
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                    </Border.StrokeShape>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding SelectedAgeRange, Converter={StaticResource AgeRangeToBoolConverter}, ConverterParameter='Invert'}" Value="True">
                            <Setter Property="Stroke" Value="{DynamicResource ErrorColor}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Picker 
                        ItemsSource="{Binding AgeRanges}"
                        SelectedItem="{Binding SelectedAgeRange}"
                        ItemDisplayBinding="{Binding Label}"
                        TextColor="Black"
                        BackgroundColor="White"
                        MinimumHeightRequest="30"
                    />
                </Border>
            </VerticalStackLayout>

            <!-- Weight Min & Weight Max -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" IsVisible="False">
                <VerticalStackLayout Spacing="5">
                    <Label 
                        Text="{Binding Resources.WEIGHT_MIN}" 
                        FontAttributes="Bold" 
                        FontSize="14" 
                        Margin="4,0" 
                        TextColor="LightGray"
                    />
                    <Border 
                        Stroke="LightGray"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="0"
                        Margin="0"
                    >
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                        </Border.StrokeShape>
                        <Entry 
                            Grid.Column="1"
                            Margin="0"
                            Text="{Binding WeightMin}" 
                            Placeholder="{Binding Resources.WEIGHT_MIN}"
                            PlaceholderColor="Gray"
                            TextColor="Black"
                            VerticalOptions="Center" 
                            MinimumHeightRequest="30"
                        />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label 
                        Text="{Binding Resources.WEIGHT_MAX}" 
                        FontAttributes="Bold" 
                        FontSize="14" 
                        Margin="4,0" 
                        TextColor="LightGray"
                    />
                    <Border 
                        Stroke="LightGray"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="0"
                        Margin="0"
                    >
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{DynamicResource EntryCornerRadius}"/>
                        </Border.StrokeShape>
                        <Entry 
                            Grid.Column="1"
                            Margin="0"
                            Text="{Binding WeightMax}" 
                            Placeholder="{Binding Resources.WEIGHT_MAX}"
                            PlaceholderColor="Gray"
                            TextColor="Black"
                            VerticalOptions="Center" 
                            MinimumHeightRequest="30"
                        />
                    </Border>
                </VerticalStackLayout>
                <Grid.Triggers>
                    <DataTrigger TargetType="Grid" Binding="{Binding SelectedType.Value}" Value="{x:Static models:CategoryType.Sanda}">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                    <DataTrigger TargetType="Grid" Binding="{Binding SelectedType.Value}" Value="{x:Static models:CategoryType.SandaLight}">
                        <Setter Property="IsVisible" Value="True" />
                    </DataTrigger>
                </Grid.Triggers>
            </Grid>

            <!-- Buttons -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                <controls:IconButton
                    Grid.Column="0" 
                    Text="{Binding Resources.CLOSE_ACTION}"
                    ButtonBackgroundColor="{DynamicResource ErrorColor}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                    Icon="{x:Static helpers:FontCustomIcons.CLOSE}"
                    IconColor="{DynamicResource PrimaryTextColor}"
                    Command="{Binding CloseCommand}"
                />

                <controls:IconButton
                    Grid.Column="1"
                    Text="{Binding Resources.VALIDATE_ACTION}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    ButtonBackgroundColor="{DynamicResource ValidColor}"
                    IconFontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}"
                    Icon="{x:Static helpers:FontCustomIcons.CHECK}"
                    IconColor="{DynamicResource PrimaryTextColor}"
                    Command="{Binding ValidateCommand}"
                />
            </Grid>
        </VerticalStackLayout>
    </Border>
</mct:Popup>
