<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels.Wizard.Competition.Steps;assembly=House.Of.Arbitration.ViewModels"
    x:TypeArguments="vm:CompetitorPageViewModel"
    x:Class="House.Of.Arbitration.Views.Wizard.Competition.Steps.CompetitorPage"
>

    <ScrollView BackgroundColor="{DynamicResource PageBackgroundColor}">
        <VerticalStackLayout Spacing="20" Padding="20">
            
            <Label Text="{Binding PageTitle}" Style="{DynamicResource Headline}" FontSize="24" HorizontalOptions="Center" Margin="0,0,0,10" />

            <!-- Identité -->
            <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="{DynamicResource SurfaceColor}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="IDENTITÉ" FontAttributes="Bold" TextColor="{DynamicResource Primary}" FontSize="12" />
                    
                    <Entry Placeholder="Prénom" Text="{Binding Competitor.FirstName}" />
                    <Entry Placeholder="Nom" Text="{Binding Competitor.LastName}" />
                    
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                        <Label Text="Genre" VerticalOptions="Center" />
                        <Picker Grid.Column="1" x:Name="GenrePicker" Title="Sélectionner" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Détails Techniques -->
            <Border StrokeShape="RoundRectangle 10" Padding="15" BackgroundColor="{DynamicResource SurfaceColor}">
                <VerticalStackLayout Spacing="15">
                    <Label Text="INFORMATIONS TECHNIQUES" FontAttributes="Bold" TextColor="{DynamicResource Primary}" FontSize="12" />
                    
                    <Entry Placeholder="Club / École" Text="{Binding Competitor.Club}" />
                    <Entry Placeholder="Grade (ex: 1er Du)" Text="{Binding Competitor.Grade}" />
                    
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="15">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Date de naissance" FontSize="12" Opacity="0.7" />
                            <DatePicker Date="{Binding Competitor.BirthDate}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="Poids Actuel (kg)" FontSize="12" Opacity="0.7" />
                            <Entry Keyboard="Numeric" Text="{Binding Competitor.CurrentWeight}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Actions -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,20">
                <Button Text="Annuler" 
                        Style="{StaticResource Button}" 
                        BackgroundColor="Transparent" 
                        TextColor="{DynamicResource PrimaryTextColor}"
                        BorderColor="{DynamicResource BorderColor}"
                        BorderWidth="1"
                        Command="{Binding CancelCommand}" />
                
                <Button Grid.Column="1" 
                        Text="Enregistrer" 
                        Style="{StaticResource Button}" 
                        Command="{Binding SaveCommand}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</base:BasePage>
