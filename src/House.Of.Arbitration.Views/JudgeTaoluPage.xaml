<?xml version="1.0" encoding="utf-8" ?>
<base:BasePage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:House.Of.Arbitration.Views.Core;assembly=House.Of.Arbitration.Views.Core"
    xmlns:vm="clr-namespace:House.Of.Arbitration.ViewModels;assembly=House.Of.Arbitration.ViewModels"
    xmlns:controls="clr-namespace:House.Of.Arbitration.Controls;assembly=House.Of.Arbitration.Controls"
    xmlns:helpers="clr-namespace:House.Of.Arbitration.Models.Helpers;assembly=House.Of.Arbitration.Models"
    xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:models="clr-namespace:House.Of.Arbitration.Models;assembly=House.Of.Arbitration.Models"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters;assembly=House.Of.Arbitration.Controls"
    xmlns:selectors="clr-namespace:House.Of.Arbitration.Views.Selectors;assembly=House.Of.Arbitration.Views"
    xmlns:behaviors="clr-namespace:House.Of.Arbitration.Views.Behaviors;assembly=House.Of.Arbitration.Views"
    x:TypeArguments="vm:JudgeViewModel"
    x:Class="House.Of.Arbitration.Views.JudgeTaoluPage"
    x:Name="this"
    x:DataType="vm:JudgeViewModel"
    Title="{Binding Title}"
>
    <base:BasePage.Resources>
        <ResourceDictionary>
            <Style x:Key="KeypadButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource ButtonBackgroundColor}" />
                                    <Setter Property="TextColor" Value="{DynamicResource InverseTextColor}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource ValidColor}" />
                                    <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Gray200}" />
                                    <Setter Property="TextColor" Value="{DynamicResource InverseTextColor}" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>

            <Style x:Key="QuickDeductButtonStyle" TargetType="Button">
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="HeightRequest" Value="38" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="VisualStateManager.VisualStateGroups">
                    <VisualStateGroupList>
                        <VisualStateGroup x:Name="CommonStates">
                            <VisualState x:Name="Normal">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource KeypadButtonBg}" />
                                    <Setter Property="TextColor" Value="White" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="Pressed">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource ValidColor}" />
                                    <Setter Property="TextColor" Value="White" />
                                </VisualState.Setters>
                            </VisualState>
                            <VisualState x:Name="PointerOver">
                                <VisualState.Setters>
                                    <Setter Property="BackgroundColor" Value="{DynamicResource Gray200}" />
                                    <Setter Property="TextColor" Value="White" />
                                </VisualState.Setters>
                            </VisualState>
                        </VisualStateGroup>
                    </VisualStateGroupList>
                </Setter>
            </Style>
        </ResourceDictionary>
    </base:BasePage.Resources>

    <Grid Padding="20">
        <Grid 
            IsVisible="{Binding IsReceivingMatch, Converter={StaticResource InvertBoolConverter}}" 
            RowDefinitions="Auto, Auto, *, Auto" 
            RowSpacing="15"
        >
            <!-- Row 0: Offline Status Banner -->
            <Border 
                Grid.Row="0"
                IsVisible="{Binding IsConnected, Converter={StaticResource InvertBoolConverter}}" 
                BackgroundColor="{DynamicResource ErrorBg}" 
                Stroke="{DynamicResource ErrorColor}" 
                StrokeThickness="1.5" 
                Padding="15,10" 
                StrokeShape="RoundRectangle 12"
            >
                <Grid 
                    ColumnDefinitions="Auto, *, Auto" 
                    ColumnSpacing="12"
                >
                    <Label 
                        Grid.Column="0" 
                        Text="⚠️" 
                        FontSize="22" 
                        VerticalOptions="Center"
                    />

                    <VerticalStackLayout 
                        Grid.Column="1" 
                        VerticalOptions="Center" 
                        Spacing="2"
                    >
                        <Label 
                            Text="{Binding Resources.SERVER_OFFLINE}" 
                            TextColor="{StaticResource PrimaryTextColor}" 
                            FontSize="15" 
                            FontAttributes="Bold"
                        />

                        <Label 
                            Text="{Binding OfflineSyncStatusText}" 
                            TextColor="{DynamicResource ErrorLight}" 
                            FontSize="12"
                        />
                    </VerticalStackLayout>

                    <Button 
                        Grid.Column="2" 
                        Text="{Binding ReconnectButtonText}" 
                        Command="{Binding ReconnectCommand}" 
                        IsEnabled="{Binding IsReconnecting, Converter={StaticResource InvertBoolConverter}}"
                        BackgroundColor="{StaticResource PrimaryTextColor}" 
                        TextColor="{DynamicResource ErrorColor}" 
                        FontAttributes="Bold" 
                        HeightRequest="38" 
                        Padding="14,0" 
                        CornerRadius="19"
                    />
                </Grid>
            </Border>

            <!-- Row 1: Category Name Header -->
            <Border 
                Grid.Row="1" 
                HorizontalOptions="Center" 
                Padding="10,10,10,10" 
                BackgroundColor="{DynamicResource SurfaceElevation6}" 
                Stroke="{StaticResource PrimaryTextColor}" 
                StrokeThickness="2" 
                StrokeShape="RoundRectangle 15"
            >
                <controls:ScrollingText 
                    Text="{Binding CategoryName, FallbackValue='EN ATTENTE DE MATCH'}" 
                    TextColor="{StaticResource PrimaryTextColor}" 
                    FontSize="36" 
                    FontAttributes="Bold" 
                />
            </Border>

            <!-- Row 2: Main Match Display (The Ring) -->
            <Grid 
                Grid.Row="2"
            >
                <!-- Active Match -->
                <Grid 
                    BindingContext="{Binding CurrentDraw}"
                    IsVisible="{Binding CurrentDraw, Converter={StaticResource IsNullOrEmptyConverter}, ConverterParameter='Invert'}"
                    x:DataType="{x:Null}"
                >
                    <!-- Background Colors -->
                    <Grid 
                        x:DataType="models:IDrawModel"
                        ColumnDefinitions="*,*"
                    >
                        <Border 
                            Grid.ColumnSpan="2" 
                            Background="{DynamicResource SurfaceElevation6}" 
                            StrokeThickness="0" 
                            Opacity="0.8"
                            StrokeShape="RoundRectangle 8"
                            IsVisible="{Binding Type, Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" 
                        />
                    </Grid>

                    <!-- Order Mode (Taolu) -->
                    <Grid 
                        IsVisible="False"
                        ColumnDefinitions="400,*,400"
                        ColumnSpacing="10"
                    >
                        <!-- Info -->
                        <Grid 
                            Grid.Column="0" 
                            RowDefinitions="*,Auto"
                            Padding="10,20,10,20"
                        >
                            <VerticalStackLayout 
                                HorizontalOptions="Fill" 
                                VerticalOptions="Fill"
                                Spacing="10" 
                            >
                                <!-- Circular Photo / Icon -->
                                <Border 
                                    StrokeShape="RoundRectangle 50" 
                                    HeightRequest="100" 
                                    WidthRequest="100" 
                                    HorizontalOptions="Center" 
                                    Stroke="White" 
                                    BackgroundColor="White"
                                    StrokeThickness="3"
                                    IsVisible="{Binding Competitor.Photo, Converter={StaticResource IsNullOrEmptyConverter}, ConverterParameter='Invert'}"
                                >
                                    <Image 
                                        Source="{Binding Competitor, Converter={StaticResource GenreToImageConverter}, ConverterParameter=10}" 
                                        Aspect="AspectFill" 
                                    />
                                </Border>

                                <Border 
                                    StrokeShape="RoundRectangle 50" 
                                    HeightRequest="100" 
                                    WidthRequest="100" 
                                    HorizontalOptions="Center" 
                                    Stroke="White" 
                                    StrokeThickness="3"
                                    BackgroundColor="White"
                                    IsVisible="{Binding Competitor.Photo, Converter={StaticResource IsNullOrEmptyConverter}}"
                                >
                                    <Label 
                                        Text="{Binding Competitor.Genre, Converter={StaticResource GenreToFontConverter}}" 
                                        FontFamily="{x:Static helpers:FontHelper.CUSTOM_NAME}" 
                                        FontSize="95" 
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        VerticalTextAlignment="Center"
                                    />
                                </Border>

                                <!--Name on two lines-->
                                <VerticalStackLayout 
                                    HorizontalOptions="Center" 
                                    Padding="5,0,5,0"
                                >
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor.LastName}" 
                                        Style="{StaticResource MainCompetitorNameStyle}" 
                                        FontSize="28" 
                                    />

                                    <controls:ScrollingText 
                                        Text="{Binding Competitor.FirstName}" 
                                        Style="{StaticResource MainCompetitorNameStyle}"
                                        FontSize="32" 
                                        Margin="0,-5,0,0" 
                                    />
                                </VerticalStackLayout>

                                <!--Club & Country-->
                                <VerticalStackLayout 
                                    Spacing="2" 
                                    Padding="5,0,5,0"
                                >
                                    <controls:ScrollingText 
                                        Text="{Binding Competitor.Club}" 
                                        TextColor="White" 
                                        FontSize="18" 
                                        HorizontalOptions="Fill"
                                    />

                                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                                        <Image 
                                            Source="{Binding Competitor.CountryIsoCode, Converter={StaticResource IsoCodeToFlagPathConverter}}" 
                                            WidthRequest="25" 
                                            HeightRequest="15" 
                                            VerticalOptions="Center" 
                                        />

                                        <Label 
                                            Text="{Binding Competitor.Country.Name}"
                                            TextColor="White" 
                                            FontSize="16" 
                                            FontAttributes="Italic" 
                                            VerticalOptions="Center" 
                                            HorizontalOptions="Fill" 
                                        />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding AddScoreCommand, Source={RelativeSource AncestorType={x:Type vm:JudgeViewModel}}}" CommandParameter="{Binding Competitor2.Id}"/>
                                </VerticalStackLayout.GestureRecognizers>
                            </VerticalStackLayout>

                            <!-- SCORE -->
                            <Grid 
                                Grid.Row="1"
                                ColumnDefinitions="*,115,10,Auto,*"
                                ColumnSpacing="10"
                            >
                                <Label 
                                    Grid.Column="1"
                                    Text="Score"
                                    FontSize="40"
                                    TextColor="{DynamicResource PrimaryTextColor}"
                                />

                                <Label 
                                    Grid.Column="2"
                                    Text=":"
                                    FontSize="40"
                                    TextColor="{DynamicResource PrimaryTextColor}"
                                />

                                <Label
                                    Grid.Column="3"
                                    Text="{Binding Score, Source={RelativeSource AncestorType={x:Type vm:JudgeViewModel}}}"
                                    FontSize="40"
                                    TextColor="{DynamicResource PrimaryTextColor}"
                                    HorizontalOptions="Start"
                                />
                            </Grid>
                        </Grid>

                        <!-- Code Input & Recognized Codes Section -->
                        <Grid 
                            Grid.Column="1"
                            RowDefinitions="45, *"
                            RowSpacing="10"
                            Margin="0,15,0,15"
                            BindingContext="{Binding BindingContext, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            x:DataType="vm:JudgeViewModel"
                        >
                            <!-- Mode Toggle Bar + Settings Button -->
                            <Grid
                                Grid.Row="0" 
                                ColumnDefinitions="*, *" 
                                ColumnSpacing="6"
                            >
                                <Button 
                                    Grid.Column="0"
                                    Text="{Binding Resources.CODE_INPUT_MODE, FallbackValue='Code'}"
                                    FontSize="{OnIdiom Tablet='14', Phone='11'}"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    Command="{Binding SwitchModeCommand}"
                                    CommandParameter="{x:Static models:TaoluInputMode.Code}"
                                    BackgroundColor="{StaticResource ButtonBackgroundColor}"
                                    TextColor="{StaticResource InverseTextColor}"
                                    Padding="2,0"
                                >
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsCodeMode}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ValidColor}" />
                                            <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>

                                <Button 
                                    Grid.Column="1"
                                    Text="{Binding Resources.POINT_INPUT_MODE, FallbackValue='Points'}"
                                    FontSize="{OnIdiom Tablet='14', Phone='11'}"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    Command="{Binding SwitchModeCommand}"
                                    CommandParameter="{x:Static models:TaoluInputMode.Points}"
                                    BackgroundColor="{StaticResource ButtonBackgroundColor}"
                                    TextColor="{StaticResource InverseTextColor}"
                                    Padding="2,0"
                                >
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsPointMode}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource ValidColor}" />
                                            <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>

                            <!-- View 1: Numeric Keypad with Matching Suggestions (Code Mode) -->
                            <Grid 
                                Grid.Row="1"
                                IsVisible="{Binding IsCodeMode}"
                                RowDefinitions="55, Auto, *, *, *, *"
                                ColumnDefinitions="*, *, *"
                                RowSpacing="8"
                                ColumnSpacing="8"
                            >
                                <!-- Code Display Box with Clear, Backspace, and Validate Buttons -->
                                <Border
                                    Grid.Row="0" 
                                    Grid.ColumnSpan="3" 
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="White"
                                    Padding="10,0"
                                >
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="5">
                                        <Label 
                                            Grid.Column="0"
                                            Text="{Binding Code}" 
                                            TextColor="{Binding InverseTextColor}"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            FontSize="26"
                                            FontAttributes="Bold"
                                        />

                                        <Button
                                            Grid.Column="1"
                                            Text="✕"
                                            TextColor="{DynamicResource ErrorDark}"
                                            BorderColor="{DynamicResource ErrorDark}"
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            Padding="0"
                                            HeightRequest="36"
                                            WidthRequest="36"
                                            IsVisible="{Binding Code, Converter={StaticResource EmptyToBoolConverter}}"
                                            Command="{Binding ClearCodeCommand}"
                                        />
                                    </Grid>
                                </Border>

                                <!-- Suggestions Chips (When typing code digits) -->
                                <ScrollView 
                                    Grid.Row="1" 
                                    Grid.ColumnSpan="3" 
                                    Orientation="Horizontal" 
                                    HorizontalScrollBarVisibility="Never"
                                    IsVisible="{Binding MatchingCodes.Count, Converter={StaticResource IntToBoolConverter}}"
                                >
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding MatchingCodes}" Spacing="6" Padding="0,2">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:MvtCodeModel">
                                                <Border 
                                                    BackgroundColor="{DynamicResource SurfaceElevation6}" 
                                                    Stroke="{DynamicResource ValidColor}" 
                                                    StrokeThickness="1" 
                                                    StrokeShape="RoundRectangle 6"
                                                    Padding="8,5"
                                                >
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Command="{Binding x:DataType='vm:JudgeViewModel', Source={RelativeSource AncestorType={x:Type vm:JudgeViewModel}}, Path=ApplyCodeCommand}"
                                                            CommandParameter="{Binding .}"
                                                        />
                                                    </Border.GestureRecognizers>

                                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                        <Label 
                                                            Text="{Binding Code}" 
                                                            TextColor="Yellow" 
                                                            FontAttributes="Bold" 
                                                            FontSize="14"
                                                        />

                                                        <Label 
                                                            Text="{Binding Movement}" 
                                                            TextColor="White" 
                                                            FontSize="13"
                                                        />

                                                        <Label 
                                                            Text="{Binding Value, StringFormat='-{0:F1}'}"
                                                            TextColor="{DynamicResource RedCornerLight}" 
                                                            FontAttributes="Bold" 
                                                            FontSize="13"
                                                        />
                                                    </HorizontalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </ScrollView>

                                <!-- Keypad Buttons -->
                                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Text="7" Command="{Binding TypeNumberCommand}" CommandParameter="7" />
                                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Text="8" Command="{Binding TypeNumberCommand}" CommandParameter="8" />
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Text="9" Command="{Binding TypeNumberCommand}" CommandParameter="9" />

                                <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Text="4" Command="{Binding TypeNumberCommand}" CommandParameter="4" />
                                <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Text="5" Command="{Binding TypeNumberCommand}" CommandParameter="5" />
                                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Text="6" Command="{Binding TypeNumberCommand}" CommandParameter="6" />

                                <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Text="1" Command="{Binding TypeNumberCommand}" CommandParameter="1" />
                                <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Text="2" Command="{Binding TypeNumberCommand}" CommandParameter="2" />
                                <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Text="3" Command="{Binding TypeNumberCommand}" CommandParameter="3" />

                                <Button Grid.Row="5" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Text="A" Command="{Binding TypeNumberCommand}" CommandParameter="A" />
                                <Button Grid.Row="5" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Text="0" Command="{Binding TypeNumberCommand}" CommandParameter="0" />
                                <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Text="B" Command="{Binding TypeNumberCommand}" CommandParameter="B" />
                            </Grid>

                            <!-- View 2: Points Deduction Keypad Mode -->
                            <Grid 
                                Grid.Row="1"
                                IsVisible="{Binding IsPointMode}"
                                RowDefinitions="55, Auto, *, *, *, *, 46"
                                ColumnDefinitions="*, *, *"
                                RowSpacing="8"
                                ColumnSpacing="8"
                            >
                                <!-- Points Display Box -->
                                <Border
                                    Grid.Row="0" 
                                    Grid.ColumnSpan="3" 
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="White"
                                    Padding="10,0"
                                >
                                    <Grid ColumnDefinitions="*, Auto">
                                        <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="4">
                                            <Label 
                                                Text="-" 
                                                TextColor="{DynamicResource RedCornerColor}" 
                                                FontSize="26" 
                                                FontAttributes="Bold" 
                                                VerticalOptions="Center"
                                                IsVisible="{Binding PointsInput, Converter={StaticResource EmptyToBoolConverter}}"
                                            />

                                            <Label 
                                                Text="{Binding PointsInput}" 
                                                TextColor="{DynamicResource InverseTextColor}"
                                                VerticalOptions="Center"
                                                FontSize="26"
                                                FontAttributes="Bold"
                                                IsVisible="{Binding PointsInput, Converter={StaticResource EmptyToBoolConverter}}"
                                            />

                                            <Label 
                                                Text="0.0 pt" 
                                                TextColor="{DynamicResource MutedTextColor}" 
                                                VerticalOptions="Center"
                                                FontSize="24"
                                                IsVisible="{Binding PointsInput, Converter={StaticResource EmptyToBoolConverter}, ConverterParameter='Invert'}"
                                            />
                                        </HorizontalStackLayout>

                                        <Button
                                            Grid.Column="1"
                                            Text="✕"
                                            TextColor="{DynamicResource ErrorDark}"
                                            BorderColor="{DynamicResource ErrorDark}"
                                            BackgroundColor="Transparent"
                                            FontSize="16"
                                            FontAttributes="Bold"
                                            Padding="0"
                                            HeightRequest="36"
                                            WidthRequest="36"
                                            IsVisible="{Binding PointsInput, Converter={StaticResource EmptyToBoolConverter}}"
                                            Command="{Binding ClearPointsCommand}"
                                        />
                                    </Grid>
                                </Border>

                                <!-- Quick points deduction chips -->
                                <Grid Grid.Row="1" Grid.ColumnSpan="3" ColumnDefinitions="*, *, *, *, *" ColumnSpacing="6">
                                    <Button Grid.Column="0" Style="{StaticResource QuickDeductButtonStyle}" Text="-0.1" Command="{Binding DeductPointsCommand}" CommandParameter="0.1"/>
                                    <Button Grid.Column="1" Style="{StaticResource QuickDeductButtonStyle}" Text="-0.2" Command="{Binding DeductPointsCommand}" CommandParameter="0.2"/>
                                    <Button Grid.Column="2" Style="{StaticResource QuickDeductButtonStyle}" Text="-0.3" Command="{Binding DeductPointsCommand}" CommandParameter="0.3"/>
                                    <Button Grid.Column="3" Style="{StaticResource QuickDeductButtonStyle}" Text="-0.5" Command="{Binding DeductPointsCommand}" CommandParameter="0.5"/>
                                    <Button Grid.Column="4" Style="{StaticResource QuickDeductButtonStyle}" Text="-1.0" Command="{Binding DeductPointsCommand}" CommandParameter="1.0"/>
                                </Grid>

                                <!-- Keypad Buttons -->
                                <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Text="7" Command="{Binding TypePointCommand}" CommandParameter="7" />
                                <Button Grid.Row="2" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Text="8" Command="{Binding TypePointCommand}" CommandParameter="8" />
                                <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Text="9" Command="{Binding TypePointCommand}" CommandParameter="9" />

                                <Button Grid.Row="3" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Text="4" Command="{Binding TypePointCommand}" CommandParameter="4" />
                                <Button Grid.Row="3" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Text="5" Command="{Binding TypePointCommand}" CommandParameter="5" />
                                <Button Grid.Row="3" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Text="6" Command="{Binding TypePointCommand}" CommandParameter="6" />

                                <Button Grid.Row="4" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" Text="1" Command="{Binding TypePointCommand}" CommandParameter="1" />
                                <Button Grid.Row="4" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Text="2" Command="{Binding TypePointCommand}" CommandParameter="2" />
                                <Button Grid.Row="4" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" Text="3" Command="{Binding TypePointCommand}" CommandParameter="3" />

                                <Button Grid.Row="5" Grid.Column="0" Style="{StaticResource KeypadButtonStyle}" FontSize="24" Text="." Command="{Binding TypePointCommand}" CommandParameter="." />
                                <Button Grid.Row="5" Grid.Column="1" Style="{StaticResource KeypadButtonStyle}" Text="0" Command="{Binding TypePointCommand}" CommandParameter="0" />
                                <Button Grid.Row="5" Grid.Column="2" Style="{StaticResource KeypadButtonStyle}" FontSize="20" Text="⌫" Command="{Binding BackspacePointsCommand}" />

                                <!-- Validate Deduction Button -->
                                <Button 
                                    Grid.Row="6" 
                                    Grid.ColumnSpan="3" 
                                    Text="➖ Retirer de la note" 
                                    BackgroundColor="{DynamicResource Primary}" 
                                    TextColor="White" 
                                    FontAttributes="Bold" 
                                    FontSize="16" 
                                    CornerRadius="10" 
                                    Command="{Binding DeductPointsCommand}"
                                />
                            </Grid>
                        </Grid>

                        <!-- Codes Applied History -->
                        <CollectionView
                            Grid.Column="2"
                            BindingContext="{Binding BindingContext, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                            ItemsSource="{Binding Codes}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            Margin="5,15,5,15"
                        >
                            <CollectionView.Behaviors>
                                <behaviors:ScrollOnNewItemBehavior/>
                            </CollectionView.Behaviors>
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="6"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:MvtTimeCodeModel">
                                    <Border
                                        Padding="8,6"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="White"
                                    >
                                        <Grid ColumnDefinitions="Auto, *, Auto, Auto" ColumnSpacing="8" VerticalOptions="Center">
                                            <!-- Code & Time -->
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                                                <Border BackgroundColor="{DynamicResource SurfaceElevation2}" StrokeShape="RoundRectangle 4" Padding="6,2" HorizontalOptions="Center">
                                                    <Label Text="{Binding Code.Code}" TextColor="White" FontSize="13" FontAttributes="Bold"/>
                                                </Border>
                                                <Label Text="{Binding Date, StringFormat='{0:HH:mm:ss}'}" TextColor="Gray" FontSize="10" HorizontalOptions="Center"/>
                                            </VerticalStackLayout>

                                            <!-- Movement & Description -->
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="{Binding Code.Movement}" TextColor="Black" FontSize="13" FontAttributes="Bold" LineBreakMode="TailTruncation"/>
                                                <Label Text="{Binding Code.Description}" TextColor="{DynamicResource SubtleTextColor}" FontSize="11" LineBreakMode="WordWrap" MaxLines="2"/>
                                            </VerticalStackLayout>

                                            <!-- Deduction Value -->
                                            <Label 
                                                Grid.Column="2"
                                                Text="{Binding Code.Value, StringFormat='-{0:F1}'}"
                                                TextColor="{DynamicResource RedCornerColor}"
                                                FontSize="14"
                                                FontAttributes="Bold"
                                                VerticalOptions="Center"
                                            />

                                            <!-- Delete Button -->
                                            <controls:IconButton
                                                Grid.Column="3"
                                                Style="{StaticResource ListActionDeleteButtonStyle}"
                                                IsVisible="{Binding CanDelete}"
                                                Command="{Binding x:DataType='vm:JudgeViewModel', Source={RelativeSource AncestorType={x:Type vm:JudgeViewModel}}, Path=DeleteCodeCommand}"
                                                CommandParameter="{Binding .}"
                                                VerticalOptions="Center"
                                            />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid.Triggers>
                            <DataTrigger TargetType="Grid" Binding="{Binding ., Converter={StaticResource CategoryTypeToBoolConverter}, ConverterParameter='Order'}" Value="True">
                                <Setter Property="IsVisible" Value="True"/>
                            </DataTrigger>
                        </Grid.Triggers>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Footer Info (Judge Position & Connection Status) -->
            <HorizontalStackLayout 
                    Grid.Row="3" 
                    HorizontalOptions="Center" 
                    Spacing="30"
                >
                <HorizontalStackLayout Spacing="10">
                    <BoxView 
                            Color="{Binding ConnectionStatusColor}" 
                            WidthRequest="20" 
                            HeightRequest="20" 
                            CornerRadius="10" 
                            VerticalOptions="Center"
                            BackgroundColor="Transparent"
                        />

                    <Label 
                            Text="{Binding ConnectionStatusText}" 
                            TextColor="{Binding ConnectionStatusColor}" 
                            FontSize="18" 
                            FontAttributes="Bold" 
                            VerticalOptions="Center"
                        />
                </HorizontalStackLayout>

                <Label 
                    Text="{Binding JudgeName}" 
                    TextColor="{StaticResource PrimaryTextColor}" 
                    FontSize="18" 
                    FontAttributes="Bold"
                    VerticalOptions="Center"
                />
            </HorizontalStackLayout>
        </Grid>
        <Grid 
            BackgroundColor="{DynamicResource OverlayHeavyColor}" 
            IsVisible="{Binding IsReceivingMatch}"
        >
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="20">
                <ActivityIndicator 
                    IsRunning="True" 
                    Color="White" 
                    WidthRequest="50" 
                    HeightRequest="50"
                />

                <Label 
                    Text="RÉCEPTION DU MATCH..." 
                    TextColor="White" 
                    FontSize="20" 
                    FontAttributes="Bold" 
                    HorizontalOptions="Center"
                />
            </VerticalStackLayout>
        </Grid>
    </Grid>
</base:BasePage>
