<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="House.Of.Arbitration.Maui.Designer.Controls.CardView"
             x:Name="thisCard">
    
    <ContentView.ControlTemplate>
        <ControlTemplate>
            <Border StrokeShape="RoundRectangle 2"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource MartialGold}}"
                    BackgroundColor="{TemplateBinding CardColor}"
                    Padding="{TemplateBinding CardPadding}"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill">
                
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="0,4"
                            Radius="10"
                            Opacity="0.1" />
                </Border.Shadow>

                <!-- C'est ici que votre contenu sera placé -->
                <ContentPresenter />
                
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>