<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:House.Of.Arbitration.Controls"
             x:Class="House.Of.Arbitration.Controls.Card"
             x:Name="this"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">
    <ContentView.ControlTemplate>
        <ControlTemplate x:DataType="local:Card">
            <Border 
                StrokeShape="RoundRectangle 15"
                Stroke="LightGray"
                BackgroundColor="{TemplateBinding CardColor}"
                Padding="{TemplateBinding CardPadding}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
            >
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.1"/>
                </Border.Shadow>

                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{TemplateBinding HasShadow}" Value="False">
                        <Setter Property="Shadow" Value="{x:Null}" />
                    </DataTrigger>
                    <DataTrigger TargetType="Border" Binding="{TemplateBinding HasShadow}" Value="True">
                        <Setter Property="Stroke" Value="{x:Null}" />
                    </DataTrigger>
                </Border.Triggers>

                <ContentPresenter HorizontalOptions="Fill" VerticalOptions="Fill"/>
            </Border>
        </ControlTemplate>
    </ContentView.ControlTemplate>
</ContentView>
