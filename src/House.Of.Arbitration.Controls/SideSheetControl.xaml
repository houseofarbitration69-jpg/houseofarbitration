<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:House.Of.Arbitration.Controls"
    x:Class="House.Of.Arbitration.Controls.SideSheetControl"
    x:DataType="local:SideSheetControl"
    x:Name="this"
>
    <Grid>
        <!-- Side Sheet Overlay -->
        <BoxView 
            x:Name="Overlay" 
            BackgroundColor="Black" 
            Opacity="0" 
            IsVisible="False"
            InputTransparent="{Binding IsOpen, Source={x:Reference this}, Converter={StaticResource InvertBoolConverter}}"
        >
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand, Source={x:Reference this}}" />
            </BoxView.GestureRecognizers>
            <BoxView.Triggers>
                <DataTrigger TargetType="BoxView" Binding="{Binding IsOpen, Source={x:Reference this}}" Value="True">
                    <DataTrigger.EnterActions>
                        <local:FadeAction Opacity="0.5" Duration="300" />
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <local:FadeAction Opacity="0" Duration="300" />
                    </DataTrigger.ExitActions>
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </BoxView.Triggers>
        </BoxView>

        <!-- Side Sheet -->
        <Border 
            x:Name="SidePane" 
            WidthRequest="{Binding SheetWidth, Source={x:Reference this}}" 
            HorizontalOptions="Start" 
            TranslationX="-300" 
            IsVisible="False"
            BackgroundColor="{Binding SheetBackgroundColor, Source={x:Reference this}}" 
            Stroke="White" 
            StrokeThickness="1"
            StrokeShape="RoundRectangle 0,15,0,15"
            Padding="20"
        >
            <Border.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsOpen, Source={x:Reference this}}" Value="True">
                    <DataTrigger.EnterActions>
                        <local:TranslateAction X="0" Duration="300" Easing="CubicOut" />
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <local:TranslateAction X="-300" Duration="300" Easing="CubicIn" />
                    </DataTrigger.ExitActions>
                    <Setter Property="IsVisible" Value="True" />
                </DataTrigger>
            </Border.Triggers>
            
            <ContentView Content="{Binding SheetContent, Source={x:Reference this}}" />
        </Border>
    </Grid>
</ContentView>
