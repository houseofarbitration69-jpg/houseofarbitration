<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:House.Of.Arbitration.Controls"
    x:Class="House.Of.Arbitration.Controls.SideSheetControl"
    x:DataType="local:SideSheetControl"
    x:Name="this"
    IsVisible="False"
    InputTransparent="True"
>
    <Grid IsClippedToBounds="True">
        <!-- Side Sheet Overlay -->
        <BoxView 
            x:Name="Overlay" 
            BackgroundColor="Black" 
            Opacity="0" 
            IsVisible="False"
            InputTransparent="True"
        >
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding CloseCommand, Source={x:Reference this}}" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <!-- Side Sheet -->
        <Border 
            x:Name="SidePane" 
            WidthRequest="{Binding SheetWidth, Source={x:Reference this}}" 
            HorizontalOptions="Start" 
            TranslationX="-300" 
            Margin="-4,0,0,0"
            IsVisible="False"
            InputTransparent="True"
            BackgroundColor="{Binding SheetBackgroundColor, Source={x:Reference this}}" 
            Stroke="{Binding SheetBorderColor, Source={x:Reference this}}" 
            StrokeThickness="1"
            StrokeShape="RoundRectangle 0,15,0,15"
            Padding="24,20,20,20"
        >
            <ContentView Content="{Binding SheetContent, Source={x:Reference this}}" />
        </Border>
    </Grid>
</ContentView>
