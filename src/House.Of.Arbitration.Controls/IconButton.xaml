<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:House.Of.Arbitration.Controls.Converters"
    x:Class="House.Of.Arbitration.Controls.IconButton"
    x:Name="root">

    <ContentView.Resources>
        <converters:StringToBoolConverter x:Key="StringToBoolConverter" />
        <converters:DoubleToCornerRadiusConverter x:Key="DoubleToCornerRadiusConverter" />
    </ContentView.Resources>

    <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
            <VisualState x:Name="Normal">
                <VisualState.Setters>
                    <Setter TargetName="MainBorder" Property="Opacity" Value="1.0" />
                    <Setter TargetName="MainBorder" Property="InputTransparent" Value="False" />
                    <Setter TargetName="MainBorder" Property="BackgroundColor" Value="{Binding ButtonBackgroundColor, Source={x:Reference root}}" />
                    <Setter TargetName="IconLabel" Property="TextColor" Value="{Binding IconColor, Source={x:Reference root}}" />
                    <Setter TargetName="TextLabel" Property="TextColor" Value="{Binding TextColor, Source={x:Reference root}}" />
                </VisualState.Setters>
            </VisualState>
            <VisualState x:Name="Disabled">
                <VisualState.Setters>
                    <Setter TargetName="MainBorder" Property="Opacity" Value="0.6" />
                    <Setter TargetName="MainBorder" Property="BackgroundColor" Value="#E0E0E0" />
                    <Setter TargetName="MainBorder" Property="InputTransparent" Value="True" />
                    <Setter TargetName="IconLabel" Property="TextColor" Value="LightGray" />
                    <Setter TargetName="TextLabel" Property="TextColor" Value="LightGray" />
                </VisualState.Setters>
            </VisualState>
        </VisualStateGroup>
    </VisualStateManager.VisualStateGroups>

    <Border x:Name="MainBorder" 
            BackgroundColor="{Binding ButtonBackgroundColor, Source={x:Reference root}}"
            Stroke="{Binding BorderBrush, Source={x:Reference root}}"
            StrokeThickness="{Binding BorderThickness, Source={x:Reference root}}"
            Padding="{Binding ButtonPadding, Source={x:Reference root}}"
            HorizontalOptions="Fill"
            VerticalOptions="Center">

        <Border.Triggers>
            <DataTrigger TargetType="Border" Binding="{Binding IsFullWidth, Source={x:Reference root}}" Value="False">
                <Setter Property="HorizontalOptions" Value="Center" />
            </DataTrigger>
        </Border.Triggers>

        <Border.StrokeShape>
            <RoundRectangle CornerRadius="{Binding CornerRadius, Source={x:Reference root}, Converter={StaticResource DoubleToCornerRadiusConverter}}" />
        </Border.StrokeShape>

        <HorizontalStackLayout Spacing="10" 
                               HorizontalOptions="Center" 
                               VerticalOptions="Center">

            <!-- Icône -->
            <Label x:Name="IconLabel"
                   Text="{Binding Icon, Source={x:Reference root}}"
                   FontFamily="{Binding IconFontFamily, Source={x:Reference root}}"
                   FontSize="18"
                   TextColor="{Binding IconColor, Source={x:Reference root}}"
                   VerticalOptions="Center"
                   IsVisible="{Binding Icon, Source={x:Reference root}, Converter={StaticResource StringToBoolConverter}}"/>

            <!-- Texte -->
            <Label x:Name="TextLabel"
                   Text="{Binding Text, Source={x:Reference root}}"
                   TextColor="{Binding TextColor, Source={x:Reference root}}"
                   FontSize="14"
                   FontAttributes="Bold"
                   VerticalOptions="Center"
                   IsVisible="{Binding Text, Source={x:Reference root}, Converter={StaticResource StringToBoolConverter}}"/>

        </HorizontalStackLayout>

        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
    </Border>
</ContentView>
