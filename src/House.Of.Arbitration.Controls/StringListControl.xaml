<?xml version="1.0" encoding="utf-8" ?>
<ContentView 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="House.Of.Arbitration.Controls.StringListControl"
    x:Name="root">

    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding InternalItems, Source={x:Reference root}}"
                           Spacing="5"
                           VerticalOptions="Center"
                           HorizontalOptions="Center">
        <BindableLayout.ItemTemplate>
            <DataTemplate>
                <Label Text="{Binding .}"
                       FontFamily="{Binding FontFamily, Source={x:Reference root}}"
                       TextColor="{Binding ItemColor, Source={x:Reference root}}"
                       VerticalOptions="Center" />
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </HorizontalStackLayout>
</ContentView>
